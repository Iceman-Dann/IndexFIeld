                <a href="#" onclick="routeGuard('history')" id="nav-history" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm text-slate-100 font-semibold hover:text-white">
                    <i class="fas fa-clipboard-list"></i>
                    <span>Search History</span>
                </a>
                
                <div class="px-4 mb-1 mt-4 text-[10px] font-bold text-white uppercase tracking-wider border-t border-white/10 pt-4">Fleet</div>
                <a href="#" onclick="routeGuard('assets')" id="nav-assets" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm text-slate-100 font-semibold hover:text-white">
                    <i class="fas fa-industry"></i>
                    <span>Asset Registry</span>
                </a>
                <a href="#" onclick="routeGuard('telemetry')" id="nav-telemetry" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm text-slate-100 font-semibold hover:text-white">
                    <i class="fas fa-broadcast-tower"></i>
                    <span>Live Monitoring</span>
                </a>
                <a href="#" onclick="routeGuard('prognostics')" id="nav-prognostics" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm text-slate-100 font-semibold hover:text-white">
                    <i class="fas fa-chart-line text-[#22C55E]"></i>
                    <span>Maintenance Forecast</span>
                    <span class="ml-auto text-[9px] bg-[#22C55E]/10 text-[#22C55E] font-bold px-1.5 py-0.5 rounded border border-[#22C55E]/30">ROI</span>
                </a>
                <a href="#" onclick="routeGuard('loto')" id="nav-loto" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm text-slate-100 font-semibold hover:text-white">
                    <i class="fas fa-lock text-yellow-500"></i>
                    <span>Lockout / Tagout</span>
                    <span class="ml-auto text-[9px] bg-yellow-500/10 text-yellow-500 font-bold px-1.5 py-0.5 rounded border border-yellow-500/30">SAFETY</span>
                </a>
                
                <div class="px-4 mb-1 mt-4 text-[10px] font-bold text-white uppercase tracking-wider border-t border-white/10 pt-4">System</div>
                <div class="px-4 py-2">
                    <div class="flex items-center gap-2 text-xs text-slate-100 font-semibold mb-2">
                        <span class="status-dot status-online"></span>
                        <span>System Structure: Ready</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-slate-100 font-semibold">
                        <span id="llm-status-dot" class="status-dot status-idle"></span>
                        <span id="llm-status-text">Awaiting First Manual Upload</span>
                    </div>
                </div>
            </nav>
            
            <div class="px-4 py-3 border-t border-white/5 w-full">
                <div class="text-[10px] font-semibold text-white uppercase tracking-wider mb-2">Tribal Knowledge</div>
                <div class="flex items-center justify-between w-full text-xs">
                    <span class="text-slate-200">Verified</span>
                    <span id="verified-count" class="text-slate-400 font-mono opacity-50 ml-auto">0</span>
                </div>
                <div class="flex items-center justify-between w-full text-xs mt-1">
                    <span class="text-slate-200">Notes</span>
                    <span id="notes-count" class="text-[#F97316] font-mono opacity-50 ml-auto">0</span>
                </div>
                <div class="mt-2 text-[9px] text-slate-300 font-mono flex items-center">
                    <span class="text-[#22C55E] mr-1 font-black animate-pulse">●</span> Connected to secure factory server
                </div>
            </div>
            
            <!-- Profile Dropdown Trigger -->
            <div class="p-4 border-t border-white/5 relative">
                <button onclick="toggleProfileDropdown()" class="w-full flex items-center gap-3 hover:bg-white/5 rounded-lg p-2 -m-2 transition-all">
                    <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#F97316]/20 to-[#22C55E]/20 border border-white/10 flex items-center justify-center">
                        <i class="fas fa-user text-xs text-[#F97316]"></i>
                    </div>
                    <div class="flex-1 min-w-0 text-left">
                        <p id="user-display-name" class="text-sm font-medium truncate">Loading...</p>
                        <div class="flex items-center gap-1">
                            <span id="user-display-role" class="text-[10px] text-slate-200 font-semibold">Plant Manager</span>
                            <span class="text-[8px] px-1 py-0.5 bg-[#F97316]/20 text-[#F97316] rounded">ENT</span>
                        </div>
                    </div>
                    <i class="fas fa-chevron-up text-xs text-light-slate/50" id="profile-chevron"></i>
                </button>
                
                <!-- Profile Dropdown Menu -->
                <div id="profile-dropdown" class="hidden absolute bottom-full left-4 right-4 mb-2 glass-card rounded-xl border border-white/10 shadow-2xl overflow-hidden z-50">
                    <!-- User Identity Header -->
                    <div class="p-4 border-b border-white/10 bg-white/5">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#F97316]/30 to-[#EA580C]/30 border border-[#F97316]/30 flex items-center justify-center">
                                <i class="fas fa-user text-sm text-[#F97316]"></i>
                            </div>
                            <div>
                                <p id="dropdown-user-name" class="font-medium">Loading...</p>
                                <p id="dropdown-user-title" class="text-[11px] text-light-slate">—</p>
                                <p id="dropdown-user-company" class="text-[10px] text-[#22C55E]">—</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Core Menu Items -->
                    <div class="p-2">
                        <button onclick="showSettings('profile')" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-user-circle text-light-slate w-4"></i>
                            <span class="text-sm">My Profile</span>
                        </button>
                        <button onclick="showSettings('workspace')" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-building text-light-slate w-4"></i>
                            <span class="text-sm">Workspace Settings</span>
                        </button>
                        <button onclick="showSettings('team')" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-users text-light-slate w-4"></i>
                            <span class="text-sm">Team Management</span>
                        </button>
                        <button onclick="showSettings('billing')" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-credit-card text-light-slate w-4"></i>
                            <span class="text-sm">Billing</span>
                        </button>
                    </div>
                    
                    <!-- System Section -->
                    <div class="p-2 border-t border-white/10">
                        <button onclick="showSettings('security')" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-shield-alt text-light-slate w-4"></i>
                            <span class="text-sm">Security</span>
                        </button>
                        <button onclick="openVault()" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-clipboard-check text-light-slate w-4"></i>
                            <span class="text-sm">Knowledge Verification</span>
                        </button>
                        <button onclick="showSettings('ai')" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-brain text-light-slate w-4"></i>
                            <span class="text-sm">AI Configuration</span>
                        </button>
                        <button onclick="showSystemStatus()" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-server text-light-slate w-4"></i>
                            <span class="text-sm">System Status</span>
                        </button>
                    </div>
                    
                    <!-- Help & Logout -->
                    <div class="p-2 border-t border-white/10">
                        <button onclick="showHelpCenter()" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left">
                            <i class="fas fa-question-circle text-light-slate w-4"></i>
                            <span class="text-sm">Help Center</span>
                        </button>
                        <button onclick="handleLogout()" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/5 transition text-left text-[#EF4444]">
                            <i class="fas fa-sign-out-alt w-4"></i>
                            <span class="text-sm">Log Out</span>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Sovereign Seal Footer -->
            <div class="mt-auto p-4 border-t border-white/5 bg-black/20">
                <div class="flex items-center gap-2 opacity-50 hover:opacity-100 transition cursor-default">
                    <div class="w-1.5 h-1.5 rounded-full bg-[#22C55E]"></div>
                    <span class="text-[10px] font-mono tracking-widest uppercase text-light-slate">Secure Connection</span>
                </div>
                <p class="text-[9px] text-light-slate mt-1">Secure Plant Server — data cannot leak outside</p>
            </div>
        </aside>
        
        <main class="flex-1 flex flex-col">
            <header class="h-16 border-b border-white/5 flex items-center justify-between px-4 lg:px-6 glass-card">
                <div class="flex items-center gap-3">
                    <button onclick="toggleSidebar()" class="mobile-menu-btn p-2 -ml-2 text-light-slate hover:text-white lg:hidden">
                        <i class="fas fa-bars text-lg"></i>
                    </button>
                    <i class="fas fa-robot text-light-slate hidden sm:block"></i>
                    <span id="page-title" class="font-medium text-sm sm:text-base text-white">Ask Questions</span>
                    <!-- Enterprise Status Indicators - Minimal, Solid -->
                    <span class="text-[10px] font-mono text-light-slate bg-white/5 px-2 py-1 rounded flex items-center gap-2 border border-white/10" title="Your documentation never leaves this facility">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E]"></span>
                        FACILITY INTERNAL DATA
                    </span>
                    <span id="load-indicator" onclick="toggleEngineThrottle()" class="cursor-pointer text-[10px] font-mono text-light-slate bg-white/5 px-2 py-1 rounded flex items-center gap-1.5 border border-white/10 hover:bg-white/10 transition" title="System health — click to simulate busy processing">
                        <span id="load-status-dot" class="text-[#F97316] text-xs leading-none">●</span>
                        <span id="load-text">OPERATIONAL INTELLIGENCE: STANDBY</span>
                    </span>
                    <span class="text-[10px] font-mono text-[#94A3B8] bg-white/5 border border-white/10 px-2 py-1 rounded hidden sm:inline-block">
                        Industrial AI Core
                    </span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1" id="low-signal-container">
                        <button onclick="toggleLowSignal()" id="low-signal-btn" class="text-[10px] font-mono bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/30 px-3 py-1.5 rounded hover:bg-[#22C55E]/20 transition flex items-center gap-2" title="Your data stays on-site — never sent to the cloud">
                            <i class="fas fa-lock"></i> SECURE PLANT NETWORK
                        </button>
                        <span id="data-usage-badge" class="hidden text-[9px] font-mono text-[#FACC15] bg-[#FACC15]/10 px-1.5 py-1 rounded border border-[#FACC15]/30">Lite: 1.2MB</span>
                    </div>
                    <button onclick="initiateLogoutHandover()" class="text-[10px] font-mono text-white font-bold bg-[#F97316]/20 border border-[#F97316]/40 px-3 py-1.5 rounded hover:bg-[#F97316]/30 transition flex items-center gap-2" title="Generate Shift Handover Report">
                        <i class="fas fa-sign-out-alt"></i> LOG OUT (END SHIFT)
                    </button>
                    <button id="clear-chat-btn" onclick="clearChat()" class="p-2 text-light-slate hover:text-white transition text-sm hidden" title="Clear conversation">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                    <!-- Secondary CTA - Minimal, Operational -->
                    <button id="top-upload-btn" onclick="showUploadModal()" class="hidden px-3 py-1.5 bg-white/5 text-white border border-white/10 rounded text-sm font-medium hover:bg-white/10 hover:border-white/20 transition-all flex items-center gap-2 shadow-sm">
                        <i class="fas fa-cloud-upload-alt text-light-slate"></i>
                        <span>Upload Manual</span>
                    </button>
                </div>
            </header>
            
            <!-- Chat View -->
            <div id="chat-view" class="dashboard-view chat-view-layout">
    <div class="chat-split-columns min-h-0">
        <div class="flex flex-col border-r border-white/5 h-full min-h-0">
            <div id="chat-container" class="flex-1 overflow-y-auto px-4 py-6 min-h-0">
                <!-- Compact Welcome - Functional Dashboard Density -->
                <div id="welcome-message" class="max-w-xl mx-auto py-6 transition-opacity duration-300">
                    <div class="panel-section p-4 mb-4">
                        <div class="flex items-center gap-3 mb-3">
                            <div
                                class="w-10 h-10 rounded-lg bg-[#F97316]/10 border border-[#F97316]/20 flex items-center justify-center">
                                <i class="fas fa-robot text-lg text-[#F97316]"></i>
                            </div>
                            <div>
                                <h1 class="text-lg font-semibold">Ask Questions</h1>
                                <p class="text-xs text-light-slate">Search manuals and get answers fast</p>
                            </div>
                        </div>

                        <!-- Quick Query Templates -->
                        <div id="quick-queries-real" class="grid grid-cols-3 gap-2 hidden">
                            <button type="button" onclick="activatePromptShortcut('Technical specifications for this asset'); sendMessage();"
                                class="panel-section p-2 text-left text-[11px] hover:border-[#F97316]/30 transition-all">
                                <i class="fas fa-wrench text-[#F97316] mr-1"></i>Asset Specs
                            </button>
                            <button type="button" onclick="activatePromptShortcut('Wiring and electrical diagrams'); sendMessage();"
                                class="panel-section p-2 text-left text-[11px] hover:border-[#F97316]/30 transition-all">
                                <i class="fas fa-bolt text-[#22C55E] mr-1"></i>Wiring/Schematics
                            </button>
                            <button type="button" onclick="activatePromptShortcut('Troubleshooting error codes'); sendMessage();"
                                class="panel-section p-2 text-left text-[11px] hover:border-[#F97316]/30 transition-all">
                                <i class="fas fa-exclamation-triangle text-[#F97316] mr-1"></i>Error Lookup
                            </button>
                        </div>
                        <div id="quick-queries-demo" class="grid grid-cols-1 gap-2">
                            <div class="panel-section p-3 text-center text-[12px] text-white/80">
                                👋 Welcome to your new workspace! Let's get things set up.
                            </div>
                        </div>
                    </div>

                    <!-- Operational Dashboard Grid -->
                    <div class="grid grid-cols-2 gap-3" id="welcome-grid">
                        <!-- Suggested Inquiries (hidden until first manual; ghosted if shown) -->
                        <div id="suggested-inquiries-widget" class="panel-section p-3 empty-state-ghost">
                            <div class="flex items-center gap-2 mb-2">
                                <i class="fas fa-lightbulb text-[#F97316] text-xs"></i>
                                <span class="text-[10px] text-slate-100 font-bold uppercase tracking-wider">Suggested
                                    Inquiries</span>
                            </div>
                            <div id="recent-queries-list" class="flex flex-col gap-1.5 mt-2">
                                <p class="text-[10px] text-slate-200/80 text-center py-2">💡 Upload your first manual to
                                    see suggested questions here.</p>
                            </div>
                        </div>

                        <!-- Indexed Manuals -->
                        <div id="knowledge-base-widget" class="panel-section p-3 col-span-2 md:col-span-1 flex flex-col">
                            <div class="flex items-center gap-2 mb-2">
                                <i class="fas fa-book text-[#22C55E] text-xs"></i>
                                <span class="text-[10px] text-slate-100 font-bold uppercase tracking-wider">Knowledge
                                    Base</span>
                            </div>
                            <div class="mt-2 flex-1 min-h-0">
                                <div id="upload-prompt"
                                    class="border-2 border-dashed border-[#F97316]/50 hover:border-[#F97316] bg-[#F97316]/5 hover:bg-[#F97316]/10 rounded-xl p-8 text-center cursor-pointer transition-all duration-300 shadow-[0_0_20px_rgba(249,115,22,0.05)] hover:shadow-[0_0_30px_rgba(249,115,22,0.15)] flex flex-col items-center justify-center min-h-[220px]"
                                    onclick="document.getElementById('upload-input').click()">
                                    <div
                                        class="w-12 h-12 rounded-full bg-[#F97316]/15 flex items-center justify-center mb-3">
                                        <i class="fas fa-cloud-upload-alt text-xl text-[#F97316]"></i>
                                    </div>
                                    <div class="text-base font-bold text-white mb-2 tracking-wide">Drag & Drop Your
                                        Manual Here or Click to Browse</div>
                                    <div class="text-xs text-slate-100 max-w-sm leading-relaxed font-medium">PDF, TXT,
                                        CSV, or DOCX — plant documentation only. If you do not have one yet, try a
                                        sample pump manual below.</div>
                                </div>
                                <button type="button" id="load-sample-manual-btn"
                                    onclick="event.stopPropagation(); loadSamplePumpManual()"
                                    class="mt-3 w-full py-2.5 px-4 rounded-lg border border-dashed border-[#F97316]/40 bg-[#F97316]/5 hover:bg-[#F97316]/10 hover:border-[#F97316]/70 text-xs font-semibold text-slate-100 hover:text-white shadow-[0_0_20px_rgba(249,115,22,0.06)] transition-all flex items-center justify-center gap-2">
                                    <i class="fas fa-flask text-[#F97316]"></i>
                                    Try a Sample Pump Manual
                                </button>
                                <div id="indexed-manuals-list" class="mt-2 hidden max-h-48 overflow-y-auto pr-1"></div>
                            </div>
                        </div>
                    </div>

                    <div id="tribal-knowledge-callout" class="tribal-knowledge-callout mt-3 flex items-start gap-3">
                        <div class="w-8 h-8 rounded-lg bg-[#06B6D4]/15 flex items-center justify-center shrink-0">
                            <i class="fas fa-users-cog text-[#06B6D4] text-sm"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-wider text-[#06B6D4] mb-1">Did you know?
                            </p>
                            <p class="text-xs text-slate-200/90 leading-relaxed">You can add your own shift notes and
                                maintenance fixes to the AI's memory so the next shift can search them — not just what's
                                in the official manual.</p>
                        </div>
                    </div>

                    <!-- Ingestion & engine telemetry (left column) -->
                    <div id="engine-telemetry-panel" class="engine-telemetry-panel mt-3 overflow-hidden">
                        <div class="engine-telemetry-block flex items-center gap-2.5 py-3">
                            <span id="system-status-dot" class="status-dot status-idle"></span>
                            <span id="system-status-line"
                                class="engine-telemetry-line text-[11px] text-white/90 font-semibold tracking-wide uppercase">System
                                Status: Ready — Awaiting Manual</span>
                        </div>
                        <div class="engine-telemetry-block flex items-center justify-between gap-3">
                            <p class="engine-telemetry-line flex items-center gap-1.5 shrink-0">
                                <i class="fas fa-database text-[#06B6D4] text-[10px]"></i>
                                <span class="uppercase tracking-widest font-semibold text-slate-400">Plant
                                    Documents</span>
                            </p>
                            <span id="page-indicator" class="engine-telemetry-line text-slate-400 text-right">No manuals
                                loaded yet</span>
                        </div>
                    </div>

                    <!-- Maintenance Insights Row (revealed after first manual) -->
                    <div id="maintenance-insights-widget" class="panel-section p-3 mt-3 empty-state-ghost">
                        <div class="flex items-center gap-2 mb-2">
                            <i class="fas fa-wrench text-[#06B6D4] text-xs"></i>
                            <span class="text-[10px] text-slate-100 font-bold uppercase tracking-wider">Maintenance
                                Insights</span>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div
                                class="data-surface p-2 rounded text-center cursor-pointer hover:bg-white/5 transition">
                                <div class="text-[10px] text-slate-200 font-semibold" id="maintenance-insights-manuals">Awaiting Manuals...</div>
                                <div class="text-[9px] text-slate-300/80">Ready for review</div>
                            </div>
                            <div
                                class="data-surface p-2 rounded text-center cursor-pointer hover:bg-white/5 transition">
                                <div class="text-[10px] text-[#22C55E] font-semibold" id="maintenance-insights-pages">0 pages parsed</div>
                                <div class="text-[9px] text-slate-300/80">Searchable in chat</div>
                            </div>
                            <div
                                class="data-surface p-2 rounded text-center cursor-pointer hover:bg-white/5 transition">
                                <div class="text-[10px] text-[#22C55E] font-semibold" id="main-kb-coverage">0%</div>
                                <div class="text-[9px] text-slate-300/80">Facility Indexed</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="messages" class="max-w-xl mx-auto space-y-4"></div>

                <div id="terminal-thinking" class="hidden max-w-xl mx-auto mt-4">
                    <div class="terminal-thinking">
                        <div id="terminal-content"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Source Verification & Context -->
        <div class="pdf-viewer-container flex flex-col bg-[#0f1419] min-h-0">
            <!-- Panel Header -->
            <div id="pdf-panel-header"
                class="h-10 border-b border-white/10 flex items-center justify-between px-3 panel-header hidden">
                <div class="flex items-center gap-2">
                    <i class="fas fa-file-pdf text-red-400 text-xs"></i>
                    <span id="pdf-filename" class="text-xs text-white/80 truncate max-w-[160px]">Source
                        Verification</span>
                </div>
                <div class="flex items-center gap-1">
                    <button onclick="pdfZoom(-0.1)" class="p-1 text-white/50 hover:text-white text-xs"><i
                            class="fas fa-minus"></i></button>
                    <span id="zoom-level" class="text-[9px] text-white/50 w-8 text-center">100%</span>
                    <button onclick="pdfZoom(0.1)" class="p-1 text-white/50 hover:text-white text-xs"><i
                            class="fas fa-plus"></i></button>
                </div>
            </div>

            <!-- Source Content Area -->
            <div class="flex-1 min-h-0 flex flex-col overflow-hidden">
                <div class="flex-1 relative overflow-hidden p-3 min-h-0">
                    <div id="pdf-placeholder" class="h-full flex flex-col items-center justify-center text-center p-8">
                        <h2 class="text-2xl font-bold text-white mb-6">Welcome to IndexField</h2>
                        <div id="onboarding-guide-card" class="onboarding-guide-card max-w-md w-full">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-4">Getting
                                started</p>
                            <div class="space-y-4 text-left w-full">
                                <div class="flex items-start gap-4 bg-white/5 p-4 rounded-lg border border-white/10">
                                    <div
                                        class="bg-[#F97316] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                                        1</div>
                                    <p class="text-sm text-white/90">Drop your plant documentation into the <span
                                            class="text-[#F97316] font-medium">Knowledge Base</span> zone on the left,
                                        or click it to browse.</p>
                                </div>
                                <div class="flex items-start gap-4 bg-white/5 p-4 rounded-lg border border-white/10">
                                    <div
                                        class="bg-[#F97316] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                                        2</div>
                                    <p class="text-sm text-white/90">Type a question in the chat bar at the bottom about
                                        your equipment.</p>
                                </div>
                                <div class="flex items-start gap-4 bg-white/5 p-4 rounded-lg border border-white/10">
                                    <div
                                        class="bg-[#F97316] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                                        3</div>
                                    <p class="text-sm text-white/90">Read the AI answer alongside the exact page numbers
                                        from your manual.</p>
                                </div>
                                <div class="flex items-start gap-4 bg-white/5 p-4 rounded-lg border border-white/10">
                                    <div
                                        class="bg-[#06B6D4] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                                        4</div>
                                    <p class="text-sm text-white/90">Already mapped your fleet?
                                        <button type="button" onclick="importFromAssetRegistry()"
                                            class="text-[#F97316] font-semibold hover:text-[#EA580C] hover:underline transition-colors ml-1">Import from Asset
                                            Registry</button>
                                        to sync manuals attached to your equipment.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <iframe id="pdf-frame" class="w-full h-full hidden rounded border border-white/10"></iframe>
                    <div id="pdf-highlight-box" class="pdf-highlight hidden"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chat input — full workspace width -->
    <div id="chat-input-area"
        class="w-full shrink-0 p-6 border-t border-white/10 bg-[#0d1117] shadow-[0_-10px_40px_rgba(0,0,0,0.5)] transition-opacity duration-300">
        <div class="w-full max-w-none px-2 lg:px-6">
            <div id="pasted-context-bar"
                class="hidden mb-3 px-3 py-2 bg-[#22C55E]/10 border border-[#22C55E]/30 rounded-lg flex items-center justify-between animate-in">
                <div class="flex items-center gap-2 text-xs text-[#22C55E]">
                    <i class="fas fa-file-alt text-[11px]"></i>
                    <span id="pasted-context-info" class="text-[12px] font-medium">Context attached (1,234 chars)</span>
                </div>
                <button onclick="clearPastedContext()" class="text-[10px] text-white/60 hover:text-white p-1">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="flex flex-col gap-4">
                <div id="quick-action-chips" class="flex flex-nowrap overflow-x-auto items-center gap-2 px-1 min-w-0">
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold mr-1 shrink-0">Quick
                        Actions</span>
                    <button type="button" class="quick-action-chip" data-quick-action="fault"
                        onclick="runQuickAction('fault'); sendMessage();">🔍 Lookup Fault Code</button>
                    <button type="button" class="quick-action-chip" data-quick-action="maintenance"
                        onclick="runQuickAction('maintenance'); sendMessage();">🔧 Show Maintenance Schedule</button>
                    <button type="button" class="quick-action-chip" data-quick-action="loto"
                        onclick="runQuickAction('loto'); sendMessage();">⚠️ LOTO Safety Procedures</button>
                    <div id="chat-action-buttons" class="hidden flex items-center gap-2 ml-auto">
                        <button onclick="showPasteHint()"
                            class="px-4 py-2 bg-white/5 border border-white/20 rounded-lg text-xs text-white/90 font-semibold hover:bg-white/10 transition-all flex items-center gap-2 shrink-0">
                            <i class="fas fa-paste text-white/70"></i> Paste Text
                        </button>
                    </div>
                </div>
                <div class="relative flex items-center w-full group">
                    <div class="absolute left-4 flex gap-4 z-10 text-base">
                        <button type="button" id="chat-mic-btn"
                            class="text-white/50 hover:text-[#F97316] transition-colors" title="Voice Input (Whisper)">
                            <i class="fas fa-microphone"></i>
                        </button>
                        <button type="button" id="chat-upload-btn" onclick="showUploadModal()"
                            class="text-white/50 hover:text-[#F97316] transition-colors" title="Upload manual">
                            <i class="fas fa-file-upload"></i>
                        </button>
                    </div>
                    <textarea id="chat-input" placeholder='💬 Ask a question...'
                        class="w-full pl-20 pr-44 py-4 bg-[#1a2233] border-2 border-white/10 rounded-xl text-white placeholder-slate-200 focus:border-[#F97316]/50 focus:outline-none text-base resize-none shadow-2xl transition-all font-medium overflow-hidden"
                        rows="1" style="min-height: 56px; max-height: 200px;" oninput="autoScaleInput(this)"
                        onkeypress="handleChatKeypress(event)" onpaste="handlePaste(event)"></textarea>
                    <span id="searchable-pages-count"
                        class="absolute right-14 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 font-mono tracking-tight whitespace-nowrap pointer-events-none hidden">0
                        pages</span>
                    <button onclick="sendMessage()" id="send-btn"
                        class="absolute right-3 w-10 h-10 flex items-center justify-center text-[#F97316] hover:scale-110 transition-all active:scale-95 shrink-0">
                        <i class="fas fa-paper-plane text-xl"></i>
                    </button>
                </div>
                <div class="flex items-center px-2 min-h-[1.25rem]">
                    <p id="paste-hint" class="hidden text-xs text-white/70 font-medium"><i
                            class="fas fa-info-circle mr-1 text-[#06B6D4]"></i>Paste 500+ chars to auto-attach context
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Insights View -->{% extends "base.html" %}
{% block content %}
<div id="insights-view" class="dashboard-view hidden flex-1 overflow-y-auto p-6">
                <div class="max-w-6xl mx-auto">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-2xl font-bold">Performance Summary</h2>
                            <p class="text-sm text-light-slate mt-1">Track searches, spot recurring issues, and monitor time and cost savings.</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] text-light-slate">Last 30 days</span>
                            <button type="button" id="insights-header-cta" onclick="showUploadModal()" class="px-4 py-2 bg-[#F97316] hover:bg-[#EA580C] text-black font-semibold rounded-lg text-xs transition shadow-[0_0_20px_rgba(249,115,22,0.25)] inline-flex items-center gap-1.5">
                                <i class="fas fa-plus"></i> Upload First Manual
                            </button>
                        </div>
                    </div>
                    
                    <div id="shift-handover-log" class="glass-card rounded-xl p-4 mb-6 border border-white/10 bg-slate-950/80 hidden">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="text-[10px] uppercase tracking-wider text-[#22C55E] font-semibold">Shift Handover Log</div>
                                <div class="text-base font-bold text-white mt-1">Pinned for the next shift</div>
                                <p class="text-[11px] text-slate-400 mt-1">Pin trending issues or alerts here so the next shift begins with an exact handover item and operator note.</p>
                            </div>
                            <button type="button" onclick="clearShiftHandover()" class="text-[10px] uppercase tracking-wider px-3 py-1 rounded border border-white/10 bg-slate-900/80 hover:bg-slate-800 transition text-slate-200">Clear Handover</button>
                        </div>
                        <div id="handover-log-content" class="mt-4 text-[11px] text-slate-300"></div>
                        <div class="mt-4">
                            <textarea id="handover-note-input" rows="3" class="w-full rounded-lg border border-white/10 bg-slate-950/80 p-3 text-sm text-white placeholder:text-slate-500" placeholder="Add a short handover note for the next team..."></textarea>
                            <div class="text-right mt-3">
                                <button type="button" onclick="saveHandoverNote()" class="px-3 py-2 text-xs font-semibold rounded bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/20 hover:bg-[#22C55E]/15 transition">Save Note</button>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-4 gap-4 mb-6">
                        <div class="glass-card rounded-xl p-4">
                            <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Questions Asked</div>
                            <div id="total-queries" class="text-2xl font-bold gradient-text">0</div>
                            <div class="text-[10px] text-[#22C55E] mt-1">Awaiting data</div>
                        </div>
                        <div class="glass-card rounded-xl p-4">
                            <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Most Searched Asset</div>
                            <div id="most-searched-asset" class="text-xl font-bold">--</div>
                            <div class="text-[10px] text-light-slate mt-1">Not enough data</div>
                        </div>
                        <div class="glass-card rounded-xl p-4">
                            <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Verified Answers</div>
                            <div id="verified-rate" class="text-2xl font-bold text-slate-400">--</div>
                            <div id="verified-rate-sub" class="text-[10px] text-light-slate mt-1">Awaiting answers</div>
                        </div>
                        <div class="glass-card rounded-xl p-4">
                            <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Fleet Risk Score</div>
                            <div id="risk-score" class="text-2xl font-bold text-slate-400">--</div>
                            <div id="risk-score-status" class="text-[10px] text-light-slate mt-1">Awaiting first upload</div>
                        </div>
                    </div>
                    
                    <!-- ROI Dashboard Widget ("CFO Bait") -->
                    <div class="glass-card rounded-xl p-6 mb-6 border border-white/10 bg-white/5 relative overflow-hidden" id="roi-dashboard-widget">
                        <div class="absolute top-0 right-0 bg-slate-800 text-slate-400 text-[10px] font-bold px-3 py-1 font-mono uppercase rounded-bl-lg border-l border-b border-white/10" id="roi-badge">ROI Dashboard</div>
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-semibold"><i class="fas fa-chart-pie text-slate-400 mr-2" id="roi-icon"></i>Estimated Value Generated</h3>
                        </div>
                        <div class="grid grid-cols-3 gap-4">
                            <div>
                                <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Time Saved</div>
                                <div class="text-2xl font-bold text-slate-400" id="roi-time-saved-val">0 <span class="text-sm font-normal text-light-slate">hrs</span></div>
                                <div class="text-[10px] text-light-slate/50 mt-1" id="roi-time-saved-sub">⏳ Starts tracking after 1st search</div>
                            </div>
                            <div>
                                <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Downtime Avoided</div>
                                <div class="text-2xl font-bold text-slate-400" id="roi-downtime-avoided-val">0 <span class="text-sm font-normal text-light-slate">days</span></div>
                                <div class="text-[10px] text-light-slate/50 mt-1" id="roi-downtime-avoided-sub">Based on searches</div>
                            </div>
                            <div>
                                <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Estimated Cost Savings</div>
                                <div class="text-2xl font-bold text-slate-400 transition-all duration-300" id="roi-savings-ticker">$0.00</div>
                                <div class="text-[10px] text-light-slate mt-1">(Calculated at your $15k/day downtime rate)</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="glass-card rounded-xl p-6 mb-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-semibold"><i class="fas fa-fire text-[#F97316] mr-2"></i>Most Searched Fault Codes</h3>
                            <span id="fault-codes-ent-badge" class="text-[10px] text-light-slate bg-white/5 px-2 py-1 rounded">Enterprise Feature</span>
                        </div>
                        <div id="fault-heatmap" class="relative min-h-[140px] border border-white/5 rounded-lg bg-white/5 overflow-hidden">
                            <div id="fault-heatmap-empty" class="absolute inset-0 flex flex-col items-center justify-center">
                                <div class="absolute inset-0 flex items-end justify-center gap-2 px-8 pb-10 pt-8 pointer-events-none" aria-hidden="true">
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[38%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[52%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[44%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[60%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[48%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[55%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[42%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[50%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[36%]"></div>
                                    <div class="w-6 rounded-t-sm bg-zinc-700/25 h-[58%]"></div>
                                </div>
                                <p class="relative z-10 text-[11px] text-slate-400 font-medium text-center px-6">Awaiting first fault code search…</p>
                            </div>
                            <div id="fault-heatmap-grid" class="hidden relative z-10 grid grid-cols-8 gap-1.5 p-4"></div>
                        </div>
                        <div class="flex items-center justify-between mt-4 text-[10px] text-light-slate pr-2">
                            <span>Low Activity</span>
                            <div class="flex gap-1">
                                <div class="w-4 h-4 rounded bg-charcoal"></div>
                                <div class="w-4 h-4 rounded bg-graphite"></div>
                                <div class="w-4 h-4 rounded bg-slate"></div>
                                <div class="w-4 h-4 rounded bg-steel"></div>
                                <div class="w-4 h-4 rounded bg-[#F97316]"></div>
                            </div>
                            <span>Critical</span>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-6">
                        <div class="glass-card rounded-xl p-6">
                            <h3 class="font-semibold mb-4"><i class="fas fa-arrow-trend-up text-[#22C55E] mr-2"></i>Trending Issues (This Week)</h3>
                            <div id="trending-list" class="space-y-3"></div>
                        </div>
                        <div class="glass-card rounded-xl p-6">
                            <h3 class="font-semibold mb-4"><i class="fas fa-lightbulb text-[#F97316] mr-2"></i>Predictive Alerts</h3>
                            <div class="space-y-3" id="predictive-alerts-list"></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Asset Registry View -->
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="assets-view" class="dashboard-view hidden flex-1 overflow-y-auto p-6">
                <div class="max-w-6xl mx-auto">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-2xl font-bold">Asset Registry</h2>
                            <p class="text-sm text-light-slate mt-1">Your equipment fleet, mapped and ready for review</p>
                        </div>
                        <div class="flex flex-col items-end gap-1">
                            <button onclick="importAssets()" class="px-3 py-1.5 bg-transparent text-white border border-white/20 rounded text-sm font-medium flex items-center gap-2 hover:bg-white/5 hover:border-white/30 transition-all">
                                <i class="fas fa-file-import text-light-slate"></i>Import Assets
                            </button>
                            <p class="text-[10px] text-slate-500 max-w-[220px] text-right leading-snug">
                                <i class="fas fa-info-circle text-slate-600 mr-1"></i>Import existing maintenance CSVs or sync directly from your ERP.
                            </p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-3 gap-4 mb-6">
                        <div class="glass-card rounded-xl p-4">
                            <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Total Assets</div>
                            <div class="text-2xl font-bold gradient-text" id="total-assets">0</div>
                            <div class="text-[10px] text-light-slate mt-1">System awaiting sync</div>
                        </div>
                        <div class="glass-card rounded-xl p-4">
                            <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">Active Alerts</div>
                            <div class="text-2xl font-bold text-slate-400" id="active-alerts">0</div>
                            <div id="active-alerts-sub" class="text-[10px] text-light-slate mt-1">System awaiting sync</div>
                        </div>
                        <div class="glass-card rounded-xl p-4">
                            <div class="text-[10px] text-light-slate uppercase tracking-wider mb-1">AI Coverage</div>
                            <div class="text-2xl font-bold text-slate-400" id="ai-coverage">--</div>
                            <div id="ai-coverage-sub" class="text-[10px] text-light-slate mt-1">System awaiting sync</div>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 xl:grid-cols-[2fr_1fr] gap-6">
                        <div class="space-y-6">
                            <div class="glass-card rounded-xl p-6">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="font-semibold">Asset Inventory</h3>
                                    <input type="text" placeholder="Search assets..." class="glass-input px-3 py-1.5 rounded text-sm w-64" id="asset-search">
                                </div>
                                <div id="asset-active-fleet" class="mt-4 flex flex-col items-center justify-center border border-dashed border-zinc-800/80 rounded-lg p-8 min-h-[380px] bg-[#0d1117]/50 text-center">
                                    <div class="relative flex items-center justify-center w-16 h-16 rounded-full bg-zinc-900/80 border border-zinc-800 mb-4 shadow-inner">
                                        <i class="fas fa-industry text-2xl text-zinc-500"></i>
                                    </div>

                                    <h4 class="text-sm font-semibold tracking-wide text-zinc-300 uppercase">
                                        Awaiting Asset Configuration
                                    </h4>
                                    
                                    <p class="mt-3 text-sm text-slate-300 max-w-md leading-relaxed">
                                        System ready to link to your factory floor. Connect your first hardware node to begin monitoring.
                                    </p>

                                    <div class="flex flex-col sm:flex-row gap-3 mt-8 w-full max-w-sm justify-center">
                                        <button type="button" onclick="injectDemoAssetStream()" class="flex-1 px-4 py-3 text-sm font-semibold text-white bg-[#F97316] hover:bg-[#EA580C] active:scale-95 rounded-lg transition-all shadow-[0_0_20px_rgba(249,115,22,0.25)] flex items-center justify-center gap-2">
                                            <i class="fas fa-rocket"></i> Inject Demo Fleet
                                        </button>
                                        <button type="button" onclick="connectDataStream()" class="flex-1 px-4 py-3 text-sm font-semibold text-slate-200 bg-transparent border border-slate-600 hover:border-[#F97316]/50 hover:bg-white/5 active:scale-95 rounded-lg transition-all flex items-center justify-center gap-2">
                                            <i class="fas fa-plug text-slate-400"></i> Link Data Stream
                                        </button>
                                    </div>
                                </div>
                                <div id="asset-list" class="space-y-4 mt-4 overflow-y-auto max-h-[calc(100vh-340px)] pr-2 scrollbar-thin scrollbar-thumb-zinc-800">
                                    <!-- Assets populated by JS -->
                                </div>
                            </div>
                        </div>
                        <aside class="space-y-6">
                            <div class="glass-card rounded-xl p-6">
                                <h3 class="font-semibold mb-4">AI Shift Handover</h3>
                                <p class="text-[11px] text-light-slate mb-4">Auto-compile active telemetry anomalies and team queries into a shift log.</p>
                                <button onclick="draftHandoverReport()" class="w-full px-4 py-3 bg-[#F97316] text-black font-semibold rounded-lg hover:bg-[#EA580C] transition-all flex items-center justify-center gap-2">
                                    <i class="fas fa-file-alt"></i> 📝 Draft Handover Report
                                </button>
                            </div>
                            <div id="asset-protocol-panel" class="glass-card rounded-xl p-6 opacity-50 transition-opacity duration-300">
                                <h3 class="font-semibold mb-4">Protocol Ingestion Metrics</h3>
                                <div id="asset-protocol-metrics" class="space-y-3 text-sm text-slate-400">
                                    <div class="flex items-center justify-between"><span>Plant Data Link:</span><span class="font-mono text-xs uppercase tracking-wider">STANDBY</span></div>
                                    <div class="flex items-center justify-between"><span>Live Stream:</span><span class="font-mono text-xs uppercase tracking-wider">Awaiting Connection</span></div>
                                    <div class="flex items-center justify-between"><span>Field Gateway:</span><span class="font-mono text-xs uppercase tracking-wider">Not Connected</span></div>
                                </div>
                            </div>
                            <div class="glass-card rounded-xl p-6">
                                <h3 class="font-semibold mb-4">Smart Threshold Envelope</h3>
                                <p class="text-[11px] text-light-slate mb-4">The shaded band below shows the AI-predicted safe operating range.</p>
                                <div class="h-28 rounded-2xl bg-[#0a0d12] border border-white/10 overflow-hidden relative flex items-center justify-center">
                                    <!-- Disabled state by default -->
                                    <div class="smart-envelope-disabled absolute inset-0 flex flex-col items-center justify-center bg-black/60 text-center p-4 z-10">
                                        <span class="text-xs text-zinc-500 tracking-wide">Select an active machine stream to initialize.</span>
                                    </div>
                                    <!-- Baseline low opacity flat grid line -->
                                    <svg class="absolute inset-0 w-full h-full opacity-10" viewBox="0 0 360 120" preserveAspectRatio="none">
                                        <line x1="0" y1="60" x2="360" y2="60" stroke="#94A3B8" stroke-width="1" stroke-dasharray="4,4" />
                                    </svg>
                                    <svg class="smart-envelope-svg absolute inset-0 w-full h-full hidden" viewBox="0 0 360 120" preserveAspectRatio="none">
                                        <path d="M0,90 L60,70 L120,60 L180,48 L240,45 L300,50 L360,55 L360,120 L0,120 Z" fill="rgba(249,115,22,0.08)" />
                                        <path d="M0,75 C40,72 80,70 120,65 C160,60 200,58 240,55 280,55 320,58 360,60" fill="none" stroke="#F97316" stroke-width="2" />
                                    </svg>
                                </div>
                            </div>
                            <div class="pt-2 border-t border-white/5">
                                <button type="button" onclick="toggleAssetSystemStatus()" class="w-full flex items-center justify-between text-[10px] text-slate-500 hover:text-slate-300 transition py-2">
                                    <span class="flex items-center gap-2"><i class="fas fa-server text-slate-600"></i> System Status (Integrations)</span>
                                    <i id="asset-system-status-chevron" class="fas fa-chevron-down text-[9px]"></i>
                                </button>
                                <div id="asset-system-status-drawer" class="hidden mt-2 p-3 rounded-lg bg-black/30 border border-white/5 space-y-2 text-[10px] text-slate-500 font-mono">
                                    <div class="flex items-center justify-between"><span>OPC UA Server Bridge</span><span id="asset-drawer-opc" class="text-slate-600">Standby</span></div>
                                    <div class="flex items-center justify-between"><span>MQTT Data Ingestion</span><span id="asset-drawer-mqtt" class="text-slate-600">Standby</span></div>
                                    <div class="flex items-center justify-between"><span>Modbus TCP Broker</span><span id="asset-drawer-modbus" class="text-slate-600">Not configured</span></div>
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
            
            <!-- Operational Command Center (Telemetry) -->
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="telemetry-view" class="dashboard-view hidden flex-1 overflow-y-auto p-6">
                <div class="max-w-7xl mx-auto">
                    <div id="telemetry-health-banner" class="system-health-banner mb-5">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#22C55E] status-pulse shrink-0 mt-1"></span>
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-semibold text-[#22C55E] tracking-wide">System Health: Online and Monitoring</div>
                            <p id="telemetry-health-detail" class="text-[11px] text-light-slate mt-0.5">IndexField is active on this node. <span class="text-slate-400 text-[10px]">Awaiting asset link.</span></p>
                        </div>
                    </div>
                    <div class="flex flex-col lg:flex-row items-start justify-between gap-4 mb-6">
                        <div>
                            <h2 class="text-2xl font-bold flex items-center gap-3">
                                <span id="telemetry-title-pulse" class="w-3 h-3 rounded-full bg-slate-500 status-pulse"></span>
                                Live Monitoring
                            </h2>
                            <p class="text-sm text-light-slate mt-1">Real-time plant sensor data with AI-guided alerts.</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-3 lg:ml-auto lg:justify-end">
                            <span class="text-[10px] text-light-slate px-2 py-1 bg-white/5 rounded border border-white/10" id="connected-sensors-count">Awaiting asset link</span>
                            <div class="flex flex-col items-end gap-1">
                                <button onclick="connectDataStream()" class="px-3 py-1.5 bg-white/5 text-white border border-white/15 rounded-md hover:bg-white/10 transition text-xs flex items-center gap-2">
                                    <i class="fas fa-link text-[#F97316]"></i> Initiate Live Link
                                </button>
                                <span class="text-[9px] text-slate-500 tracking-wide">Safe Mode: Read-Only</span>
                            </div>
                            <div class="flex flex-col items-end gap-1">
                                <button onclick="draftHandoverReport()" class="px-3 py-1.5 bg-white/5 text-white border border-white/10 rounded-md text-xs hover:bg-white/10 transition flex items-center gap-2">
                                    <i class="fas fa-file-lines"></i> Draft Handover Report
                                </button>
                                <span class="text-[9px] text-slate-500 text-right max-w-[200px] leading-snug">Summarize shift telemetry &amp; AI findings for next shift</span>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <!-- Phase 2: Primary Time-Series Canvas (Full Width) -->
                        <div class="md:col-span-2 glass-card rounded-xl p-6 border border-white/10 bg-black/80 shadow-[0_0_30px_rgba(0,0,0,0.8)]">
                            <div class="flex items-center justify-between mb-4 border-b border-white/10 pb-4">
                                <div>
                                    <h3 class="font-bold text-lg text-white font-mono uppercase tracking-widest flex items-center gap-2">
                                        <i class="fas fa-wave-square text-[#06B6D4]"></i> Plant Floor Oscilloscope
                                    </h3>
                                    <p class="text-[10px] text-light-slate font-mono mt-1">Multi-axis streams: VIBRATION (mm/s) &amp; TEMPERATURE (°C) — shaded band = normal operating range</p>
                                </div>
                                <div class="flex flex-wrap items-center gap-3">
                                    <div class="flex items-center gap-2">
                                        <div class="w-3 h-0.5 bg-[#06B6D4]"></div>
                                        <span class="text-[10px] font-mono text-light-slate uppercase">Vibration</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="w-3 h-0.5 bg-[#F97316]"></div>
                                        <span class="text-[10px] font-mono text-light-slate uppercase">Temperature</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="w-4 h-3 rounded-sm bg-[#22C55E]/15 border border-[#22C55E]/25"></div>
                                        <span class="text-[10px] font-mono text-slate-400 uppercase">Normal Range</span>
                                    </div>
                                    <span id="osc-live-badge" class="text-[10px] uppercase px-2 py-1 bg-white/5 rounded border border-white/10 font-mono text-slate-400">○ STANDING BY</span>
                                </div>
                            </div>
                            <!-- Massive Time-Series Chart Container -->
                            <div id="oscilloscope-container" class="h-64 w-full bg-[#050505] rounded-lg border border-white/5 overflow-hidden relative">
                                <svg id="oscilloscope-skeleton" class="absolute inset-0 w-full h-full" viewBox="0 0 1000 200" preserveAspectRatio="none">
                                    <defs>
                                        <pattern id="osc-grid" width="50" height="40" patternUnits="userSpaceOnUse">
                                            <path d="M 50 0 L 0 0 0 40" fill="none" class="chart-skeleton-grid"/>
                                        </pattern>
                                    </defs>
                                    <rect width="1000" height="200" fill="url(#osc-grid)" />
                                    <line x1="48" y1="8" x2="48" y2="192" class="chart-skeleton-axis" />
                                    <line x1="48" y1="192" x2="992" y2="192" class="chart-skeleton-axis" />
                                    <line x1="48" y1="50" x2="992" y2="50" class="chart-skeleton-grid" stroke-dasharray="4,6" />
                                    <line x1="48" y1="100" x2="992" y2="100" class="chart-skeleton-grid" stroke-dasharray="4,6" />
                                    <line x1="48" y1="150" x2="992" y2="150" class="chart-skeleton-grid" stroke-dasharray="4,6" />
                                    <text x="8" y="54" class="chart-skeleton-tick">HIGH</text>
                                    <text x="8" y="104" class="chart-skeleton-tick">MID</text>
                                    <text x="8" y="154" class="chart-skeleton-tick">LOW</text>
                                    <text x="120" y="198" class="chart-skeleton-tick">T-60s</text>
                                    <text x="480" y="198" class="chart-skeleton-tick">T-30s</text>
                                    <text x="920" y="198" class="chart-skeleton-tick">NOW</text>
                                    <rect id="osc-normal-band" x="48" y="33" width="944" height="111" fill="rgba(148, 163, 184, 0.04)" stroke="rgba(148, 163, 184, 0.12)" stroke-width="1" stroke-dasharray="6,4" />
                                </svg>
                                <svg class="absolute inset-0 w-full h-full" id="oscilloscope-lines" viewBox="0 0 1000 200" preserveAspectRatio="none">
                                    <path id="osc-vibration" d="M0,100 L1000,100" fill="none" stroke="#06B6D4" stroke-width="2" class="transition-all duration-300"/>
                                    <path id="osc-temperature" d="M0,100 L1000,100" fill="none" stroke="#F97316" stroke-width="2" class="transition-all duration-300"/>
                                </svg>
                                <div id="osc-scan-line" class="absolute top-0 bottom-0 w-0.5 bg-slate-600/30 left-[95%] hidden"></div>
                                <div id="osc-ready-indicator" class="chart-ready-indicator">
                                    <span class="ready-dot"></span>
                                    <span>UI Ready — Awaiting stream</span>
                                </div>
                            </div>
                            <p id="osc-chart-caption" class="text-[10px] text-slate-500 font-mono mt-2 text-center">Awaiting asset link</p>
                        </div>

                        <!-- Phase 3: AI Streaming Console (Left) -->
                        <div class="glass-card rounded-xl border border-white/10 bg-[#0a0a0a] overflow-hidden flex flex-col min-h-[20rem]">
                            <div class="px-6 py-4 bg-black/40 border-b border-white/10 flex items-center justify-between">
                                <h3 class="font-bold text-white font-mono uppercase text-sm"><i class="fas fa-terminal text-[#FACC15] mr-2"></i> AI Anomaly Stream</h3>
                                <span class="w-2 h-2 rounded-full bg-[#22C55E] animate-pulse"></span>
                            </div>
                            <div id="ai-terminal-feed" class="p-6 flex-1 overflow-y-auto space-y-2 font-mono text-[11px] text-[#22C55E] bg-[#050505] relative">
                                <div id="ai-terminal-standby" class="text-slate-400 text-[11px] leading-relaxed">
                                    <span class="text-[#22C55E]/80">&gt;</span> Monitoring engine <span class="text-[#22C55E]">online</span>.<br>
                                    <span class="text-[#22C55E]/80">&gt;</span> <span class="text-slate-300">Awaiting telemetry stream.</span>
                                </div>
                            </div>
                        </div>

                        <!-- Instantaneous Readouts + Recent Anomalies (Right column) -->
                        <div class="flex flex-col gap-4 min-h-[20rem]">
                            <div class="glass-card rounded-xl p-6 border border-white/10 bg-black/80 flex flex-col flex-1">
                                <h3 class="font-bold text-white font-mono uppercase text-sm mb-4"><i class="fas fa-tachometer-alt text-[#F97316] mr-2"></i> Instantaneous Readouts</h3>
                                <div class="grid grid-cols-2 gap-4 flex-1">
                                    <div class="bg-[#111] border border-white/5 rounded-lg p-4 flex flex-col justify-center items-center text-center">
                                        <span class="text-[10px] text-light-slate font-mono uppercase tracking-widest mb-2">Spindle Load</span>
                                        <div class="flex items-center gap-2">
                                            <span id="gauge-spindle" class="text-3xl font-black font-mono text-slate-400 tracking-tighter">—<span class="text-sm text-light-slate ml-1">%</span></span>
                                            <span id="gauge-spindle-trend" class="text-slate-500 text-xs" title="Trend"><i class="fas fa-minus"></i></span>
                                        </div>
                                    </div>
                                    <div class="bg-[#111] border border-white/5 rounded-lg p-4 flex flex-col justify-center items-center text-center">
                                        <span class="text-[10px] text-light-slate font-mono uppercase tracking-widest mb-2">Coolant Press.</span>
                                        <div class="flex items-center gap-2">
                                            <span id="gauge-coolant" class="text-3xl font-black font-mono text-slate-400 tracking-tighter">—<span class="text-sm text-light-slate ml-1">PSI</span></span>
                                            <span id="gauge-coolant-trend" class="text-slate-500 text-xs" title="Trend"><i class="fas fa-minus"></i></span>
                                        </div>
                                    </div>
                                    <div class="bg-[#111] border border-white/5 rounded-lg p-4 flex flex-col justify-center items-center text-center col-span-2">
                                        <span class="text-[10px] text-light-slate font-mono uppercase tracking-widest mb-2">System Flow Rate</span>
                                        <span id="gauge-flow" class="text-4xl font-black font-mono text-slate-400 tracking-tighter">—<span class="text-base text-light-slate ml-2">L/min</span></span>
                                    </div>
                                </div>
                            </div>
                            <div class="glass-card rounded-xl p-4 border border-white/10 bg-[#0a0a0a]">
                                <h3 class="font-bold text-white font-mono uppercase text-[10px] tracking-widest mb-3 flex items-center gap-2 text-slate-300">
                                    <i class="fas fa-exclamation-circle text-amber-500/80 text-xs"></i> Recent Anomalies
                                </h3>
                                <ul id="telemetry-anomaly-ticker" class="space-y-2 font-mono text-[11px] min-h-[4.5rem]">
                                    <li class="telemetry-anomaly-standby flex gap-2 text-slate-400 py-2 items-start">
                                        <span class="ready-dot shrink-0 mt-1" style="width:5px;height:5px;"></span>
                                        <span class="italic">No anomalies — awaiting live link</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Stream Connector Modal -->
            <div id="data-stream-modal" class="hidden fixed inset-0 z-[250] bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="w-full max-w-2xl rounded-3xl bg-slate-950 border border-white/10 shadow-2xl overflow-hidden">
                    <div class="flex items-start justify-between px-6 py-4 border-b border-white/10">
                        <div>
                            <h3 class="text-lg font-semibold text-white">Initiate Live Link</h3>
                            <p class="text-sm text-light-slate mt-1">Choose a live broker connection or upload a demo file for instant telemetry preview.</p>
                        </div>
                        <button onclick="closeDataStreamModal()" class="text-light-slate hover:text-white text-2xl leading-none">×</button>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 p-6">
                        <div class="glass-card rounded-2xl p-5 border border-white/10">
                            <h4 class="font-semibold mb-3">Live MQTT / WebSocket</h4>
                            <p class="text-[11px] text-light-slate mb-4">Enter a live broker URL to connect the scanner engine to your plant floor.</p>
                            <input id="live-stream-url" type="text" placeholder="mqtt://broker.local:1883 or ws://edge-node:9001" class="glass-input w-full px-3 py-2 rounded text-sm mb-4" />
                            <button onclick="connectLiveUrl()" class="w-full py-3 bg-[#22C55E] text-black font-semibold rounded-lg hover:bg-[#16A34A] transition">Connect Live Stream</button>
                        </div>
                        <div class="glass-card rounded-2xl p-5 border border-white/10">
                            <h4 class="font-semibold mb-3">Demo File Upload</h4>
                            <p class="text-[11px] text-light-slate mb-4">Upload a historical JSON or CSV telemetry file to demo charts and AI scoring.</p>
                            <button onclick="uploadDemoTelemetryFile()" class="w-full py-3 bg-[#F97316] text-black font-semibold rounded-lg hover:bg-[#EA580C] transition">Upload Demo File</button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- AI Alert Overlay (Urgent Bottom-Center Design) -->
            <div id="ai-alert-overlay" class="hidden fixed bottom-10 left-1/2 -translate-x-1/2 z-[200] w-full max-w-lg">
                <div class="bg-red-950/40 border-2 border-red-500 backdrop-blur-xl p-6 rounded-2xl shadow-[0_0_50px_rgba(239,68,68,0.4)] animate-pulse">
                    <div class="flex items-start gap-4">
                        <div class="bg-red-500 p-2 rounded-lg shrink-0">
                            <i class="fas fa-exclamation-triangle text-black text-xl"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-red-500 text-lg uppercase tracking-widest" id="anomaly-title">Anomaly Detected</h4>
                            <p class="text-white/90 text-sm mt-1">
                                Vibration spike <span class="font-bold text-red-400">(8.4 mm/s)</span> detected. <span class="font-bold text-[#F97316]">AI Analysis:</span> 92% match with bearing fatigue pattern in Manual Section 4.2.
                            </p>
                            <div class="flex gap-3 mt-4">
                                <button onclick="generateWorkOrder(AppState.currentAsset)" class="flex-1 py-2.5 bg-red-500 text-black font-bold rounded-lg hover:bg-red-400 transition text-xs uppercase tracking-wider">
                                    <i class="fas fa-file-export mr-1"></i>Draft Work Order
                                </button>
                                <button onclick="handleAlert('dismiss')" class="flex-1 py-2.5 bg-white/10 border border-white/20 rounded-lg font-bold hover:bg-white/20 transition text-xs uppercase tracking-wider">
                                    Ignore
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Knowledge Vault View -->
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="vault-view" class="dashboard-view hidden flex-1 overflow-y-auto p-6">
                <div class="max-w-4xl mx-auto">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-2xl font-bold">Field Notes</h2>
                            <p class="text-sm text-light-slate mt-1">Field tips and practical fixes from experienced technicians</p>
                        </div>
                        <button onclick="createKnowledgePost()" class="px-3 py-1.5 bg-[#F97316] text-white border border-[#EA580C] rounded text-sm font-medium flex items-center gap-2 hover:bg-[#EA580C] transition-all">
                            <i class="fas fa-plus"></i>Add Field Note
                        </button>
                    </div>

                    <div id="knowledge-feed" class="space-y-4">
                        <!-- Knowledge posts populated by JS -->
                    </div>
                </div>
            </div>
            
            <!-- Field Notes View -->
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="field-view" class="dashboard-view hidden flex-1 overflow-y-auto">
                <div class="h-full flex flex-col items-center justify-center p-6">
                    <div class="w-full max-w-md">
                        <div class="text-center mb-8">
                            <div class="w-20 h-20 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-[#F97316]/20 to-[#22C55E]/20 border border-[#F97316]/20 flex items-center justify-center">
                                <i class="fas fa-qrcode text-4xl text-[#F97316]"></i>
                            </div>
                            <h2 class="text-2xl font-bold mb-2">Field Scan</h2>
                            <p class="text-sm text-light-slate">Scan an equipment QR code for quick manual access</p>
                        </div>

                        <div class="glass-card rounded-2xl p-8 mb-6">
                            <div id="qr-scanner-area" class="aspect-square rounded-xl border-2 border-dashed border-[#F97316]/30 flex flex-col items-center justify-center cursor-pointer hover:border-[#F97316] transition-all" onclick="simulateQRScan()">
                                <i class="fas fa-camera text-3xl text-[#F97316]/50 mb-3"></i>
                                <p class="text-sm text-light-slate">Tap to simulate QR scan</p>
                                <p class="text-xs text-light-slate/50 mt-1">Camera access required on mobile</p>
                            </div>
                        </div>
                        
                        <div id="qr-result" class="hidden glass-card rounded-xl p-4">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-10 h-10 rounded-lg bg-[#F97316]/10 flex items-center justify-center">
                                    <i class="fas fa-industry text-[#F97316]"></i>
                                </div>
                                <div>
                                    <h4 id="scan-asset-name" class="font-semibold">Unnamed Asset</h4>
                                    <p id="scan-asset-serial" class="text-xs text-light-slate">Serial: --</p>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <button onclick="loadAssetManual('P-101')" class="w-full p-3 bg-white/5 hover:bg-white/10 rounded-lg text-left text-sm flex items-center gap-2 transition">
                                    <i class="fas fa-book text-[#F97316]"></i>
                                    <span>View Maintenance Manual</span>
                                </button>
                                <button onclick="showAssetHistory('P-101')" class="w-full p-3 bg-white/5 hover:bg-white/10 rounded-lg text-left text-sm flex items-center gap-2 transition">
                                    <i class="fas fa-history text-[#22C55E]"></i>
                                    <span>Last 3 Maintenance Records</span>
                                </button>
                                <button onclick="requestAssistance('P-101')" class="w-full p-3 bg-[#F97316]/10 hover:bg-[#F97316]/20 border border-[#F97316]/30 rounded-lg text-left text-sm flex items-center gap-2 transition">
                                    <i class="fas fa-robot text-[#F97316]"></i>
                                    <span>Ask AI About This Asset</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Lockout / Tagout View -->
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="loto-view" class="dashboard-view hidden flex-1 overflow-y-auto p-6">
                <div class="w-full">

                    <!-- Phase 1: Terminal Status Header -->
                    <div class="mb-6">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h2 class="text-2xl font-bold font-mono uppercase tracking-widest flex items-center gap-3">
                                    <i class="fas fa-shield-alt text-yellow-500"></i> Lockout / Tagout
                                </h2>
                                <p class="text-[10px] text-light-slate font-mono mt-1">Lockout / Tagout Center // Safety checks and permit review</p>
                            </div>
                            <span class="text-[10px] uppercase px-3 py-1.5 bg-yellow-500/10 rounded border border-yellow-500/30 font-mono text-yellow-500 font-bold tracking-widest animate-pulse">SAFETY CRITICAL SYSTEM</span>
                        </div>
                        <div class="grid grid-cols-3 gap-4">
                            <div class="glass-card rounded-xl p-4 border border-yellow-500/20 bg-yellow-500/5">
                                <div class="text-[10px] text-yellow-500/80 font-mono uppercase tracking-widest mb-1">Active Permits to Work</div>
                                <div class="text-3xl font-black font-mono text-yellow-500" id="loto-permits-count">0</div>
                            </div>
                            <div class="glass-card rounded-xl p-4 border border-[#22C55E]/20 bg-[#22C55E]/5">
                                <div class="text-[10px] text-[#22C55E]/80 font-mono uppercase tracking-widest mb-1">Secured Isolations (LOTO)</div>
                                <div class="text-3xl font-black font-mono text-[#22C55E]" id="loto-secured-count">0</div>
                            </div>
                            <div class="glass-card rounded-xl p-4 border border-red-500/20 bg-red-500/5">
                                <div class="text-[10px] text-red-500/80 font-mono uppercase tracking-widest mb-1">Critical Hazard Breaches</div>
                                <div class="text-3xl font-black font-mono text-red-500" id="loto-breach-count">0</div>
                            </div>
                        </div>
                    </div>

                    <!-- Phase 2-5: Three-Zone Tactical Grid -->
                    <div class="grid grid-cols-[30%_45%_25%] gap-4 h-[calc(100vh-320px)]">

                        <!-- Phase 3: Active Interventions Registry (Left Panel) -->
                        <div class="glass-card rounded-xl border border-white/10 bg-black/80 overflow-hidden flex flex-col">
                            <div class="px-4 py-3 bg-black/60 border-b border-white/10 flex items-center justify-between">
                                <h3 class="font-bold text-white font-mono uppercase text-[11px] tracking-widest"><i class="fas fa-clipboard-list text-yellow-500 mr-2"></i>Active Interventions</h3>
                                <span class="text-[9px] font-mono text-light-slate cursor-pointer hover:text-yellow-500 transition" id="loto-intervention-count" onclick="injectLotoDemoAssets()" title="Click to inject demo">0 ITEMS ▶</span>
                            </div>
                            <div id="loto-intervention-list" class="flex-1 overflow-y-auto p-3 space-y-2">
                                <div class="flex flex-col items-center justify-center h-full text-center opacity-50">
                                    <i class="fas fa-hard-hat text-2xl text-yellow-500/30 mb-3"></i>
                                    <p class="text-[11px] text-white font-mono">NO ACTIVE INTERVENTIONS</p>
                                    <p class="text-[10px] text-[#94A3B8] font-mono mt-1 max-w-[200px] leading-relaxed">No active maintenance interventions. When an asset requires service, its lockout sequence will appear here.</p>
                                    <button id="mock-intervention-btn" onclick="startMockIntervention()" class="mt-3 px-2.5 py-1.5 bg-yellow-500/10 hover:bg-yellow-500/20 border border-yellow-500/30 hover:border-yellow-500/50 text-[9px] text-yellow-500 font-mono rounded uppercase tracking-wider transition-all duration-200">
                                        Create Mock Intervention
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Phase 4: AI-Generated Extraction Isolation Protocol (Center Panel) -->
                        <div class="glass-card rounded-xl border border-white/10 bg-[#0a0a0a] overflow-hidden flex flex-col">
                            <div class="px-4 py-3 bg-black/60 border-b border-white/10 flex items-center justify-between">
                                <h3 class="font-bold text-white font-mono uppercase text-[11px] tracking-widest"><i class="fas fa-file-shield text-[#06B6D4] mr-2"></i>Isolation Protocol</h3>
                                <span id="loto-ai-confidence" class="text-[9px] font-mono text-light-slate/50">SELECT ASSET TO LOAD PROTOCOL</span>
                            </div>
                            <div id="loto-protocol-body" class="flex-1 h-full overflow-y-auto p-5 font-mono text-sm flex flex-col justify-center items-center">
                                <div class="flex-1 flex flex-col items-center justify-center text-center opacity-40 min-h-full">
                                    <i class="fas fa-file-alt text-4xl text-[#06B6D4]/30 mb-4"></i>
                                    <p class="text-[11px] text-[#94A3B8] font-bold">AWAITING ASSET SELECTION</p>
                                    <p class="text-[10px] text-[#94A3B8] mt-1 max-w-[260px]">No active interventions exist yet. Index equipment from Manuals or Asset Registry to begin a safe isolation workflow.</p>
                                    <div class="mt-5 flex flex-col sm:flex-row gap-2 justify-center">
                                        <button onclick="showView('manuals')" class="px-3 py-2 bg-[#F97316] text-white rounded-lg text-[10px] font-semibold uppercase tracking-widest hover:bg-[#EA580C] transition">Manuals</button>
                                        <button onclick="showView('assets')" class="px-3 py-2 bg-white/5 border border-white/10 text-[#94A3B8] rounded-lg text-[10px] font-semibold uppercase tracking-widest hover:bg-white/10 transition">Asset Registry</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Phase 5: Interlocking Telemetry Verification (Right Panel) -->
                        <div class="glass-card rounded-xl border border-white/10 bg-black/80 overflow-hidden flex flex-col">
                            <div class="px-4 py-3 bg-black/60 border-b border-white/10">
                                <h3 class="font-bold text-white font-mono uppercase text-[11px] tracking-widest"><i class="fas fa-bolt text-red-500 mr-2"></i>Interlock Verification</h3>
                            </div>
                            <div class="flex-1 p-4 space-y-3 flex flex-col">
                                <!-- Voltage -->
                                <div class="bg-[#111] border border-white/5 rounded-lg p-4 flex flex-col items-center text-center">
                                    <span class="text-[9px] text-light-slate font-mono uppercase tracking-widest mb-2">Residual Voltage</span>
                                    <span id="loto-voltage" class="text-3xl font-black font-mono text-light-slate tracking-tighter">--<span class="text-sm text-light-slate ml-1">V</span></span>
                                    <div class="mt-1 text-[8px] font-mono tracking-wider uppercase text-amber-500/60 flex items-center justify-center gap-1" id="loto-voltage-status">
                                        Disconnected
                                        <span class="telemetry-tooltip-trigger cursor-help text-slate-400/70 hover:text-slate-300 transition-colors">
                                            <i class="fas fa-info-circle text-[8px]"></i>
                                            <span class="telemetry-tooltip">Expected Topic: plant/floor1/spindle/voltage<br>OPC UA: ns=2;s=Spindle.Voltage</span>
                                        </span>
                                    </div>
                                </div>
                                <!-- Hydraulic Pressure -->
                                <div class="bg-[#111] border border-white/5 rounded-lg p-4 flex flex-col items-center text-center">
                                    <span class="text-[9px] text-light-slate font-mono uppercase tracking-widest mb-2">Hydraulic Pressure</span>
                                    <span id="loto-pressure" class="text-3xl font-black font-mono text-light-slate tracking-tighter">--<span class="text-sm text-light-slate ml-1">PSI</span></span>
                                    <div class="mt-1 text-[8px] font-mono tracking-wider uppercase text-amber-500/60 flex items-center justify-center gap-1" id="loto-pressure-status">
                                        Disconnected
                                        <span class="telemetry-tooltip-trigger cursor-help text-slate-400/70 hover:text-slate-300 transition-colors">
                                            <i class="fas fa-info-circle text-[8px]"></i>
                                            <span class="telemetry-tooltip">Expected Topic: plant/floor1/hydraulic/pressure<br>OPC UA: ns=2;s=Hydraulic.Pressure</span>
                                        </span>
                                    </div>
                                </div>
                                <!-- Spindle RPM -->
                                <div class="bg-[#111] border border-white/5 rounded-lg p-4 flex flex-col items-center text-center">
                                    <span class="text-[9px] text-light-slate font-mono uppercase tracking-widest mb-2">Spindle RPM</span>
                                    <span id="loto-rpm" class="text-3xl font-black font-mono text-light-slate tracking-tighter">--<span class="text-sm text-light-slate ml-1">RPM</span></span>
                                    <div class="mt-1 text-[8px] font-mono tracking-wider uppercase text-amber-500/60 flex items-center justify-center gap-1" id="loto-rpm-status">
                                        Disconnected
                                        <span class="telemetry-tooltip-trigger cursor-help text-slate-400/70 hover:text-slate-300 transition-colors">
                                            <i class="fas fa-info-circle text-[8px]"></i>
                                            <span class="telemetry-tooltip">Expected Topic: plant/floor1/spindle/rpm<br>OPC UA: ns=2;s=Spindle.RPM</span>
                                        </span>
                                    </div>
                                </div>
                                <!-- Spacer -->
                                <div class="flex-1"></div>
                                <!-- Authorization Button -->
                                <button id="loto-authorize-btn" disabled class="w-full py-4 bg-slate-950 border-2 border-slate-700/30 text-slate-300 font-mono font-bold uppercase text-sm tracking-widest rounded-lg cursor-not-allowed opacity-100 transition-all">
                                    <i class="fas fa-lock mr-2"></i> AUTHORIZE SAFE ENTRY
                                </button>
                                <p id="loto-auth-hint" class="text-[9px] text-[#FF453A] font-black tracking-wider font-mono text-center uppercase">ALL INTERLOCKS MUST READ ZERO BEFORE ENTRY IS AUTHORIZED</p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <!-- Lockout / Tagout View -->
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="prognostics-view" class="dashboard-view hidden flex-col flex-1 overflow-y-auto p-6 font-mono text-white">
                <div class="w-full max-w-[1400px] mx-auto h-full flex flex-col">
                    <div id="prognostics-health-banner" class="system-health-banner mb-5">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#22C55E] status-pulse shrink-0 mt-1"></span>
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-semibold text-[#22C55E] tracking-wide">System Health: Online and Monitoring</div>
                            <p id="prognostics-health-detail" class="text-[11px] text-light-slate mt-0.5">Predictive models loaded and ready.</p>
                        </div>
                    </div>
                    <header class="prognostics-page-header">
                        <div class="flex items-start justify-between gap-4 flex-wrap">
                            <div class="min-w-0">
                                <h2 class="text-2xl font-bold font-mono uppercase tracking-widest flex items-center gap-3">
                                    <i class="fas fa-chart-line text-[#22C55E]"></i> Maintenance Forecast
                                </h2>
                                <p class="text-[10px] text-light-slate font-mono mt-1">PREDICTIVE PLANNING // AI-BASED MAINTENANCE SIGNALS</p>
                            </div>
                            <div class="prognostics-header-utilities flex items-center gap-2 shrink-0">
                                <button type="button" class="prognostics-utility-btn" onclick="openPrognosticsGlobalSearch()" title="Search assets and logs" aria-label="Global search">
                                    <i class="fas fa-search text-xs"></i>
                                </button>
                                <button type="button" class="prognostics-utility-btn" onclick="openPrognosticsNotifications()" title="Pending maintenance alerts" aria-label="Notifications">
                                    <i class="fas fa-bell text-xs"></i>
                                    <span id="prog-notif-badge" class="prognostics-notif-badge hidden">0</span>
                                </button>
                                <div class="prognostics-density-toggle" role="group" aria-label="Display density">
                                    <button type="button" id="prog-density-compact" onclick="setPrognosticsDensity('compact')">Compact</button>
                                    <button type="button" id="prog-density-expanded" class="active" onclick="setPrognosticsDensity('expanded')">Expanded</button>
                                </div>
                                <span id="prognostics-status-chip" class="text-[10px] uppercase px-3 py-1.5 bg-white/5 rounded border border-white/10 font-mono text-slate-400 font-bold tracking-widest whitespace-nowrap">FORECAST STANDBY</span>
                            </div>
                        </div>
                    </header>

                    <div id="prognostics-body" class="relative flex-1 flex flex-col min-h-[560px]">
                    <div id="prognostics-skeleton" class="flex-1 flex flex-col gap-4 min-h-[560px] pointer-events-none">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 opacity-40">
                            <div class="glass-card rounded-xl p-4 border border-white/10 h-24"><div class="h-3 w-2/3 rounded bg-slate-700/50 mb-3"></div><div class="h-8 w-1/3 rounded bg-slate-800/80"></div></div>
                            <div class="glass-card rounded-xl p-4 border border-white/10 h-24"><div class="h-3 w-2/3 rounded bg-slate-700/50 mb-3"></div><div class="h-8 w-1/3 rounded bg-slate-800/80"></div></div>
                            <div class="glass-card rounded-xl p-4 border border-white/10 h-24"><div class="h-3 w-2/3 rounded bg-slate-700/50 mb-3"></div><div class="h-8 w-1/3 rounded bg-slate-800/80"></div></div>
                        </div>
                        <div class="h-[55%] glass-card rounded-xl border border-white/10 bg-black/80 flex flex-col overflow-hidden relative">
                            <div class="px-4 py-3 bg-black/80 border-b border-white/10 flex items-center justify-between z-10 relative">
                                <h3 class="font-bold text-white font-mono uppercase text-[11px] tracking-widest"><i class="fas fa-stream text-slate-500 mr-2"></i>Remaining Useful Life (RUL) - 90 Day Forecast</h3>
                            </div>
                            <div class="flex-1 p-6 relative">
                                <svg class="absolute inset-0 w-full h-full opacity-90" viewBox="0 0 800 280" preserveAspectRatio="none">
                                    <defs>
                                        <pattern id="prog-grid" width="40" height="35" patternUnits="userSpaceOnUse">
                                            <path d="M 40 0 L 0 0 0 35" fill="none" class="chart-skeleton-grid"/>
                                        </pattern>
                                    </defs>
                                    <rect width="800" height="280" fill="url(#prog-grid)" />
                                    <line x1="56" y1="12" x2="56" y2="248" class="chart-skeleton-axis" />
                                    <line x1="56" y1="248" x2="784" y2="248" class="chart-skeleton-axis" />
                                    <text x="200" y="268" class="chart-skeleton-tick">+30 DAYS</text>
                                    <text x="400" y="268" class="chart-skeleton-tick">+60 DAYS</text>
                                    <text x="600" y="268" class="chart-skeleton-tick">+90 DAYS</text>
                                </svg>
                                <div class="relative z-10 space-y-6 mt-4">
                                    <div class="flex items-center gap-4"><span class="w-[28%] h-3 rounded bg-slate-700/40"></span><span class="flex-1 h-4 rounded bg-slate-800/80 border border-white/5"></span></div>
                                    <div class="flex items-center gap-4"><span class="w-[28%] h-3 rounded bg-slate-700/40"></span><span class="flex-1 h-4 rounded bg-slate-800/80 border border-white/5"></span></div>
                                    <div class="flex items-center gap-4"><span class="w-[28%] h-3 rounded bg-slate-700/40"></span><span class="flex-1 h-4 rounded bg-slate-800/80 border border-white/5"></span></div>
                                    <div class="flex items-center gap-4"><span class="w-[28%] h-3 rounded bg-slate-700/40"></span><span class="flex-1 h-4 rounded bg-slate-800/80 border border-white/5"></span></div>
                                </div>
                                <div class="chart-ready-indicator" style="bottom: 8px;">
                                    <span class="ready-dot"></span>
                                    <span>Forecast grid ready</span>
                                </div>
                            </div>
                        </div>
                        <div class="h-[45%] grid grid-cols-1 md:grid-cols-2 gap-4 opacity-40">
                            <div class="glass-card rounded-xl border border-white/10 min-h-[180px] p-4"><div class="space-y-2"><div class="h-8 rounded bg-slate-800/60"></div><div class="h-8 rounded bg-slate-800/60"></div></div></div>
                            <div class="glass-card rounded-xl border border-white/10 min-h-[180px] p-4"><div class="space-y-2"><div class="h-8 rounded bg-slate-800/60"></div><div class="h-8 rounded bg-slate-800/60"></div></div></div>
                        </div>
                    </div>

                    <div id="prognostics-onboarding-overlay" class="absolute inset-0 z-20 flex items-center justify-center p-6 bg-black/40 backdrop-blur-[2px]">
                        <div class="prognostics-onboarding-card rounded-2xl animate-in">
                            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#F97316]/10 border border-[#F97316]/30 flex items-center justify-center">
                                <i class="fas fa-network-wired text-2xl text-[#F97316]"></i>
                            </div>
                            <h3 class="text-lg font-bold text-white font-mono uppercase tracking-wider mb-2">Get Started</h3>
                            <p class="text-sm text-light-slate leading-relaxed mb-6">Link equipment from your plant floor to unlock 90-day RUL forecasting, AI action queues, and procurement signals.</p>
                            <button type="button" onclick="prognosticsLinkAssets()" class="w-full px-5 py-3.5 bg-[#F97316] hover:bg-[#EA580C] text-black font-bold rounded-lg transition-all shadow-[0_0_24px_rgba(249,115,22,0.3)] flex items-center justify-center gap-2">
                                <i class="fas fa-plug"></i> Link Assets to Network
                            </button>
                            <button type="button" onclick="showView('manuals')" class="mt-3 w-full text-[11px] text-slate-400 hover:text-white transition">Upload manuals first for richer forecasts</button>
                        </div>
                    </div>

                    <div id="prognostics-active" class="hidden flex-1 flex flex-col gap-4 min-h-[560px] prognostics-density-expanded">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" id="prognostics-metrics-row">
                            <div class="glass-card rounded-xl p-4 border border-yellow-500/20 bg-yellow-500/5">
                                <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                                    <div class="text-[10px] text-yellow-500/80 font-mono uppercase tracking-widest">Impending Failures (30-Day)</div>
                                    <span id="prog-ai-confidence" class="text-[9px] text-slate-400 font-mono whitespace-nowrap" title="Fleet-wide model confidence">AI confidence: —</span>
                                </div>
                                <div id="prog-metric-failures" class="text-3xl font-black font-mono text-yellow-500">0</div>
                            </div>
                            <div class="glass-card rounded-xl p-4 border border-white/10">
                                <div class="text-[10px] text-slate-400 font-mono uppercase tracking-widest mb-1">Critical Spares Deficit</div>
                                <div id="prog-metric-spares" class="text-3xl font-black font-mono text-slate-300">0</div>
                            </div>
                            <div class="glass-card rounded-xl p-4 border border-[#22C55E]/20 bg-[#22C55E]/5">
                                <div class="text-[10px] text-[#22C55E]/80 font-mono uppercase tracking-widest mb-1">Estimated Downtime Saved</div>
                                <div id="prog-metric-saved" class="text-3xl font-black font-mono text-[#22C55E]">—</div>
                            </div>
                        </div>
                        <div class="flex-1 glass-card rounded-xl border border-white/10 bg-black/80 flex flex-col overflow-hidden min-h-[280px]" style="background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 20px 20px;">
                            <div class="px-4 py-3 bg-black/80 border-b border-white/10 flex items-center justify-between flex-wrap gap-2">
                                <h3 class="font-bold text-white font-mono uppercase text-[11px] tracking-widest"><i class="fas fa-stream text-[#06B6D4] mr-2"></i>Remaining Useful Life (RUL) — 90 Day Forecast</h3>
                                <div class="flex gap-3 text-[9px] font-mono text-light-slate">
                                    <span class="flex items-center gap-1"><i class="fas fa-triangle-exclamation text-yellow-500 text-[8px]"></i> Warning</span>
                                    <span class="flex items-center gap-1"><i class="fas fa-circle-exclamation text-red-500 text-[8px]"></i> Failure</span>
                                    <span class="flex items-center gap-1"><i class="fas fa-circle-check text-[#22C55E] text-[8px]"></i> Nominal</span>
                                </div>
                            </div>
                            <div class="flex-1 p-4 overflow-y-auto">
                                <div class="flex justify-end text-[9px] text-light-slate/50 font-mono border-b border-white/10 pb-2 mb-4 gap-8 pr-2">
                                    <span>TODAY</span><span>+30D</span><span>+60D</span><span>+90D</span>
                                </div>
                                <div id="prognostics-rul-rows" class="space-y-4"></div>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 min-h-[220px]">
                            <div class="glass-card rounded-xl border border-white/10 bg-black/80 flex flex-col overflow-hidden">
                                <div class="px-4 py-3 bg-black/60 border-b border-white/10">
                                    <h3 class="font-bold text-white font-mono uppercase text-[11px] tracking-widest"><i class="fas fa-clipboard-check text-yellow-500 mr-2"></i>AI Action Queue</h3>
                                </div>
                                <div id="prognostics-action-queue" class="flex-1 p-3 overflow-y-auto space-y-3"></div>
                            </div>
                            <div class="glass-card rounded-xl border border-white/10 bg-black/80 flex flex-col overflow-hidden">
                                <div class="px-4 py-3 bg-black/60 border-b border-white/10 flex items-center justify-between">
                                    <h3 class="font-bold text-white font-mono uppercase text-[11px] tracking-widest"><i class="fas fa-boxes text-[#22C55E] mr-2"></i>Procurement Logistics</h3>
                                    <span id="prog-erp-sync" class="text-[9px] text-slate-500 font-bold tracking-widest">AWAITING ERP</span>
                                </div>
                                <div id="prognostics-procurement-body" class="flex-1 overflow-y-auto p-3 text-[10px] text-slate-500 text-center"></div>
                            </div>
                        </div>
                    </div>
                    </div>

                </div>
            </div>
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="history-view" class="dashboard-view hidden flex-1 overflow-y-auto p-6 font-mono text-white">
                <div class="max-w-6xl mx-auto">
                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <h2 class="text-xl font-bold tracking-widest text-[#F97316]">Search History</h2>
                            <p class="text-xs text-light-slate mt-2 tracking-wide">Review past questions, confirm the source of answers, and keep records in order.</p>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="relative w-72">
                                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-light-slate/50 text-xs"></i>
                                <input type="text" placeholder="Filter audit log by asset, operator, or inquiry..." class="w-full bg-white/5 border border-white/10 rounded px-9 py-2 text-[10px] text-white focus:outline-none focus:border-[#F97316]/50 transition-colors placeholder:text-light-slate/40">
                            </div>
                            <button class="px-4 py-2 bg-white/5 border border-white/10 rounded text-[10px] font-bold text-light-slate hover:text-white hover:bg-white/10 transition-colors tracking-widest flex items-center gap-2">
                                <i class="fas fa-file-export"></i> EXPORT CSV
                            </button>
                        </div>
                    </div>
                    
                    <!-- Empty State: Data Feed Offline -->
                    <div id="history-empty-state" class="flex flex-col items-center justify-center py-20 px-4 border border-[#F97316]/20 bg-[#F97316]/5 rounded-xl text-center relative overflow-hidden">
                        <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(circle at center, rgba(249, 115, 22, 0.4) 0, transparent 70%);"></div>
                        <i class="fas fa-clipboard-list text-5xl text-light-slate/25 mb-6"></i>
                        <h3 class="text-sm font-bold text-white/80 tracking-widest mb-2 flex items-center justify-center gap-2">
                            [ NO SEARCH HISTORY YET ]
                        </h3>
                        <p class="text-xs text-light-slate mb-4 max-w-md mx-auto">Search history is empty. Once questions are asked, the recent activity will show here.</p>
                        <button type="button" onclick="showView('chat')" class="mb-10 px-5 py-2.5 text-xs font-semibold border border-slate-500 text-slate-200 hover:text-white hover:border-[#F97316]/40 hover:bg-white/5 rounded-lg transition-all inline-flex items-center gap-2">
                            <i class="fas fa-comments text-[#F97316]/80"></i> Go to Ask Questions
                        </button>
                        
                        <div id="history-empty-manuals" class="hidden w-full max-w-3xl mb-8 p-6 bg-[#111827]/80 border border-white/10 rounded-xl">
                            <p class="text-sm font-semibold text-white mb-2">🔒 Search History Unavailable</p>
                            <p class="text-xs text-slate-400 mb-4">Upload at least one machinery manual before searches can be logged.</p>
                            <button onclick="showView('manuals')" class="px-5 py-3 bg-[#F97316] text-white rounded-lg font-semibold hover:bg-[#EA580C] transition">Go to Manuals</button>
                        </div>

                        <div class="w-full max-w-4xl">
                            <p class="text-[10px] text-[#F97316] font-bold tracking-widest mb-4 uppercase text-left border-b border-[#F97316]/20 pb-2">Sample Search History</p>
                            <div id="history-sample-grid" class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
                                <button type="button" onclick="injectHistoryQuery('SIEMENS_TURBINE_V2', 'Hydraulic lockup on error E-402', 'Page 244 // Table 4')" class="history-sample group p-4 bg-[#0a0d12] border border-white/10 hover:border-[#F97316]/50 rounded-lg transition-all text-xs flex flex-col gap-2 relative overflow-hidden cursor-pointer">
                                    <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-[8px] text-slate-500 uppercase tracking-wider font-semibold">
                                        <span>Operator: Shift 2 Tech</span>
                                        <span>Timestamp: Today, 14:30</span>
                                        <span class="col-span-2 text-[#22C55E]/80">AI Confidence: 98%</span>
                                    </div>
                                    <div class="text-[9px] text-light-slate/50 font-bold tracking-widest flex justify-between pt-1 border-t border-white/5"><span>TARGET: SIEMENS_TURBINE_V2</span><i class="fas fa-arrow-right text-[#F97316]/0 group-hover:text-[#F97316] transition-all"></i></div>
                                    <div class="text-[#F97316] font-mono text-[11px]">"Hydraulic lockup on error E-402"</div>
                                </button>
                                <button type="button" onclick="injectHistoryQuery('CAT_GENERATOR_SOP', 'Oil pressure sensor baseline specs', 'Page 12 // Para 3')" class="history-sample group p-4 bg-[#0a0d12] border border-white/10 hover:border-[#F97316]/50 rounded-lg transition-all text-xs flex flex-col gap-2 relative overflow-hidden cursor-pointer">
                                    <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-[8px] text-slate-500 uppercase tracking-wider font-semibold">
                                        <span>Operator: Shift 1 Lead</span>
                                        <span>Timestamp: Today, 09:15</span>
                                        <span class="col-span-2 text-[#22C55E]/80">AI Confidence: 96%</span>
                                    </div>
                                    <div class="text-[9px] text-light-slate/50 font-bold tracking-widest flex justify-between pt-1 border-t border-white/5"><span>TARGET: CAT_GENERATOR_SOP</span><i class="fas fa-arrow-right text-[#F97316]/0 group-hover:text-[#F97316] transition-all"></i></div>
                                    <div class="text-[#F97316] font-mono text-[11px]">"Oil pressure sensor baseline specs"</div>
                                </button>
                                <button type="button" onclick="injectHistoryQuery('HVAC_SYSTEM_X', 'Compressor thermal overload triggers', 'Page 89 // Diagram B')" class="history-sample group p-4 bg-[#0a0d12] border border-white/10 hover:border-[#F97316]/50 rounded-lg transition-all text-xs flex flex-col gap-2 relative overflow-hidden cursor-pointer">
                                    <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-[8px] text-slate-500 uppercase tracking-wider font-semibold">
                                        <span>Operator: Night Crew</span>
                                        <span>Timestamp: Yesterday, 22:48</span>
                                        <span class="col-span-2 text-[#22C55E]/80">AI Confidence: 99%</span>
                                    </div>
                                    <div class="text-[9px] text-light-slate/50 font-bold tracking-widest flex justify-between pt-1 border-t border-white/5"><span>TARGET: HVAC_SYSTEM_X</span><i class="fas fa-arrow-right text-[#F97316]/0 group-hover:text-[#F97316] transition-all"></i></div>
                                    <div class="text-[#F97316] font-mono text-[11px]">"Compressor thermal overload triggers"</div>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Active Feed Table (Hidden initially) -->
                    <div id="history-active-state" class="hidden">
                        <div class="border border-white/10 rounded-xl overflow-hidden bg-[#0a0d12] text-xs shadow-[0_0_30px_rgba(249,115,22,0.05)]">
                            <table class="w-full text-left">
                                <thead>
                                    <tr class="bg-white/5 border-b border-white/10 text-[9px] text-light-slate tracking-widest uppercase">
                                        <th class="p-4 font-normal">Timestamp</th>
                                        <th class="p-4 font-normal">Ingested Target</th>
                                        <th class="p-4 font-normal w-1/3">Vector Query Field</th>
                                        <th class="p-4 font-normal">Response Match</th>
                                        <th class="p-4 font-normal text-right">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="history-table-body" class="divide-y divide-white/5">
                                    <!-- Injected via JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Help Center View -->
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="help-view" class="dashboard-view hidden flex-1 overflow-y-auto p-6">
                <div class="max-w-5xl mx-auto">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-2xl font-bold">Help Center</h2>
                            <p class="text-sm text-light-slate mt-1">Documentation, guides, and support resources</p>
                        </div>
                        <button onclick="showView('chat')" class="px-3 py-1.5 bg-white/5 border border-white/20 rounded text-sm hover:bg-white/10 transition">
                            <i class="fas fa-arrow-left mr-1"></i>Back to Console
                        </button>
                    </div>
                    
                    <!-- Search Help -->
                    <div class="panel-section p-4 mb-6">
                        <div class="relative">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-light-slate"></i>
                            <input type="text" placeholder="Search documentation, FAQs, or guides..." class="form-input w-full pl-10" id="help-search">
                        </div>
                    </div>
                    
                    <!-- Quick Links Grid -->
                    <div class="grid grid-cols-4 gap-4 mb-6">
                        <button onclick="showHelpGuide('getting-started')" class="panel-section p-4 text-left hover:border-[#F97316]/30 hover:bg-[#F97316]/5 transition-all cursor-pointer">
                            <div class="w-10 h-10 rounded-lg bg-[#F97316]/10 flex items-center justify-center mb-3">
                                <i class="fas fa-rocket text-[#F97316]"></i>
                            </div>
                            <h4 class="font-medium text-sm mb-1">Getting Started</h4>
                            <p class="text-xs text-light-slate">5 steps • 2 min read</p>
                        </button>
                        <button onclick="showHelpGuide('manuals')" class="panel-section p-4 text-left hover:border-[#22C55E]/30 hover:bg-[#22C55E]/5 transition-all cursor-pointer">
                            <div class="w-10 h-10 rounded-lg bg-[#22C55E]/10 flex items-center justify-center mb-3">
                                <i class="fas fa-book text-[#22C55E]"></i>
                            </div>
                            <h4 class="font-medium text-sm mb-1">Manuals Guide</h4>
                            <p class="text-xs text-light-slate">Upload & manage docs</p>
                        </button>
                        <button onclick="showHelpGuide('ai-queries')" class="panel-section p-4 text-left hover:border-[#06B6D4]/30 hover:bg-[#06B6D4]/5 transition-all cursor-pointer">
                            <div class="w-10 h-10 rounded-lg bg-[#06B6D4]/10 flex items-center justify-center mb-3">
                                <i class="fas fa-brain text-[#06B6D4]"></i>
                            </div>
                            <h4 class="font-medium text-sm mb-1">AI Queries</h4>
                            <p class="text-xs text-light-slate">6 tips for better results</p>
                        </button>
                        <button onclick="showHelpGuide('troubleshooting')" class="panel-section p-4 text-left hover:border-[#FACC15]/30 hover:bg-[#FACC15]/5 transition-all cursor-pointer">
                            <div class="w-10 h-10 rounded-lg bg-[#FACC15]/10 flex items-center justify-center mb-3">
                                <i class="fas fa-wrench text-[#FACC15]"></i>
                            </div>
                            <h4 class="font-medium text-sm mb-1">Troubleshooting</h4>
                            <p class="text-xs text-light-slate">Common issues & fixes</p>
                        </button>
                    </div>
                    
                    <!-- Documentation Sections -->
                    <div class="grid grid-cols-2 gap-6">
                        <!-- FAQs -->
                        <div class="panel-section p-4">
                            <h4 class="font-medium mb-4 flex items-center gap-2">
                                <i class="fas fa-question-circle text-[#F97316]"></i>
                                Frequently Asked Questions
                            </h4>
                            <div class="space-y-3">
                                <details class="group">
                                    <summary class="flex items-center justify-between cursor-pointer text-sm hover:text-white transition">
                                        <span>What file types are supported?</span>
                                        <i class="fas fa-chevron-down text-xs text-light-slate group-open:rotate-180 transition"></i>
                                    </summary>
                                    <p class="text-xs text-light-slate mt-2 pl-4 border-l-2 border-[#F97316]/30">
                                        IndexField supports PDF files up to 100MB. The system automatically extracts text, tables, and diagrams for AI processing.
                                    </p>
                                </details>
                                <details class="group">
                                    <summary class="flex items-center justify-between cursor-pointer text-sm hover:text-white transition">
                                        <span>How does the Skeleton Index work?</span>
                                        <i class="fas fa-chevron-down text-xs text-light-slate group-open:rotate-180 transition"></i>
                                    </summary>
                                    <p class="text-xs text-light-slate mt-2 pl-4 border-l-2 border-[#F97316]/30">
                                        Our proprietary Skeleton Extraction system analyzes document structure, cross-references sections, and builds a semantic index for precise retrieval.
                                    </p>
                                </details>
                                <details class="group">
                                    <summary class="flex items-center justify-between cursor-pointer text-sm hover:text-white transition">
                                        <span>Is my data secure?</span>
                                        <i class="fas fa-chevron-down text-xs text-light-slate group-open:rotate-180 transition"></i>
                                    </summary>
                                    <p class="text-xs text-light-slate mt-2 pl-4 border-l-2 border-[#F97316]/30">
                                        Yes. All data is encrypted at rest (AES-256) and in transit (TLS 1.3). On-prem deployments keep data within your network.
                                    </p>
                                </details>
                                <details class="group">
                                    <summary class="flex items-center justify-between cursor-pointer text-sm hover:text-white transition">
                                        <span>Can I integrate with my CMMS?</span>
                                        <i class="fas fa-chevron-down text-xs text-light-slate group-open:rotate-180 transition"></i>
                                    </summary>
                                    <p class="text-xs text-light-slate mt-2 pl-4 border-l-2 border-[#F97316]/30">
                                        Yes. IndexField supports integrations with SAP PM, IBM Maximo, and other maintenance systems via API or webhook.
                                    </p>
                                </details>
                            </div>
                        </div>
                        
                        <!-- Interactive Guides -->
                        <div class="panel-section p-4">
                            <h4 class="font-medium mb-4 flex items-center gap-2">
                                <i class="fas fa-book-open text-[#22C55E]"></i>
                                Interactive Guides
                            </h4>
                            <p class="text-xs text-light-slate mb-3">Click any guide to get step-by-step instructions</p>
                            <div class="space-y-2">
                                <button onclick="showHelpGuide('getting-started')" class="w-full flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-[#F97316]/10 hover:border-[#F97316]/30 border border-transparent transition-all text-left">
                                    <div class="w-8 h-8 rounded bg-[#F97316]/20 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-rocket text-xs text-[#F97316]"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium">Getting Started</p>
                                        <p class="text-xs text-light-slate truncate">5 steps • 2 min read</p>
                                    </div>
                                    <i class="fas fa-chevron-right text-xs text-light-slate/50"></i>
                                </button>
                                <button onclick="showHelpGuide('manuals')" class="w-full flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-[#22C55E]/10 hover:border-[#22C55E]/30 border border-transparent transition-all text-left">
                                    <div class="w-8 h-8 rounded bg-[#22C55E]/20 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-file-upload text-xs text-[#22C55E]"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium">Manuals Guide</p>
                                        <p class="text-xs text-light-slate truncate">4 steps • Upload & manage docs</p>
                                    </div>
                                    <i class="fas fa-chevron-right text-xs text-light-slate/50"></i>
                                </button>
                                <button onclick="showHelpGuide('ai-queries')" class="w-full flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-[#06B6D4]/10 hover:border-[#06B6D4]/30 border border-transparent transition-all text-left">
                                    <div class="w-8 h-8 rounded bg-[#06B6D4]/20 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-search text-xs text-[#06B6D4]"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium">AI Query Tips</p>
                                        <p class="text-xs text-light-slate truncate">6 tips • Get better answers</p>
                                    </div>
                                    <i class="fas fa-chevron-right text-xs text-light-slate/50"></i>
                                </button>
                                <button onclick="showHelpGuide('troubleshooting')" class="w-full flex items-center gap-3 p-3 bg-white/5 rounded-lg hover:bg-[#FACC15]/10 hover:border-[#FACC15]/30 border border-transparent transition-all text-left">
                                    <div class="w-8 h-8 rounded bg-[#FACC15]/20 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-wrench text-xs text-[#FACC15]"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium">Troubleshooting</p>
                                        <p class="text-xs text-light-slate truncate">Common issues & quick fixes</p>
                                    </div>
                                    <i class="fas fa-chevron-right text-xs text-light-slate/50"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Contact Support -->
                    <div class="panel-section p-4 mt-6">
                        <h4 class="font-medium mb-4 flex items-center gap-2">
                            <i class="fas fa-headset text-[#06B6D4]"></i>
                            Contact Support
                        </h4>
                        <div class="grid grid-cols-3 gap-4">
                            <div class="data-surface p-3 rounded text-center">
                                <i class="fas fa-envelope text-[#F97316] text-xl mb-2"></i>
                                <p class="text-sm font-medium">Email Support</p>
                                <p class="text-xs text-light-slate">support@indexfield.io</p>
                                <p class="text-[10px] text-[#22C55E] mt-1">Enterprise: 24h SLA</p>
                            </div>
                            <div class="data-surface p-3 rounded text-center">
                                <i class="fas fa-comments text-[#22C55E] text-xl mb-2"></i>
                                <p class="text-sm font-medium">Live Chat</p>
                                <p class="text-xs text-light-slate">Available 9am-6pm EST</p>
                                <p class="text-[10px] text-[#22C55E] mt-1">Enterprise: Priority</p>
                            </div>
                            <div class="data-surface p-3 rounded text-center">
                                <i class="fas fa-phone text-[#06B6D4] text-xl mb-2"></i>
                                <p class="text-sm font-medium">Phone Support</p>
                                <p class="text-xs text-light-slate">+1 (555) 123-4567</p>
                                <p class="text-[10px] text-[#22C55E] mt-1">Enterprise: Direct line</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Guide Content Pages (Hidden by default) -->
                    <div id="guide-content" class="hidden panel-section p-6 mt-6">
                        <div class="flex items-center justify-between mb-6">
                            <button onclick="backToHelpCenter()" class="flex items-center gap-2 text-sm text-light-slate hover:text-white transition">
                                <i class="fas fa-arrow-left"></i>
                                Back to Help Center
                            </button>
                            <span class="text-xs text-light-slate px-2 py-1 bg-white/5 rounded" id="guide-progress">Step 1 of 5</span>
                        </div>
                        
                        <div id="guide-getting-started" class="guide-page hidden">
                            <h3 class="text-xl font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-rocket text-[#F97316]"></i>
                                Getting Started with IndexField
                            </h3>
                            <p class="text-sm text-light-slate mb-6">Follow these 5 steps to get up and running in minutes</p>
                            
                            <div class="space-y-4">
                                <div class="flex gap-4 p-4 bg-white/5 rounded-lg border-l-2 border-[#F97316]">
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-[#F97316] flex items-center justify-center text-sm font-bold">1</div>
                                    <div>
                                        <h4 class="font-medium mb-1">Upload Your First Manual</h4>
                                        <p class="text-sm text-light-slate mb-2">Use the Manuals area to add your first document (PDF, TXT, CSV, or DOCX up to 100MB).</p>
                                        <button onclick="showUploadModal(); backToHelpCenter();" class="px-3 py-1.5 bg-[#F97316]/10 border border-[#F97316]/30 rounded text-xs text-[#F97316] hover:bg-[#F97316]/20 transition">
                                            <i class="fas fa-upload mr-1"></i>Try it now
                                        </button>
                                    </div>
                                </div>
                                <div class="flex gap-4 p-4 bg-white/5 rounded-lg border-l-2 border-white/20">
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-sm font-bold">2</div>
                                    <div>
                                        <h4 class="font-medium mb-1">Wait for Processing</h4>
                                        <p class="text-sm text-light-slate">The Skeleton Extraction system will analyze your document structure, tables, and cross-references. This takes 30-60 seconds per manual.</p>
                                    </div>
                                </div>
                                <div class="flex gap-4 p-4 bg-white/5 rounded-lg border-l-2 border-white/20">
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-sm font-bold">3</div>
                                    <div>
                                        <h4 class="font-medium mb-1">Ask Your First Question</h4>
                                        <p class="text-sm text-light-slate mb-2">Type a specific question about your equipment in the chat box. Try asking about error codes, torque specs, or procedures.</p>
                                        <div class="flex gap-2">
                                            <button onclick="setQuery('What is the torque spec for bearing 6205?'); backToHelpCenter(); showView('chat');" class="px-2 py-1 bg-white/10 rounded text-xs hover:bg-white/20 transition">Example: Torque spec</button>
                                            <button onclick="setQuery('How do I reset error code E-402?'); backToHelpCenter(); showView('chat');" class="px-2 py-1 bg-white/10 rounded text-xs hover:bg-white/20 transition">Example: Error code</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex gap-4 p-4 bg-white/5 rounded-lg border-l-2 border-white/20">
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-sm font-bold">4</div>
                                    <div>
                                        <h4 class="font-medium mb-1">Review Source Citations</h4>
                                        <p class="text-sm text-light-slate">Every AI response includes citations. Click them to see the exact source page and verify the information.</p>
                                    </div>
                                </div>
                                <div class="flex gap-4 p-4 bg-white/5 rounded-lg border-l-2 border-white/20">
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-sm font-bold">5</div>
                                    <div>
                                        <h4 class="font-medium mb-1">Add Team Members</h4>
                                        <p class="text-sm text-light-slate mb-2">Invite technicians to access the knowledge base. Go to Settings → Team to manage permissions.</p>
                                        <button onclick="showSettings('team'); backToHelpCenter();" class="px-3 py-1.5 bg-white/10 border border-white/20 rounded text-xs hover:bg-white/20 transition">
                                            <i class="fas fa-users mr-1"></i>Open Team Settings
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div id="guide-manuals" class="guide-page hidden">
                            <h3 class="text-xl font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-book text-[#22C55E]"></i>
                                Manuals Guide
                            </h3>
                            <p class="text-sm text-light-slate mb-6">How to upload, manage, and organize your technical documentation</p>
                            
                            <div class="space-y-4">
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 flex items-center gap-2">
                                        <i class="fas fa-upload text-[#22C55E]"></i>
                                        Upload Best Practices
                                    </h4>
                                    <ul class="text-sm text-light-slate space-y-2 list-disc list-inside">
                                        <li>Use original PDFs (not scanned images) for best text extraction</li>
                                        <li>Maximum file size: 100MB per manual</li>
                                        <li>Supported: PDFs with embedded text (not image-only)</li>
                                        <li>Split large multi-equipment manuals into separate files</li>
                                    </ul>
                                </div>
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 flex items-center gap-2">
                                        <i class="fas fa-cogs text-[#06B6D4]"></i>
                                        Skeleton Extraction Explained
                                    </h4>
                                    <p class="text-sm text-light-slate mb-2">Our system automatically extracts:</p>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div class="flex items-center gap-2 text-sm text-light-slate"><i class="fas fa-check text-[#22C55E] text-xs"></i>Table of contents</div>
                                        <div class="flex items-center gap-2 text-sm text-light-slate"><i class="fas fa-check text-[#22C55E] text-xs"></i>Diagram references</div>
                                        <div class="flex items-center gap-2 text-sm text-light-slate"><i class="fas fa-check text-[#22C55E] text-xs"></i>Error code tables</div>
                                        <div class="flex items-center gap-2 text-sm text-light-slate"><i class="fas fa-check text-[#22C55E] text-xs"></i>Torque specifications</div>
                                        <div class="flex items-center gap-2 text-sm text-light-slate"><i class="fas fa-check text-[#22C55E] text-xs"></i>Procedures & steps</div>
                                        <div class="flex items-center gap-2 text-sm text-light-slate"><i class="fas fa-check text-[#22C55E] text-xs"></i>Parts lists</div>
                                    </div>
                                </div>
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 flex items-center gap-2">
                                        <i class="fas fa-tags text-[#F97316]"></i>
                                        Manual Organization
                                    </h4>
                                    <p class="text-sm text-light-slate">The system automatically categorizes by:</p>
                                    <ul class="text-sm text-light-slate space-y-1 list-disc list-inside mt-2">
                                        <li>Equipment type (Pump, HVAC, Motor, etc.)</li>
                                        <li>Manufacturer</li>
                                        <li>Document version</li>
                                        <li>Indexed date</li>
                                    </ul>
                                </div>
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 flex items-center gap-2">
                                        <i class="fas fa-sync text-[#FACC15]"></i>
                                        Updating Manuals
                                    </h4>
                                    <p class="text-sm text-light-slate">Upload a new version with the same filename to replace. The system will re-index while preserving your query history.</p>
                                </div>
                            </div>
                        </div>
                        
                        <div id="guide-ai-queries" class="guide-page hidden">
                            <h3 class="text-xl font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-brain text-[#06B6D4]"></i>
                                AI Query Tips
                            </h3>
                            <p class="text-sm text-light-slate mb-6">Get more accurate answers with these techniques</p>
                            
                            <div class="grid grid-cols-2 gap-4">
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 text-[#F97316]">1. Be Specific</h4>
                                    <p class="text-xs text-light-slate mb-2">❌ "Tell me about the pump"</p>
                                    <p class="text-xs text-[#22C55E] mb-2">✓ "What is the maximum operating pressure for pump P-101?"</p>
                                    <button onclick="setQuery('What is the maximum operating pressure for pump P-101?'); backToHelpCenter(); showView('chat');" class="px-2 py-1 bg-[#22C55E]/10 rounded text-xs text-[#22C55E] hover:bg-[#22C55E]/20 transition">Try this query</button>
                                </div>
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 text-[#F97316]">2. Use Part Numbers</h4>
                                    <p class="text-xs text-light-slate mb-2">❌ "Bearing specs"</p>
                                    <p class="text-xs text-[#22C55E] mb-2">✓ "Torque spec for bearing 6205-ZZ"</p>
                                    <button onclick="setQuery('Torque spec for bearing 6205-ZZ'); backToHelpCenter(); showView('chat');" class="px-2 py-1 bg-[#22C55E]/10 rounded text-xs text-[#22C55E] hover:bg-[#22C55E]/20 transition">Try this query</button>
                                </div>
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 text-[#F97316]">3. Include Error Codes</h4>
                                    <p class="text-xs text-light-slate mb-2">❌ "It's not working"</p>
                                    <p class="text-xs text-[#22C55E] mb-2">✓ "What does error code E-402 indicate?"</p>
                                    <button onclick="setQuery('What does error code E-402 indicate?'); backToHelpCenter(); showView('chat');" class="px-2 py-1 bg-[#22C55E]/10 rounded text-xs text-[#22C55E] hover:bg-[#22C55E]/20 transition">Try this query</button>
                                </div>
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 text-[#F97316]">4. Ask for Procedures</h4>
                                    <p class="text-xs text-light-slate mb-2">❌ "Filter replacement"</p>
                                    <p class="text-xs text-[#22C55E] mb-2">✓ "Step-by-step procedure for HVAC-301 filter replacement"</p>
                                    <button onclick="setQuery('Step-by-step procedure for HVAC-301 filter replacement'); backToHelpCenter(); showView('chat');" class="px-2 py-1 bg-[#22C55E]/10 rounded text-xs text-[#22C55E] hover:bg-[#22C55E]/20 transition">Try this query</button>
                                </div>
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 text-[#F97316]">5. Request Diagrams</h4>
                                    <p class="text-xs text-light-slate mb-2">❌ "Show wiring"</p>
                                    <p class="text-xs text-[#22C55E] mb-2">✓ "Wiring diagram for pump P-101 control circuit"</p>
                                    <button onclick="setQuery('Wiring diagram for pump P-101 control circuit'); backToHelpCenter(); showView('chat');" class="px-2 py-1 bg-[#22C55E]/10 rounded text-xs text-[#22C55E] hover:bg-[#22C55E]/20 transition">Try this query</button>
                                </div>
                                <div class="p-4 bg-white/5 rounded-lg">
                                    <h4 class="font-medium mb-2 text-[#F97316]">6. Use Context</h4>
                                    <p class="text-xs text-light-slate mb-2">Paste large text (500+ chars) directly into chat</p>
                                    <p class="text-xs text-[#22C55E]">The AI will analyze it as temporary context</p>
                                </div>
                            </div>
                        </div>
                        
                        <div id="guide-troubleshooting" class="guide-page hidden">
                            <h3 class="text-xl font-semibold mb-2 flex items-center gap-2">
                                <i class="fas fa-wrench text-[#FACC15]"></i>
                                Troubleshooting
                            </h3>
                            <p class="text-sm text-light-slate mb-6">Common issues and quick fixes</p>
                            
                            <div class="space-y-4">
                                <details class="group p-4 bg-white/5 rounded-lg">
                                    <summary class="flex items-center justify-between cursor-pointer">
                                        <div class="flex items-center gap-3">
                                            <i class="fas fa-exclamation-triangle text-[#FACC15]"></i>
                                            <span class="font-medium">Manual upload failed</span>
                                        </div>
                                        <i class="fas fa-chevron-down text-xs text-light-slate group-open:rotate-180 transition"></i>
                                    </summary>
                                    <div class="mt-3 pl-8 text-sm text-light-slate space-y-2">
                                        <p><strong class="text-white">Problem:</strong> PDF won't upload or process</p>
                                        <p><strong class="text-white">Solutions:</strong></p>
                                        <ul class="list-disc list-inside space-y-1">
                                            <li>Check file size (max 100MB)</li>
                                            <li>Ensure PDF has embedded text (not scanned images)</li>
                                            <li>Try reducing PDF quality if too large</li>
                                            <li>Check System Status for maintenance</li>
                                        </ul>
                                    </div>
                                </details>
                                <details class="group p-4 bg-white/5 rounded-lg">
                                    <summary class="flex items-center justify-between cursor-pointer">
                                        <div class="flex items-center gap-3">
                                            <i class="fas fa-search text-[#FACC15]"></i>
                                            <span class="font-medium">AI can't find my manual</span>
                                        </div>
                                        <i class="fas fa-chevron-down text-xs text-light-slate group-open:rotate-180 transition"></i>
                                    </summary>
                                    <div class="mt-3 pl-8 text-sm text-light-slate space-y-2">
                                        <p><strong class="text-white">Problem:</strong> Queries return "No relevant context found"</p>
                                        <p><strong class="text-white">Solutions:</strong></p>
                                        <ul class="list-disc list-inside space-y-1">
                                            <li>Verify manual status shows "Indexed" not "Processing"</li>
                                            <li>Wait 60 seconds after upload for processing</li>
                                            <li>Check if query uses terms from the manual</li>
                                            <li>Try re-uploading the PDF</li>
                                        </ul>
                                    </div>
                                </details>
                                <details class="group p-4 bg-white/5 rounded-lg">
                                    <summary class="flex items-center justify-between cursor-pointer">
                                        <div class="flex items-center gap-3">
                                            <i class="fas fa-bolt text-[#FACC15]"></i>
                                            <span class="font-medium">Slow response times</span>
                                        </div>
                                        <i class="fas fa-chevron-down text-xs text-light-slate group-open:rotate-180 transition"></i>
                                    </summary>
                                    <div class="mt-3 pl-8 text-sm text-light-slate space-y-2">
                                        <p><strong class="text-white">Problem:</strong> AI responses taking longer than 10 seconds</p>
                                        <p><strong class="text-white">Solutions:</strong></p>
                                        <ul class="list-disc list-inside space-y-1">
                                            <li>Check System Status for LLM connectivity</li>
                                            <li>Switch to Ollama on-prem for faster local queries</li>
                                            <li>Reduce query complexity (shorter, more specific)</li>
                                            <li>Check network connection</li>
                                        </ul>
                                    </div>
                                </details>
                                <details class="group p-4 bg-white/5 rounded-lg">
                                    <summary class="flex items-center justify-between cursor-pointer">
                                        <div class="flex items-center gap-3">
                                            <i class="fas fa-lock text-[#FACC15]"></i>
                                            <span class="font-medium">Login or access issues</span>
                                        </div>
                                        <i class="fas fa-chevron-down text-xs text-light-slate group-open:rotate-180 transition"></i>
                                    </summary>
                                    <div class="mt-3 pl-8 text-sm text-light-slate space-y-2">
                                        <p><strong class="text-white">Problem:</strong> Can't access dashboard or features</p>
                                        <p><strong class="text-white">Solutions:</strong></p>
                                        <ul class="list-disc list-inside space-y-1">
                                            <li>Clear browser cache and reload</li>
                                            <li>Verify user role has required permissions</li>
                                            <li>Check if Enterprise license is active</li>
                                            <li>Contact support with error message</li>
                                        </ul>
                                    </div>
                                </details>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Release Notes -->
                    <div class="panel-section p-4 mt-6">
                        <h4 class="font-medium mb-4 flex items-center gap-2">
                            <i class="fas fa-code-branch text-[#FACC15]"></i>
                            Recent Updates
                        </h4>
                        <div class="space-y-3">
                            <div class="flex items-start gap-3">
                                <span class="px-2 py-1 bg-[#F97316]/10 text-[#F97316] rounded text-[10px] font-medium">v3.2.0</span>
                                <div>
                                    <p class="text-sm font-medium">Enhanced Skeleton Extraction</p>
                                    <p class="text-xs text-light-slate">Improved table of contents parsing and cross-reference detection for technical manuals.</p>
                                    <p class="text-[10px] text-light-slate/50 mt-1">Released 2 days ago</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="px-2 py-1 bg-[#22C55E]/10 text-[#22C55E] rounded text-[10px] font-medium">v3.1.5</span>
                                <div>
                                    <p class="text-sm font-medium">Team Collaboration Features</p>
                                    <p class="text-xs text-light-slate">Added verified notes, field knowledge sharing, and role-based access controls.</p>
                                    <p class="text-[10px] text-light-slate/50 mt-1">Released 2 weeks ago</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <span class="px-2 py-1 bg-[#06B6D4]/10 text-[#06B6D4] rounded text-[10px] font-medium">v3.1.0</span>
                                <div>
                                    <p class="text-sm font-medium">Ollama Integration</p>
                                    <p class="text-xs text-light-slate">Added support for on-premise LLM deployment with Ollama for complete data sovereignty.</p>
                                    <p class="text-[10px] text-light-slate/50 mt-1">Released 1 month ago</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Manuals View -->
            
{% endblock %}
{% extends "base.html" %}
{% block content %}
<div id="manuals-view" class="dashboard-view hidden flex-1 overflow-y-auto p-6">
                <div class="max-w-7xl mx-auto">
                    <!-- Header -->
                    <div class="mb-8">
                        <h1 class="text-3xl font-bold text-white mb-2">Manuals</h1>
                        <p class="text-base text-slate-300">Upload, manage, and review active machinery documentation across your plant.</p>
                    </div>

                    <!-- Two-Column Interface -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8 items-stretch">
                        <!-- Left Column: Upload Zone -->
                        <div class="glass-card rounded-xl p-6 h-full">
                            <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                                <i class="fas fa-plus-circle text-[#F97316]"></i>
                                Add New Documentation
                            </h2>
                            
                            <!-- Upload Box -->
                            <div id="manuals-upload-zone" class="border-2 border-dashed border-[#F97316] rounded-lg p-8 text-center bg-[#F97316]/5 hover:bg-[#F97316]/10 transition-all cursor-pointer" onclick="document.getElementById('upload-input').click()">
                                <div class="flex flex-col items-center justify-center gap-4">
                                    <p class="text-sm font-medium text-white/90">Drag & drop your manuals here</p>
                                    <button type="button" class="px-6 py-3 bg-[#F97316] text-white font-semibold rounded-lg hover:bg-[#EA580C] transition-all shadow-lg flex items-center gap-2" onclick="event.stopPropagation(); document.getElementById('upload-input').click()">
                                        <i class="fas fa-folder-open"></i>
                                        Browse Local Files
                                    </button>
                                    <p class="text-sm text-slate-300">
                                        PDF, TXT, CSV, or DOCX — industrial documentation only
                                    </p>
                                </div>
                            </div>

                            <!-- Demo Banner -->
                            <div class="mt-4 p-4 bg-white/5 rounded-lg border border-white/10">
                                <p class="text-sm text-slate-300 flex items-center gap-2">
                                    <span class="text-lg">💡</span>
                                    Want to try it out first? 
                                    <button type="button" onclick="loadSamplePumpManual()" class="text-[#F97316] font-semibold hover:underline ml-1">
                                        Try a Sample Pump Manual
                                    </button>
                                </p>
                            </div>
                        </div>

                        <!-- Right Column: System Metrics -->
                        <div class="glass-card rounded-xl p-6 h-full">
                            <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                                <i class="fas fa-tachometer-alt text-[#F97316]"></i>
                                Scanner Engine Status
                            </h2>
                            
                            <div class="space-y-4">
                                <!-- System Status -->
                                <div class="flex items-center justify-between p-4 bg-white/5 rounded-lg border border-white/10">
                                    <span class="text-sm text-slate-300">System Status:</span>
                                    <div class="flex items-center gap-2">
                                        <span class="w-3 h-3 rounded-full status-dot status-idle"></span>
                                        <span class="text-sm font-medium text-white">Ready / Waiting for File</span>
                                    </div>
                                </div>

                                <!-- AI Engine -->
                                <div class="flex items-center justify-between p-4 bg-white/5 rounded-lg border border-white/10">
                                    <span class="text-sm text-slate-300">AI Engine:</span>
                                    <span id="manuals-ai-engine-status" class="text-sm font-medium text-[#22C55E]">Online & Ready</span>
                                </div>

                                <!-- Document Scanner -->
                                <div class="flex items-center justify-between p-4 bg-white/5 rounded-lg border border-white/10">
                                    <span class="text-sm text-slate-300">Document Scanner:</span>
                                    <span id="manuals-scanner-status" class="text-sm font-medium text-white">Ready to read text & tables</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Full-Width Bottom Section: Active Plant Documentation -->
                    <div class="glass-card rounded-xl p-6">
                        <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                            <i class="fas fa-folder text-[#F97316]"></i>
                            Active Plant Documentation
                        </h2>
                        
                        <!-- Data Table -->
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-white/10">
                                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Document Name</th>
                                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Pages</th>
                                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Uploaded By</th>
                                        <th class="text-left py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="manuals-table-body" class="divide-y divide-white/5">
                                    <tr>
                                        <td colspan="4" class="py-16 px-4 text-center text-sm text-slate-300 font-medium">
                                            <div class="max-w-xl mx-auto space-y-3">
                                                <p class="text-lg font-semibold text-white">📂 No manuals uploaded yet</p>
                                                <p class="text-sm text-slate-400">Your processed plant documentation, page counts, and indexing status will appear here once you add your first file.</p>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

{% endblock %}
        </main>
    </div>
    
    <!-- First-Time Onboarding Wizard -->
    <div id="onboarding-wizard" class="hidden fixed inset-0 z-[100] bg-black flex items-center justify-center p-6">
        <div class="max-w-2xl w-full glass-card rounded-3xl border-[#F97316]/20 relative overflow-hidden">
            <div id="onboarding-progress" class="absolute top-0 left-0 h-1 bg-[#F97316] transition-all duration-500" style="width: 33%"></div>
            
            <div class="p-8">
                <div class="flex items-center gap-2 mb-6">
                    <i class="fas fa-terminal text-[#F97316]"></i>
                    <span class="text-xs font-mono text-light-slate">SYSTEM INITIALIZATION</span>
                </div>
                
                <div id="step-content" class="space-y-6">
                    <!-- Step content injected by JS -->
                </div>
            </div>
        </div>
    </div>
    
    <input type="file" id="upload-input" accept=".pdf,.txt,.csv,.docx,application/pdf,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document" multiple class="hidden" onchange="handleBatchUpload(this)">

    <div id="upload-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md">
        <div class="source-modal w-[70vw] max-w-6xl mx-4 rounded-xl overflow-hidden flex flex-col font-mono text-white border border-[#F97316]/40 shadow-[0_0_80px_rgba(249,115,22,0.25)]">
            <!-- Authoritative Header with Security Badge -->
            <div class="p-5 border-b border-[#F97316]/30 bg-[#0a0d12] flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-industry text-[#F97316] text-lg"></i>
                        <h3 class="text-xs font-bold tracking-[0.2em] uppercase text-white">DATA INGESTION & PIPELINE CONFIGURATION</h3>
                    </div>
                    <!-- Air-Gapped Security Badge -->
                    <div class="flex items-center gap-2 px-3 py-1.5 bg-[#22C55E]/10 border border-[#22C55E]/30 rounded-full ml-4">
                        <i class="fas fa-lock text-[#22C55E] text-xs"></i>
                        <span class="text-[10px] font-bold tracking-wider uppercase text-[#22C55E]">AIR-GAPPED COMPLIANT: Zero Data Exfiltration</span>
                    </div>
                </div>
                <button onclick="hideUploadModal()" class="text-[#F97316]/60 hover:text-[#F97316] transition-all hover:bg-white/5 p-2 rounded"><i class="fas fa-times"></i></button>
            </div>

            <div class="flex flex-col lg:flex-row bg-[#0a0d12] h-[600px]">
                <!-- Left Column: Input Configuration -->
                <div class="flex-1 p-6 border-r border-white/5 flex flex-col">
                    <!-- Main Drop Zone -->
                    <div class="relative overflow-hidden border-2 border-dashed border-[#F97316]/40 rounded-lg bg-[#F97316]/5 p-8 text-center cursor-pointer group hover:border-[#F97316]/70 transition-all flex flex-col items-center justify-center min-h-[180px]" onclick="document.getElementById('upload-input').click()">
                        <i class="fas fa-cloud-upload-alt text-4xl text-[#F97316]/70 mb-4 group-hover:scale-110 transition-transform"></i>
                        <p class="text-xs text-[#F97316] mb-2 font-bold tracking-widest">DROP FILES OR CLICK TO BROWSE</p>
                        <p class="text-[10px] text-white/40 mb-4 tracking-wide">PDF, TXT, CSV, DOCX — Batch Processing Enabled</p>
                        <button class="px-6 py-2.5 bg-white/5 border border-white/20 text-white/70 hover:text-white hover:border-white/40 rounded text-[11px] font-semibold tracking-wide transition-all">
                            <i class="fas fa-folder-open mr-2"></i>SELECT FILES
                        </button>
                    </div>

                    <!-- Asset Tagging Section -->
                    <div class="mt-6 grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[9px] font-bold uppercase tracking-wider text-white/50 mb-2 block">Plant Zone</label>
                            <select id="plant-zone-select" class="w-full bg-[#1a2233] border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-[#F97316]/50 focus:outline-none">
                                <option value="">Select Zone...</option>
                                <option value="sector-4">Sector 4</option>
                                <option value="boiler-room">Boiler Room</option>
                                <option value="turbine-hall">Turbine Hall</option>
                                <option value="control-room">Control Room</option>
                                <option value="maintenance-bay">Maintenance Bay</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-[9px] font-bold uppercase tracking-wider text-white/50 mb-2 block">Asset Category</label>
                            <select id="asset-category-select" class="w-full bg-[#1a2233] border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:border-[#F97316]/50 focus:outline-none">
                                <option value="">Select Category...</option>
                                <option value="pumps">Pumps</option>
                                <option value="hvac">HVAC</option>
                                <option value="electrical">Electrical</option>
                                <option value="mechanical">Mechanical</option>
                                <option value="instrumentation">Instrumentation</option>
                            </select>
                        </div>
                    </div>

                    <!-- Parser Configuration -->
                    <div class="mt-6 border border-white/10 rounded-lg p-4 bg-white/5">
                        <p class="text-[9px] font-bold uppercase tracking-wider text-white/50 mb-3">PARSER CONFIGURATION</p>
                        <div class="grid grid-cols-1 gap-3">
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" checked class="w-4 h-4 rounded border-white/20 bg-white/5 text-[#F97316] focus:ring-[#F97316]/50">
                                <span class="text-xs text-white/80 group-hover:text-white transition">Extract Maintenance Schedules</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" checked class="w-4 h-4 rounded border-white/20 bg-white/5 text-[#F97316] focus:ring-[#F97316]/50">
                                <span class="text-xs text-white/80 group-hover:text-white transition">Isolate Fault Codes</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-white/20 bg-white/5 text-[#F97316] focus:ring-[#F97316]/50">
                                <span class="text-xs text-white/80 group-hover:text-white transition">Extract Mechanical Schematics <span class="text-[9px] text-[#FACC15] ml-1">(Beta)</span></span>
                            </label>
                        </div>
                    </div>

                    <!-- Quick Start Link -->
                    <div class="mt-auto pt-6 border-t border-white/10">
                        <div class="flex items-center gap-3">
                            <span class="text-[10px] text-[#F97316] font-bold tracking-widest uppercase"><i class="fas fa-bolt mr-2"></i>[QUICK START]</span>
                            <button onclick="injectDemoManual('upload-modal-content')" class="text-[10px] text-white/60 hover:text-white underline decoration-white/30 hover:decoration-white transition-all tracking-wide">
                                Load Sample Centrifugal Pump Manual for Testing
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Telemetry & Processing -->
                <div class="w-[450px] flex flex-col bg-[#080a0d]">
                    <!-- Live Terminal Output -->
                    <div class="p-4 border-b border-white/10">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-[#22C55E] animate-pulse"></div>
                            <p class="text-[10px] font-bold uppercase tracking-wider text-[#22C55E]">Live Terminal Output</p>
                        </div>
                        <div id="upload-terminal" class="bg-black rounded-lg p-3 h-36 overflow-y-auto font-mono text-[10px] text-white/70 space-y-1 border border-white/10">
                            <p class="text-[#22C55E]">[SYSTEM] Pipeline initialized. Awaiting batch...</p>
                        </div>
                    </div>

                    <!-- Batch Queue -->
                    <div class="flex-1 p-4 flex flex-col min-h-0">
                        <div class="flex items-center justify-between mb-3">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-white/70">Batch Queue</p>
                            <span id="queue-count" class="text-[9px] text-[#F97316] font-bold">0 FILES QUEUED</span>
                        </div>
                        <div id="batch-queue" class="flex-1 overflow-y-auto space-y-2 min-h-[200px]">
                            <div class="text-center py-8">
                                <i class="fas fa-inbox text-2xl text-white/20 mb-2"></i>
                                <p class="text-[10px] text-white/30">No files in queue</p>
                            </div>
                        </div>
                    </div>

                    <!-- Process Batch Button -->
                    <div class="p-4 border-t border-white/10 bg-[#0a0d12]">
                        <button id="process-batch-btn" disabled class="w-full py-3 bg-[#F97316]/20 border border-[#F97316]/30 rounded-lg text-xs font-bold text-white/50 tracking-wider uppercase transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-cogs"></i>
                            Process Batch
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

                        </div>
                    </div>
                </div>
            </div>


                        </div>
                    </div>

                    </div>

                    <!-- Air-Gapped Security Badge -->
                    <div class="flex items-center gap-2 px-3 py-1.5 bg-[#22C55E]/10 border border-[#22C55E]/30 rounded-full ml-4">
                        <i class="fas fa-lock text-[#22C55E] text-xs"></i>
                        <span class="text-[10px] font-bold tracking-wider uppercase text-[#22C55E]">AIR-GAPPED COMPLIANT: Zero Data Exfiltration</span>
                    </div>
                </div>
                <button onclick="hideUploadModal()" class="text-[#F97316]/60 hover:text-[#F97316] transition-all hover:bg-white/5 p-2 rounded"><i class="fas fa-times"></i></button>
            </div>

    
    <div id="manuals-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="source-modal w-full max-w-2xl mx-4 rounded-2xl p-6 max-h-[80vh] flex flex-col">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-semibold">Manuals</h3>
                <button onclick="hideManualsModal()" class="text-light-slate hover:text-white"><i class="fas fa-times"></i></button>
            </div>
            <div id="manuals-list" class="flex-1 overflow-y-auto space-y-2"><p class="text-light-slate text-center py-8">No manuals uploaded yet</p></div>
        </div>
    </div>
    
    <div id="note-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="source-modal w-full max-w-md mx-4 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">

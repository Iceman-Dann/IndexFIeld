<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IndexField | Mission Control</title>
    <link rel="icon" href="data:,">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="supabase-config.js"></script>
    <!-- Note: In a true air-gapped deployment, this library is served locally from the node -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: {
                        // Primary
                        charcoal: '#111827',
                        graphite: '#1F2937',
                        slate: '#475569',
                        // Secondary
                        steel: '#64748B',
                        'light-slate': '#94A3B8',
                        'off-white': '#F8FAFC',
                        // Accent
                        'safety-orange': '#F97316',
                        'burnt-orange': '#EA580C',
                        // Support
                        'success-green': '#22C55E',
                        'warning-amber': '#FACC15',
                        'critical-red': '#EF4444',
                        'data-cyan': '#06B6D4',
                        // Legacy brand mapping
                        brand: {
                            bg: '#111827',
                            surface: '#1F2937',
                            card: '#1F2937',
                            border: '#374151',
                            hover: '#374151',
                            accent: '#F97316',
                            accent2: '#EA580C',
                            text: '#94A3B8',
                            textLight: '#F8FAFC',
                            verified: '#22C55E'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        * { scrollbar-width: thin; scrollbar-color: #374151 #111827; }
        body { background-color: #111827; color: #F8FAFC; overflow: hidden; }

        /* Subtle ambient only - reduced for enterprise feel */
        .ambient-glow { position: fixed; pointer-events: none; z-index: 0; }
        .glow-1 { top: -20%; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: rgba(249, 115, 22, 0.02); filter: blur(120px); border-radius: 50%; }
        .glow-2 { display: none; } /* Removed secondary glow */

        .bg-grid { position: fixed; inset: 0; z-index: 0; pointer-events: none; background-size: 60px 60px; background-image: linear-gradient(to right, rgba(148,163,184,0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(148,163,184,0.03) 1px, transparent 1px); mask-image: linear-gradient(to bottom, black 30%, transparent 100%); }

        /* Low Signal Mode overrides */
        body.low-signal-mode * {
            animation: none !important;
            transition: none !important;
            backdrop-filter: none !important;
            box-shadow: none !important;
        }
        body.low-signal-mode .ambient-glow, body.low-signal-mode .bg-grid {
            display: none !important;
        }
        body.low-signal-mode .glass-card {
            background: #1F2937 !important;
        }

        /* Panel segmentation for density */
        .glass-card { background: linear-gradient(180deg, rgba(31,41,55,0.95) 0%, rgba(24,31,46,0.98) 100%); border: 1px solid rgba(100,116,139,0.12); backdrop-filter: blur(10px); }
        .panel-header { background: rgba(17,24,39,0.6); border-bottom: 1px solid rgba(100,116,139,0.15); }
        .panel-section { background: rgba(31,41,55,0.4); border: 1px solid rgba(100,116,139,0.1); border-radius: 6px; }
        .data-surface { background: rgba(17,24,39,0.8); border: 1px solid rgba(100,116,139,0.08); }
        .glass-input { background: rgba(31,41,55,0.5); border: 1px solid rgba(100,116,139,0.25); transition: all 0.3s ease; }
        .glass-input:focus { background: rgba(31,41,55,0.7); border-color: rgba(249, 115, 22, 0.4); box-shadow: 0 0 20px rgba(249, 115, 22, 0.1); }

        .gradient-text { background: linear-gradient(135deg, #F97316 0%, #EA580C 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

        .msg-user { background: linear-gradient(135deg, rgba(249,115,22,0.12) 0%, rgba(234,88,12,0.05) 100%); border: 1px solid rgba(249,115,22,0.2); }
        .msg-ai { background: rgba(31,41,55,0.6); border: 1px solid rgba(100,116,139,0.2); position: relative; }
        .msg-ai.verified {
            background: linear-gradient(to right, rgba(34, 197, 94, 0.08), transparent 60%);
            border-left: 2px solid #22C55E !important;
        }
        .msg-ai.verified::before {
            content: 'VERIFIED';
            position: absolute;
            top: -8px;
            right: 8px;
            background: #22C55E;
            color: #fff;
            font-size: 7px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 3px;
            letter-spacing: 0.5px;
        }
        /* Subtle operational pulse - not neon */
        @keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 0 1px rgba(249, 115, 22, 0.3); } 50% { box-shadow: 0 0 0 2px rgba(249, 115, 22, 0.5); } }
        .pulse-btn { animation: pulse-glow 2s ease-in-out infinite; }

        /* Minimal status indicator */
        @keyframes status-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
        .status-pulse { animation: status-pulse 2s ease-in-out infinite; }

        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-in { animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

        /* Chart skeleton & live-ready indicators (Ops / Prognostics) */
        @keyframes chart-ready-pulse {
            0%, 100% { opacity: 0.35; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.15); }
        }
        .chart-ready-indicator {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 10px;
            font-family: 'JetBrains Mono', monospace;
            color: rgba(148, 163, 184, 0.85);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            pointer-events: none;
            z-index: 5;
        }
        .chart-ready-indicator .ready-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(34, 197, 94, 0.55);
            animation: chart-ready-pulse 2.2s ease-in-out infinite;
            box-shadow: 0 0 8px rgba(34, 197, 94, 0.35);
        }
        .chart-skeleton-axis { stroke: rgba(148, 163, 184, 0.38); stroke-width: 1; }
        .chart-skeleton-grid { stroke: rgba(148, 163, 184, 0.14); stroke-width: 0.5; }
        .chart-skeleton-tick { fill: rgba(148, 163, 184, 0.35); font-size: 9px; font-family: 'JetBrains Mono', monospace; }
        .telemetry-stream-active .chart-ready-indicator { display: none; }
        .telemetry-stream-active #oscilloscope-lines path { opacity: 1; }
        #oscilloscope-lines path { opacity: 0.15; transition: opacity 0.35s ease; }
        .prognostics-page-header { padding-bottom: 0; margin-bottom: 1.25rem; }
        .prognostics-header-utilities { margin-left: auto; justify-content: flex-end; flex-wrap: nowrap; }
        .prognostics-utility-btn {
            width: 2.25rem; height: 2.25rem; display: inline-flex; align-items: center; justify-content: center;
            border-radius: 8px; border: 1px solid rgba(100, 116, 139, 0.25); background: rgba(31, 41, 55, 0.6);
            color: #94A3B8; transition: all 0.2s ease; position: relative;
        }
        .prognostics-utility-btn:hover { color: #F8FAFC; border-color: rgba(249, 115, 22, 0.35); background: rgba(249, 115, 22, 0.08); }
        .prognostics-notif-badge {
            position: absolute; top: -4px; right: -4px; min-width: 14px; height: 14px; padding: 0 4px;
            font-size: 8px; font-weight: 700; line-height: 14px; text-align: center; border-radius: 9999px;
            background: #F97316; color: #111827;
        }
        .prognostics-density-toggle {
            display: inline-flex; border-radius: 8px; border: 1px solid rgba(100, 116, 139, 0.25); overflow: hidden; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
        }
        .prognostics-density-toggle button {
            padding: 0.45rem 0.65rem; background: rgba(31, 41, 55, 0.5); color: #94A3B8; transition: all 0.2s;
        }
        .prognostics-density-toggle button.active { background: rgba(249, 115, 22, 0.15); color: #F97316; }
        .prognostics-onboarding-card {
            max-width: 28rem; width: 100%; padding: 2rem; text-align: center;
            border: 1px solid rgba(249, 115, 22, 0.25);
            background: linear-gradient(180deg, rgba(31, 41, 55, 0.95) 0%, rgba(17, 24, 39, 0.98) 100%);
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        }
        .status-pill { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
        .prognostics-density-compact .prog-rul-row { padding-top: 0.35rem; padding-bottom: 0.35rem; }
        .prognostics-density-compact .prog-action-card { padding: 0.65rem; }
        .prognostics-density-compact .glass-card { padding: 0.75rem !important; }
        @media (max-width: 768px) {
            .prognostics-header-utilities { width: 100%; justify-content: flex-end; }
        }
        .system-health-banner {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1px solid rgba(34, 197, 94, 0.22);
            background: linear-gradient(90deg, rgba(34, 197, 94, 0.08) 0%, rgba(17, 24, 39, 0.5) 100%);
        }

        .empty-state-ghost { opacity: 0.4; pointer-events: none; }
        .welcome-empty-focus #upload-prompt { min-height: 280px; }
        .welcome-empty-focus #knowledge-base-widget { grid-column: 1 / -1; }
        .chat-bar-action-disabled { opacity: 0.28; pointer-events: none; cursor: not-allowed; }
        .quick-action-chip {
            padding: 0.3rem 0.7rem;
            border-radius: 9999px;
            font-size: 0.68rem;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.04);
            color: rgba(255, 255, 255, 0.75);
            transition: all 0.2s ease;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .quick-action-chip:not(.quick-action-disabled):hover {
            border-color: rgba(249, 115, 22, 0.45);
            background: rgba(249, 115, 22, 0.12);
            color: #fff;
        }
        .quick-action-disabled {
            opacity: 0.38;
            cursor: not-allowed;
            filter: grayscale(0.08);
        }
        #quick-action-chips {
            scrollbar-width: none;
            -ms-overflow-style: none;
            flex-wrap: nowrap !important;
            overflow-x: auto;
        }
        #quick-action-chips::-webkit-scrollbar {
            display: none;
        }
        #manuals-upload-zone.dropzone-active {
            border-color: #F97316;
            background: rgba(249, 115, 22, 0.15);
            transform: scale(1.01);
        }
        .tribal-knowledge-callout {
            border: 1px solid rgba(6, 182, 212, 0.25);
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.08) 0%, rgba(15, 23, 42, 0.4) 100%);
            border-radius: 0.75rem;
            padding: 0.85rem 1rem;
        }
        .onboarding-guide-card {
            border: 1px solid rgba(100, 116, 139, 0.22);
            border-radius: 1rem;
            padding: 1.5rem;
            background: rgba(31, 41, 55, 0.28);
        }
        .chat-view-layout {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 64px);
        }
        .chat-view-layout .chat-split-columns {
            display: grid;
            grid-template-columns: 1fr;
            flex: 1;
            min-height: 0;
            overflow: hidden;
        }
        .chat-view-layout .chat-split-columns > .flex.flex-col {
            min-height: 0;
            overflow: hidden;
        }
        @media (min-width: 1024px) {
            .chat-view-layout .chat-split-columns { grid-template-columns: 40% 60%; }
        }
        .engine-telemetry-panel {
            font-family: 'JetBrains Mono', monospace;
            background: rgba(17, 24, 39, 0.5);
            border: 1px solid rgba(100, 116, 139, 0.12);
            border-radius: 6px;
        }
        .engine-telemetry-block {
            border-top: 1px solid #1e293b;
            padding: 0.75rem 1rem;
        }
        .engine-telemetry-block:first-child {
            border-top: none;
        }
        .engine-telemetry-line {
            font-size: 10px;
            color: #94a3b8;
            letter-spacing: 0.02em;
        }

        /* Terminal - reduced glow, solid border */
        .terminal-thinking { background: rgba(17,24,39,0.98); border: 1px solid rgba(100,116,139,0.3); border-left: 2px solid #F97316; border-radius: 6px; padding: 10px 14px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #94A3B8; }
        .terminal-line { opacity: 0; animation: terminalFade 0.3s ease forwards; }
        @keyframes terminalFade { to { opacity: 1; } }

        /* Citation chips - solid, minimal */
        .citation-chip { background: rgba(6,182,212,0.08); border: 1px solid rgba(6,182,212,0.2); transition: all 0.2s ease; white-space: normal !important; }
        .citation-chip:hover { background: rgba(6,182,212,0.12); border-color: rgba(6,182,212,0.3); }

        /* PDF highlight - solid, operational */
        .pdf-highlight {
            position: absolute;
            top: 20%;
            left: 10%;
            width: 80%;
            height: 150px;
            border: 2px solid #06B6D4;
            background: rgba(6, 182, 212, 0.05);
            pointer-events: none;
            z-index: 100;
            border-radius: 3px;
        }

        /* Industrial Boot Sequence */
        @keyframes flicker {
            0% { opacity: 0.95; }
            5% { opacity: 0.6; }
            10% { opacity: 0.95; }
            15% { opacity: 0.98; }
            20% { opacity: 0.95; }
            100% { opacity: 1; }
        }
        @keyframes scanline {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(100%); }
        }
        .terminal-boot {
            animation: flicker 0.1s infinite;
            font-family: 'JetBrains Mono', monospace;
        }
        .terminal-scanline::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(to bottom, transparent, rgba(249, 115, 22, 0.08), transparent);
            animation: scanline 4s linear infinite;
            pointer-events: none;
        }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; box-shadow: 0 0 10px currentColor; transition: all 0.2s ease; }
        .status-online { background: #22C55E; color: #22C55E; }
        .status-idle {
            background: #F97316;
            color: #F97316;
            box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.45);
            animation: ledPulse 1.8s ease-in-out infinite;
        }
        .status-warning { background: #FACC15; color: #FACC15; }
        .status-critical { background: #EF4444; color: #EF4444; }
        @keyframes ledPulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.35); }
            50% { transform: scale(1.15); box-shadow: 0 0 10px rgba(249, 115, 22, 0.65); }
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 3px; }
        
        #chat-container { scroll-behavior: smooth; overflow-y: auto; height: 100%; }

        .sidebar-item { border-left: 2px solid transparent; transition: all 0.2s ease; }
        .sidebar-item:hover, .sidebar-item.active { background: rgba(100,116,139,0.1); border-left-color: #F97316; }

        /* Mobile Sidebar */
        .sidebar-mobile {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 280px;
            z-index: 100;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }
        .sidebar-mobile.open { transform: translateX(0); }
        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.7);
            z-index: 99;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        .sidebar-backdrop.open { opacity: 1; visibility: visible; }

        @media (min-width: 1024px) {
            .sidebar-mobile { position: relative; transform: none; width: 288px; }
            .sidebar-backdrop { display: none; }
            .mobile-menu-btn { display: none; }
        }

        .split-container { display: grid; grid-template-columns: 1fr; height: calc(100vh - 64px); }
        @media (min-width: 1024px) { .split-container { grid-template-columns: 40% 60%; } }

        .action-btn {
            opacity: 1;
            transition: all 0.2s ease;
        }
        .msg-ai:hover .action-btn {
            transform: translateY(-1px);
        }

        .source-modal { background: linear-gradient(180deg, rgba(17,24,39,0.98) 0%, rgba(31,41,55,0.99) 100%); border: 1px solid rgba(249,115,22,0.25); box-shadow: 0 0 60px rgba(0,0,0,0.8), 0 0 30px rgba(249,115,22,0.1); }

        /* Profile Dropdown & Settings Modal */
        .profile-dropdown-open { transform: rotate(180deg); }
        .settings-modal { background: linear-gradient(180deg, rgba(17,24,39,0.98) 0%, rgba(13,17,23,0.99) 100%); border: 1px solid rgba(100,116,139,0.2); }
        .settings-tab { border-bottom: 2px solid transparent; transition: all 0.2s ease; }
        .settings-tab.active { border-bottom-color: #F97316; color: #F97316; }
        .settings-tab:hover:not(.active) { border-bottom-color: rgba(100,116,139,0.3); }
        .settings-section { border: 1px solid rgba(100,116,139,0.15); border-radius: 8px; }
        .form-input { background: rgba(31,41,55,0.6); border: 1px solid rgba(100,116,139,0.25); border-radius: 6px; padding: 8px 12px; color: #F8FAFC; font-size: 13px; transition: all 0.2s; }
        .form-input:focus { outline: none; border-color: rgba(249,115,22,0.4); background: rgba(31,41,55,0.8); }
        .form-label { font-size: 12px; color: #94A3B8; margin-bottom: 4px; display: block; }
        .toggle-switch { width: 40px; height: 20px; background: rgba(100,116,139,0.3); border-radius: 10px; position: relative; cursor: pointer; transition: all 0.2s; }
        .toggle-switch.active { background: #22C55E; }
        .toggle-switch::after { content: ''; position: absolute; width: 16px; height: 16px; background: white; border-radius: 50%; top: 2px; left: 2px; transition: all 0.2s; }
        .toggle-switch.active::after { left: 22px; }
        .role-badge { font-size: 10px; padding: 2px 8px; border-radius: 4px; font-weight: 500; }
        .role-admin { background: rgba(249,115,22,0.15); color: #F97316; border: 1px solid rgba(249,115,22,0.3); }
        .role-tech { background: rgba(6,182,212,0.15); color: #06B6D4; border: 1px solid rgba(6,182,212,0.3); }
        .role-viewer { background: rgba(100,116,139,0.15); color: #94A3B8; border: 1px solid rgba(100,116,139,0.3); }

        .pdf-viewer-container { position: relative; background: #1F2937; }

        .note-input { background: rgba(31,41,55,0.6); border: 1px solid rgba(249,115,22,0.25); border-radius: 4px; padding: 8px 12px; font-size: 12px; color: #F8FAFC; width: 100%; margin-top: 8px; }
        .note-input:focus { outline: none; border-color: #F97316; }

        .heatmap-cell { transition: all 0.2s ease; }
        .heatmap-cell:hover { transform: scale(1.1); z-index: 10; box-shadow: 0 0 20px rgba(0,0,0,0.5); }

        /* Premium drag-over styling */
        .dragover-active {
            border-color: #F97316 !important;
            background: rgba(249, 115, 22, 0.12) !important;
            transform: scale(1.02);
            box-shadow: 0 0 30px rgba(249, 115, 22, 0.25);
            animation: border-flash 1.5s infinite alternate ease-in-out;
        }
        @keyframes border-flash {
            0% { border-color: rgba(249, 115, 22, 0.4); box-shadow: 0 0 10px rgba(249, 115, 22, 0.1); }
            100% { border-color: rgba(249, 115, 22, 1); box-shadow: 0 0 30px rgba(249, 115, 22, 0.35); }
        }

        /* Custom Telemetry Tooltip styling */
        .telemetry-tooltip-trigger {
            position: relative;
            display: inline-flex;
            align-items: center;
        }
        .telemetry-tooltip {
            position: absolute;
            bottom: 150%;
            left: 50%;
            transform: translateX(-50%) translateY(10px);
            background: #0A0A0A;
            border: 1px solid rgba(249, 115, 22, 0.4);
            color: #F8FAFC;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 9px;
            font-family: monospace;
            white-space: normal;
            max-width: 220px;
            text-align: left;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.9), 0 0 15px rgba(249, 115, 22, 0.15);
            opacity: 0;
            pointer-events: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 100;
            text-transform: none;
        }
        .telemetry-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border-width: 5px;
            border-style: solid;
            border-color: rgba(249, 115, 22, 0.4) transparent transparent transparent;
        }
        .telemetry-tooltip-trigger:hover .telemetry-tooltip {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
            pointer-events: auto;
        }
    </style>
</head>
<body class="selection:bg-safety-orange selection:text-white">
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="bg-grid"></div>
    
    <div class="relative z-10 flex h-screen">
        <div id="sidebar-backdrop" class="sidebar-backdrop lg:hidden" onclick="toggleSidebar()"></div>
        <aside id="sidebar" class="sidebar-mobile w-72 glass-card border-r border-white/5 flex flex-col">
            <div class="p-6 border-b border-white/5 flex items-center justify-between lg:block">
                <div class="flex items-center gap-3">
                    <img src="/favicon.png" alt="Index Field Logo" class="w-8 h-8 rounded">
                    <span class="font-bold tracking-widest text-sm">INDEX FIELD</span>
                </div>
                <button onclick="toggleSidebar()" class="lg:hidden p-2 text-light-slate hover:text-white">
                    <i class="fas fa-times"></i>
                </button>
                <p class="text-[10px] text-light-slate mt-2 font-semibold uppercase tracking-widest hidden lg:block">Plant Overview</p>
            </div>
            
            <nav class="flex-1 py-4">
                <div class="px-4 mb-1 mt-2 text-[10px] font-bold text-white uppercase tracking-wider">Operations</div>
                <a href="#" onclick="showView('chat')" id="nav-chat" class="sidebar-item active flex items-center gap-3 px-4 py-3 text-sm text-white font-semibold">
                    <i class="fas fa-comments text-[#F97316]"></i>
                    <span>Ask Questions</span>
                </a>
                <a href="#" onclick="routeGuard('insights')" id="nav-insights" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm text-slate-100 font-semibold hover:text-white">
                    <i class="fas fa-chart-network"></i>
                    <span>Performance Summary</span>
                    <span class="ml-auto text-[9px] bg-white/5 text-slate-200 font-medium px-1.5 py-0.5 rounded border border-white/10">ENT</span>
                </a>
                <a href="#" onclick="routeGuard('manuals')" id="nav-manuals" class="sidebar-item flex items-center gap-3 px-4 py-3 text-sm text-slate-100 font-semibold hover:text-white">
                    <i class="fas fa-folder-open"></i>
                    <span>Manuals</span>
                    <span id="manual-count" class="ml-auto text-[10px] bg-white/5 px-2 py-0.5 rounded-full hidden">0</span>

                <button onclick="hideNoteModal()" class="text-light-slate hover:text-white"><i class="fas fa-times"></i></button>
            </div>
            <p class="text-xs text-light-slate mb-3">Add tribal knowledge to this AI response for future technicians.</p>
            <textarea id="note-text" class="note-input" rows="3" placeholder="e.g., 'Also check the secondary gasket if seal continues leaking after replacement'"></textarea>
            <div class="flex gap-2 mt-4">
                <button onclick="saveNote()" class="flex-1 py-2 bg-[#F97316]/20 border border-[#F97316]/30 rounded-lg text-sm hover:bg-[#F97316]/30 transition"><i class="fas fa-save mr-1"></i>Save Note</button>
                <button onclick="hideNoteModal()" class="flex-1 py-2 bg-white/5 border border-white/10 rounded-lg text-sm hover:bg-white/10 transition">Cancel</button>
            </div>
        </div>
    </div>
    

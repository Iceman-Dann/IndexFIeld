                </div>
                <div class="settings-section p-4 text-center">
                    <div class="w-3 h-3 rounded-full bg-[#22C55E] mx-auto mb-2"></div>
                    <p class="text-sm font-medium">Gemini API</p>
                    <p class="text-xs text-[#22C55E]">Connected</p>
                </div>
                <div class="settings-section p-4 text-center">
                    <div class="w-3 h-3 rounded-full bg-[#22C55E] mx-auto mb-2"></div>
                    <p class="text-sm font-medium">Local Storage</p>
                    <p class="text-xs text-[#22C55E]">Healthy</p>
                </div>
            </div>
            
            <div class="settings-section p-4 mb-4">
                <h4 class="text-sm font-medium mb-3">API Endpoints</h4>
                <div class="space-y-2 text-sm">
                    <div class="flex items-center justify-between">
                        <span class="text-light-slate">/query</span>
                        <span class="text-[#22C55E]">< 100ms avg</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-light-slate">/manuals</span>
                        <span class="text-[#22C55E]">< 50ms avg</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-light-slate">/upload</span>
                        <span class="text-[#22C55E]">Processing</span>
                    </div>
                </div>
            </div>
            
            <div class="settings-section p-4">
                <h4 class="text-sm font-medium mb-3">Recent System Events</h4>
                <div class="space-y-2 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E]"></span>
                        <span class="text-light-slate">2 min ago</span>
                        <span>Manual index updated - Pump_Maintenance_v2.pdf</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E]"></span>
                        <span class="text-light-slate">15 min ago</span>
                        <span>Query cache refreshed</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#FACC15]"></span>
                        <span class="text-light-slate">1 hour ago</span>
                        <span>Backup completed</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 space-y-2"></div>

    <script>
        // Supabase client is initialized in supabase-config.js (loaded in <head>)

        // =============================================
        // SESSION GUARD — Redirect if not logged in
        // =============================================
        (async function guardSession() {
            const { data: { session } } = await supabaseClient.auth.getSession();
            
            // Check for demo session in localStorage (same logic as signin.html)
            function getStoredDemoSession() {
                try {
                    const raw = localStorage.getItem('indexfield-demo-session');
                    if (!raw) return null;
                    const parsed = JSON.parse(raw);
                    return parsed && parsed.user ? parsed : null;
                } catch {
                    return null;
                }
            }

            const demoSession = getStoredDemoSession();
            
            if (!session && !demoSession) {
                window.location.href = 'signin.html';
                return;
            }
            
            // Load user profile into UI (use Supabase session if available, otherwise demo session)
            const user = session ? session.user : demoSession.user;
            loadUserProfile(user);
        })();

        // Name sanitizer to strip out test accounts / placeholders
        function sanitizeDisplayName(name) {
            if (!name) return 'John Smith';
            let clean = name.trim();
            if (clean.toLowerCase() === 'john test' || clean.toLowerCase() === 'john.test' || clean.toLowerCase() === 'test') {
                return 'John Smith';
            }
            clean = clean.replace(/[\.\-_]test$/i, '');
            clean = clean.replace(/^test[\.\-_]/i, '');
            return clean.split(/[\s\.\-_]+/)
                .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
                .join(' ');
        }

        // App-wide route guard for empty state
        function routeGuard(viewId) {
            showView(viewId);
        }

        // =============================================
        // LOAD USER PROFILE
        // =============================================
        async function loadUserProfile(user) {
            // Set basic info from auth immediately
            const email = user.email || '';
            let metaName = user.user_metadata?.full_name || email.split('@')[0];
            metaName = sanitizeDisplayName(metaName);

            // Update sidebar + dropdown with auth data right away
            document.getElementById('user-display-name').textContent = metaName;
            document.getElementById('dropdown-user-name').textContent = metaName;
            document.getElementById('dropdown-user-company').textContent = email;

            // Try to load richer profile from profiles table
            try {
                const { data: profile, error } = await supabaseClient
                    .from('profiles')
                    .select('full_name, job_title, company, role')
                    .eq('id', user.id)
                    .single();

                if (profile && !error) {
                    let displayName = profile.full_name || metaName;
                    displayName = sanitizeDisplayName(displayName);
                    const role = profile.role || 'viewer';
                    let roleLabel = role.charAt(0).toUpperCase() + role.slice(1);
                    if (roleLabel === 'Viewer') roleLabel = 'Plant Manager';

                    document.getElementById('user-display-name').textContent = displayName;
                    document.getElementById('user-display-role').textContent = roleLabel;
                    document.getElementById('dropdown-user-name').textContent = displayName;
                    document.getElementById('dropdown-user-title').textContent = profile.job_title || 'Team Member';
                    document.getElementById('dropdown-user-company').textContent =
                        (profile.company || 'My Company') + ' • Enterprise';
                }
            } catch (e) {
                console.warn('Could not load profile:', e);
            }
        }

        // =============================================
        // LOGOUT
        // =============================================
        async function handleLogout() {
            await supabaseClient.auth.signOut();
            // Also clear demo session if present
            localStorage.removeItem('indexfield-demo-session');
            window.location.href = 'signin.html';
        }

        // =============================================
        // Listen for auth state changes (e.g. token refresh failure)
        // =============================================
        supabaseClient.auth.onAuthStateChange((event, session) => {
            if (event === 'SIGNED_OUT') {
                window.location.href = 'signin.html';
            }
        });

        const API_URL = 'http://localhost:8000'; // Backend API URL
        const ALLOWED_UPLOAD_EXTENSIONS = ['.pdf', '.txt', '.csv', '.docx'];
        const SYSTEM_ASSET_MARKERS = ['favicon', 'logo.png', 'logo.svg', 'icon.', 'apple-touch', 'manifest'];

        function isAllowedUploadFile(file) {
            if (!file || !file.name) return false;
            const name = file.name.toLowerCase();
            const ext = name.includes('.') ? name.slice(name.lastIndexOf('.')) : '';
            if (!ALLOWED_UPLOAD_EXTENSIONS.includes(ext)) return false;
            if (SYSTEM_ASSET_MARKERS.some(m => name.includes(m))) return false;
            return true;
        }

        function filterIndustrialManuals(list) {
            const sampleFiles = ['indexfield', 'sample', 'demo', 'test', 'industrial'];
            return (list || []).filter(m => {
                const name = (m.filename || '').toLowerCase();
                if (!isAllowedUploadFile({ name: m.filename || '' })) return false;
                if (SYSTEM_ASSET_MARKERS.some(s => name.includes(s))) return false;
                return !sampleFiles.some(s => name.includes(s));
            });
        }

        function extractUploadChunkCount(data) {
            if (typeof data?.manual?.chunk_count === 'number') {
                return data.manual.chunk_count;
            }
            const message = typeof data?.message === 'string' ? data.message : '';
            const match = message.match(/(\d+)\s+(?:chunks|content chunks)/i);
            return match ? Number(match[1]) : null;
        }

        function updatePlantDocumentsLabel(pageView) {
            const el = document.getElementById('page-indicator');
            if (!el) return;
            if (pageView) {
                el.textContent = `Viewing page ${pageView}`;
                return;
            }
            const count = filterIndustrialManuals(manuals).length;
            if (count === 0) {
                el.textContent = 'No manuals loaded yet';
            } else {
                el.textContent = `${count} document${count === 1 ? '' : 's'} indexed`;
            }
        }

        function applyStatusDotState(dot, state) {
            if (!dot) return;
            dot.className = 'status-dot';
            if (state === 'ready') {
                dot.classList.add('status-online');
            } else if (state === 'busy') {
                dot.classList.add('status-warning');
            } else if (state === 'offline') {
                dot.classList.add('status-critical');
            } else {
                dot.classList.add('status-idle');
            }
            dot.style.background = '';
            dot.style.color = '';
        }

        function setSystemStatusLine(message, state) {
            const line = document.getElementById('system-status-line');
            const dot = document.getElementById('system-status-dot');
            if (line) line.textContent = message;
            applyStatusDotState(dot, state);
        }

        function updateReadinessChecklist(hasManuals = false) {
            const statusText = document.getElementById('checklist-status-text');
            if (!statusText) return;

            if (hasManuals) {
                statusText.textContent = `${filterIndustrialManuals(manuals).length} manuals indexed and ready for your first question.`;
                return;
            }

            statusText.textContent = 'Waiting for the first manual upload.';
        }

        function syncSourcePanelState() {
            const placeholder = document.getElementById('pdf-placeholder');
            if (!placeholder) return;
            if (currentPdf) {
                placeholder.classList.add('hidden');
                return;
            }

            placeholder.classList.remove('hidden');
            const hasManuals = filterIndustrialManuals(manuals).length > 0;

            if (hasManuals) {
                placeholder.innerHTML = `
                    <div class="max-w-xl w-full rounded-2xl border border-white/10 bg-[#111827]/75 p-6 shadow-[0_0_30px_rgba(15,23,42,0.55)] transition-all duration-300">
                        <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#22C55E] mb-3">Pipeline Armed</p>
                        <h2 class="text-2xl font-bold text-white mb-3">Manuals are indexed and ready</h2>
                        <p class="text-sm text-slate-300 leading-relaxed mb-5">Ask a question to load the matching source page and turn the right panel into an operational document view.</p>
                        <div class="grid grid-cols-1 gap-3 text-left">
                            <div class="rounded-xl border border-white/10 bg-white/5 p-3">
                                <p class="text-[10px] uppercase tracking-widest text-slate-400">Indexed Manuals</p>
                                <p class="mt-2 text-lg font-bold text-white">${filterIndustrialManuals(manuals).length}</p>
                            </div>
                            <div class="rounded-xl border border-white/10 bg-white/5 p-3">
                                <p class="text-[10px] uppercase tracking-widest text-slate-400">Next Step</p>
                                <p class="mt-2 text-sm text-slate-200">Ask a question below to surface the exact page and citations.</p>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                placeholder.innerHTML = `
                    <div class="max-w-xl w-full rounded-2xl border border-white/10 bg-[#111827]/75 p-6 shadow-[0_0_35px_rgba(15,23,42,0.55)] transition-all duration-300">
                        <div class="flex items-start justify-between gap-4 mb-4">
                            <div class="text-left">
                                <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-slate-400 mb-2">System Readiness Checklist</p>
                                <h2 class="text-2xl font-bold text-white">Upload a manual to start the pipeline</h2>
                            </div>
                            <span id="source-armed-badge" class="inline-flex items-center gap-2 rounded-full border border-[#F97316]/30 bg-[#F97316]/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-[#F97316]">Awaiting Input</span>
                        </div>
                        <p id="source-panel-copy" class="text-sm text-slate-300 leading-relaxed text-left mb-2">The Knowledge Base zone and the right-side checklist now work as one guided workflow for first-time operators.</p>
                        <p class="text-sm text-slate-200 text-left mb-5">Already mapped your fleet?
                            <button type="button" onclick="importFromAssetRegistry()" class="text-[#F97316] font-semibold hover:text-[#EA580C] hover:underline transition-colors ml-1">Import from Asset Registry</button>
                            to sync manuals attached to your equipment.
                        </p>
                        <div id="readiness-checklist" class="space-y-3 text-left">
                            <div id="checklist-step-1" class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <span id="checklist-step-1-icon" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#F97316]/15 text-[#F97316] animate-pulse"><i class="fas fa-circle-notch"></i></span>
                                    <div>
                                        <p class="text-sm font-semibold text-white">Drop a manual into the Knowledge Base</p>
                                        <p class="text-[10px] text-slate-300">PDF, TXT, CSV, or DOCX</p>
                                    </div>
                                </div>
                                <span id="checklist-step-1-label" class="text-[10px] uppercase tracking-[0.2em] text-[#F97316] font-bold">Pending</span>
                            </div>
                            <div id="checklist-step-2" class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <span id="checklist-step-2-icon" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/5 text-slate-300"><i class="fas fa-file-import"></i></span>
                                    <div>
                                        <p class="text-sm font-semibold text-white">Let the engine index the manual</p>
                                        <p class="text-[10px] text-slate-300">Chunks, pages, and metadata will be prepared automatically</p>
                                    </div>
                                </div>
                                <span id="checklist-step-2-label" class="text-[10px] uppercase tracking-[0.2em] text-slate-400 font-bold">Pending</span>
                            </div>
                            <div id="checklist-step-3" class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <span id="checklist-step-3-icon" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/5 text-slate-300"><i class="fas fa-comments"></i></span>
                                    <div>
                                        <p class="text-sm font-semibold text-white">Ask a question to surface source pages</p>
                                        <p class="text-[10px] text-slate-300">The right panel will switch to the document viewer</p>
                                    </div>
                                </div>
                                <span id="checklist-step-3-label" class="text-[10px] uppercase tracking-[0.2em] text-slate-400 font-bold">Pending</span>
                            </div>
                        </div>
                        <div id="source-panel-state" class="mt-5 rounded-xl border border-white/10 bg-white/5 p-4 text-left">
                            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                <div>
                                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">Current status</p>
                                    <p id="checklist-status-text" class="text-sm text-white mt-1">Waiting for the first manual upload.</p>
                                </div>
                                <button type="button" onclick="showUploadModal()" class="px-4 py-2 rounded-lg bg-[#F97316] text-black text-[11px] font-bold uppercase tracking-wider hover:bg-[#EA580C] transition">Upload Manual</button>
                            </div>
                        </div>
                    </div>
                `;
            }
            updateReadinessChecklist(hasManuals);
        }

        function refreshKnowledgeBaseUI() {
            const indexedManualsList = document.getElementById('indexed-manuals-list');
            const uploadPrompt = document.getElementById('upload-prompt');
            const sampleButton = document.getElementById('load-sample-manual-btn');
            const displayManuals = filterIndustrialManuals(manuals);

            if (indexedManualsList) {
                if (displayManuals.length > 0) {
                    if (uploadPrompt) uploadPrompt.classList.add('hidden');
                    if (sampleButton) sampleButton.classList.add('hidden');
                    indexedManualsList.classList.remove('hidden');
                    indexedManualsList.innerHTML = displayManuals.slice(0, 3).map(m => `
                        <div class="data-surface p-1.5 rounded text-[11px] flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <i class="fas fa-file-pdf text-red-400 text-[10px]"></i>
                                <span class="text-light-slate truncate" style="max-width: 120px;" title="${m.filename}">${m.filename}</span>
                            </div>
                            <span class="text-[9px] text-[#22C55E]">${m.page_count || 0}p</span>
                        </div>
                    `).join('');
                    const statManualsIndexed = document.getElementById('stat-manuals-indexed');
                    if (statManualsIndexed) statManualsIndexed.textContent = displayManuals.length;
                } else {
                    if (uploadPrompt) uploadPrompt.classList.remove('hidden');
                    if (sampleButton) sampleButton.classList.remove('hidden');
                    indexedManualsList.classList.add('hidden');
                    indexedManualsList.innerHTML = '';
                }
            }
            updatePlantDocumentsLabel();
        }

        let manuals = [];
        let currentPdf = null;
        const QUICK_ACTION_PROMPTS = {
            fault: 'Look up the most common fault codes for this equipment. For each code, explain what it means and the recommended first troubleshooting steps.',
            maintenance: 'Show the preventive maintenance schedule from the manual. Include service intervals, required tasks, parts, and lubricants.',
            loto: 'What are the lockout/tagout (LOTO) safety procedures for servicing this equipment? List the shutdown and energy isolation steps in order.'
        };
        let currentView = 'chat';
        let currentMsgId = null;
        let rightPanelTransitionActive = false;
        let queryHistory = [];
        let pastedContext = null;
        
        const thinkingSteps = [
            "> Initializing vector search...",
            "> Loading manual embeddings...",
            "> Scanning relevant sections...",
            "> Cross-referencing diagrams...",
            "> Analyzing technical specs...",
            "> Synthesizing verified response..."
        ];
        
        function showView(view) {
            const viewId = view + '-view';
            const views = document.querySelectorAll('main > .dashboard-view');
            const selectedEl = document.getElementById(viewId);
            
            // ✅ Fix: Changed from '.nav-item' to '.sidebar-item'
            const navItems = document.querySelectorAll('.sidebar-item'); 
            const selectedNav = document.getElementById('nav-' + view);
            
            // Hide all views with maximum authority (class + style)
            views.forEach(el => {
                el.classList.add('hidden');
                el.style.display = 'none';
            });
            
            // Clear all nav states
            navItems.forEach(item => item.classList.remove('active'));
            
            // Show selected view with layout-specific forcing
            if (selectedEl) {
                selectedEl.classList.remove('hidden');
                if (view === 'chat') {
                    selectedEl.style.display = 'flex';
                    selectedEl.style.flexDirection = 'column';
                    selectedEl.style.height = 'calc(100vh - 64px)';
                    selectedEl.style.minHeight = '0';
                } else {
                    // Standard views use flex to fill available workspace
                    selectedEl.style.display = 'flex';
                    selectedEl.style.flexDirection = 'column';
                    
                    // ✅ Fix: Remove '100%' height to let Tailwind's flex-1 prevent container collapse
                    selectedEl.style.height = ''; 
                    selectedEl.style.minHeight = '0';
                }
                selectedEl.style.zIndex = '10';
            }
            
            // Update UI labels and active states
            if (selectedNav) selectedNav.classList.add('active');
            currentView = view;
            
            const titles = {
                'chat': 'Ask Questions',
                'insights': 'Performance Summary',
                'assets': 'Asset Registry',
                'telemetry': 'Live Monitoring',
                'prognostics': 'Maintenance Forecast',
                'loto': 'Lockout / Tagout',
                'manuals': 'Manuals',
                'help': 'Help Center',
                'history': 'Search History'
            };
            document.getElementById('page-title').textContent = titles[view] || 'IndexField';
            
            // Auto-close sidebar on mobile
            if (window.innerWidth < 1024) {
                const sidebar = document.getElementById('sidebar');
                const backdrop = document.getElementById('sidebar-backdrop');
                if (sidebar) sidebar.classList.remove('open');
                if (backdrop) backdrop.classList.remove('open');
            }

            if (view === 'telemetry') {
                if (telemetryInterval) {
                    clearInterval(telemetryInterval);
                }
                syncTelemetryOpsView();
                startTelemetrySimulation();
            } else if (view === 'prognostics') {
                syncPrognosticsView();
            } else if (view === 'loto') {
                hydrateLoToPage();
            } else if (view === 'assets') {
                loadAssetRegistry();
            } else if (view === 'insights') {
                generateHeatmap();
            } else if (telemetryInterval) {
                clearInterval(telemetryInterval);
                telemetryInterval = null;
            }

            syncDashboardState();
        }
        
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            sidebar.classList.toggle('open');
            backdrop.classList.toggle('open');
        }
        
        function setQuery(text) {
            const input = document.getElementById('chat-input');
            input.value = text;
            input.focus();
            input.style.height = 'auto';
            input.style.height = input.scrollHeight + 'px';
        }
        
        function activatePromptShortcut(promptText) {
            const input = document.getElementById('chat-input');
            if (!promptText) return;
            if (input?.disabled) {
                showToast('Upload a manual first to enable this action.', 'accent');
                return;
            }
            setQuery(promptText);
            sendMessage();
        }

        function setRightPanelTransitionState(isActive) {
            rightPanelTransitionActive = isActive;
            const placeholder = document.getElementById('pdf-placeholder');
            const frame = document.getElementById('pdf-frame');
            if (!placeholder) return;

            if (currentPdf) {
                placeholder.classList.add('hidden');
                if (frame) frame.classList.remove('hidden');
                return;
            }

            if (isActive) {
                if (frame) frame.classList.add('hidden');
                placeholder.classList.remove('hidden');
                placeholder.innerHTML = `
                    <div class="max-w-xl w-full rounded-2xl border border-[#06B6D4]/30 bg-[#111827]/75 p-6 shadow-[0_0_30px_rgba(6,182,212,0.12)]">
                        <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#06B6D4] mb-3">Conversation Active</p>
                        <h2 class="text-2xl font-bold text-white mb-3">Query in progress</h2>
                        <p class="text-sm text-slate-300 leading-relaxed mb-4">The right panel is switching away from the Pipeline Armed state while the answer is being assembled.</p>
                        <div class="rounded-xl border border-white/10 bg-white/5 p-4 text-left">
                            <p class="text-[10px] uppercase tracking-[0.2em] text-slate-400">Live status</p>
                            <p class="mt-2 text-sm text-slate-200">Searching the indexed manual set and preparing the document context for your answer.</p>
                        </div>
                    </div>
                `;
                return;
            }

            syncSourcePanelState();
        }

        function handleChatKeypress(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendMessage();
            }
        }
        
        function handlePaste(event) {
            // Let the paste happen, then check the content
            setTimeout(() => {
                const input = document.getElementById('chat-input');
                const content = input.value;
                
                // If pasted content is large (>500 chars), offer to attach as context
                if (content.length > 500 && !pastedContext) {
                    // Extract what looks like the main content (first substantial paragraph)
                    const lines = content.split('\n').filter(l => l.trim().length > 20);
                    if (lines.length > 3) {
                        pastedContext = content;
                        updateContextBar();
                        showToast(`Large text detected (${content.length} chars) - attached as context`, 'brand');
                    }
                }
                
                // Auto-resize textarea
                input.style.height = 'auto';
                input.style.height = Math.min(input.scrollHeight, 200) + 'px';
            }, 10);
        }
        
        function updateContextBar() {
            const bar = document.getElementById('pasted-context-bar');
            const info = document.getElementById('pasted-context-info');
            if (pastedContext) {
                bar.classList.remove('hidden');
                info.textContent = `Text attached as context (${pastedContext.length.toLocaleString()} chars)`;
            } else {
                bar.classList.add('hidden');
            }
        }
        
        function clearPastedContext() {
            pastedContext = null;
            updateContextBar();
            showToast('Context removed', 'accent');
        }
        
        function sendMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;
            if (input?.disabled) {
                showToast('Upload a manual first to enable this action.', 'accent');
                return;
            }
            
            // Check if this looks like pasted content (large, no question mark)
            if (text.length > 500 && !text.includes('?') && !pastedContext) {
                // Treat as context attachment
                pastedContext = text;
                updateContextBar();
                input.value = '';
                input.style.height = 'auto';
                showToast('Text attached as context. Now ask your question!', 'brand');
                return;
            }

            setRightPanelTransitionState(true);
            
            const pdfPlaceholder = document.getElementById('pdf-placeholder');
            if (pdfPlaceholder) pdfPlaceholder.classList.add('hidden');
            const pdfFrame = document.getElementById('pdf-frame');
            if (pdfFrame) pdfFrame.classList.remove('hidden');
            const panelHeader = document.getElementById('pdf-panel-header');
            if (panelHeader) panelHeader.classList.remove('hidden');

            addMessage(text, 'user');
            input.value = '';
            input.style.height = 'auto';
            queryHistory.push({ query: text, timestamp: new Date() });
            document.getElementById('welcome-message').classList.add('hidden');
            showTerminalThinking();
            
            // Build request with optional context
            const requestBody = { query: text, top_k: 3 };
            if (pastedContext) {
                requestBody.context = pastedContext;
            }

            // Stream response
            fetch(`${API_URL}/query`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(requestBody)
            })
            .then(r => {
                if (!r.ok) throw new Error(`Server error: ${r.status}`);
                
                // Switch to stream mode in right panel
                const frame = document.getElementById('pdf-frame');
                if (frame) {
                    frame.classList.add('hidden');
                    // Create streaming container if not exists
                    let streamContainer = document.getElementById('ai-stream-container');
                    if (!streamContainer) {
                        streamContainer = document.createElement('div');
                        streamContainer.id = 'ai-stream-container';
                        streamContainer.className = 'w-full h-full p-4 overflow-y-auto text-sm text-slate-200';
                        frame.parentNode.appendChild(streamContainer);
                    }
                    streamContainer.classList.remove('hidden');
                    streamContainer.innerHTML = '<p class="text-xs text-[#F97316] mb-2 animate-pulse">Streaming AI Response...</p>';
                }
                return r.body.getReader();
            })
            .then(reader => {
                const decoder = new TextDecoder();
                const streamContainer = document.getElementById('ai-stream-container');
                function read() {
                    return reader.read().then(({ done, value }) => {
                        if (done) {
                            hideTerminalThinking();
                            return;
                        }
                        const chunk = decoder.decode(value);
                        if (streamContainer) streamContainer.insertAdjacentHTML('beforeend', chunk);
                        read();
                    });
                }
                read();
            })
            .catch(err => {
                console.error(err);
                hideTerminalThinking();
                showToast('Failed to stream response.', 'critical');
            });
            // Removed redundant fetch chaining
            // End of message send flow
        }
        
        function showTerminalThinking() {
            const terminal = document.getElementById('terminal-thinking');
            const content = document.getElementById('terminal-content');
            terminal.classList.remove('hidden');
            content.innerHTML = '';
            thinkingSteps.forEach((step, i) => {
                setTimeout(() => {
                    const div = document.createElement('div');
                    div.className = 'terminal-line';
                    div.textContent = step;
                    content.appendChild(div);
                    content.parentElement.scrollTop = content.scrollHeight;
                }, i * 400);
            });
        }
        
        function hideTerminalThinking() {
            document.getElementById('terminal-thinking').classList.add('hidden');
        }
        
        function addMessage(text, type, sources = null, citations = null) {
            const container = document.getElementById('messages');
            const msgId = 'msg-' + Date.now();
            const div = document.createElement('div');
            div.id = msgId;
            div.className = 'animate-in';
            const isVerified = localStorage.getItem('verified-' + msgId) === 'true';
            if (type === 'user') {
                div.innerHTML = `<div class="flex gap-3 flex-row-reverse"><div class="w-8 h-8 rounded-full bg-white/10 border border-white/10 flex items-center justify-center"><i class="fas fa-user text-xs"></i></div><div class="msg-user px-4 py-3 rounded-2xl rounded-tr-sm max-w-[90%]"><p class="text-sm leading-relaxed">${text}</p></div></div>`;
            } else {
                let citationsHtml = '';
                if (citations && citations.length > 0) citationsHtml = '<div class="flex flex-wrap gap-1.5 mt-3">' + citations.map((c, i) => `<button onclick="showMiniPreview(this, ${i})" class="citation-chip px-2 py-1 rounded text-[10px] font-mono text-[#22C55E]">${c}</button>`).join('') + '</div>';
                const actionHtml = `
                    <div class="action-btn absolute bottom-2 right-2 flex gap-2">
                        <button onclick="verifyResponse(this)" class="px-2 py-1 bg-[#22C55E]/10 hover:bg-[#22C55E]/20 border border-[#22C55E]/30 rounded text-[9px] text-[#22C55E] font-bold transition">
                            <i class="fas fa-check-double mr-1"></i>VERIFY
                        </button>
                        <button onclick="openNoteModal('${msgId}')" class="px-2 py-1 bg-white/5 hover:bg-white/10 border border-white/10 rounded text-[9px] text-white transition">
                            <i class="fas fa-pen-fancy mr-1"></i>ADD NOTE
                        </button>
                        <button onclick="exportToWorkOrder('${msgId}', \`${(text || '').replace(/`/g, '\\`')}\`)" class="px-2 py-1 bg-white/5 hover:bg-white/10 border border-white/10 rounded text-[9px] text-white transition">
                            <i class="fas fa-file-export mr-1"></i>WORK ORDER
                        </button>
                    </div>
                `;
                div.innerHTML = `<div class="flex gap-3"><div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#F97316]/20 to-[#22C55E]/20 border border-[#F97316]/20 flex items-center justify-center"><i class="fas fa-robot text-xs text-[#F97316]"></i></div><div class="${isVerified ? 'verified' : ''} msg-ai px-4 py-3 rounded-2xl rounded-tl-sm max-w-[90%] relative pb-12"><p class="text-sm leading-relaxed whitespace-pre-wrap">${text}</p>${citationsHtml}${actionHtml}<div id="notes-${msgId}" class="mt-2 space-y-1"></div></div></div>`;
            }
            if (sources) div.dataset.sources = JSON.stringify(sources);
            container.appendChild(div);
            // Scroll chat container to bottom after DOM update
            setTimeout(() => {
                const chatContainer = document.getElementById('chat-container');
                if (chatContainer) chatContainer.scrollTop = chatContainer.scrollHeight;
            }, 10);
            return msgId;
        }
        
        function loadPdfSource(source) {
            currentPdf = source;
            document.getElementById('pdf-placeholder').classList.add('hidden');
            document.getElementById('pdf-frame').classList.remove('hidden');
            document.getElementById('pdf-filename').textContent = source.manual_name;
            updatePlantDocumentsLabel(source.page_number);
            document.getElementById('pdf-frame').src = `${API_URL}/uploads/${source.manual_id}_${source.manual_name}#page=${source.page_number}`;
            const highlight = document.getElementById('pdf-highlight-box');
            highlight.classList.remove('hidden');
            setTimeout(() => highlight.classList.add('hidden'), 3000);
        }
        
        function highlightPdfSource(index) {
            const msgs = document.getElementById('messages').children;
            const lastMsg = msgs[msgs.length - 1];
            if (!lastMsg.dataset.sources) return;
            const sources = JSON.parse(lastMsg.dataset.sources);
            if (sources[index]) loadPdfSource(sources[index]);
        }
        
        function showMiniPreview(btn, index) {
            const msg = btn.closest('[data-sources]');
            if (!msg || !msg.dataset.sources) return;
            const sources = JSON.parse(msg.dataset.sources);
            const source = sources[index];
            if (!source) return;
            
            let popup = document.getElementById('citation-mini-preview');
            if (!popup) {
                popup = document.createElement('div');
                popup.id = 'citation-mini-preview';
                popup.className = 'absolute z-[200] bg-[#1F2937] border border-[#22C55E]/50 rounded-lg shadow-2xl overflow-hidden w-[400px] h-[300px] flex flex-col transition-opacity';
                document.body.appendChild(popup);
                
                document.addEventListener('click', (e) => {
                    if (!popup.contains(e.target) && !e.target.closest('.citation-chip')) {
                        popup.classList.add('hidden');
                    }
                });
            }
            
            const rect = btn.getBoundingClientRect();
            popup.style.top = `${rect.bottom + window.scrollY + 10}px`;
            popup.style.left = `${Math.min(rect.left, window.innerWidth - 420)}px`;
            popup.classList.remove('hidden');
            
            popup.innerHTML = `
                <div class="flex items-center justify-between px-3 py-2 bg-black/50 border-b border-white/10">
                    <span class="text-xs text-white font-mono">${source.manual_name} - Page ${source.page_number}</span>
                    <button onclick="document.getElementById('citation-mini-preview').classList.add('hidden')" class="text-light-slate hover:text-white"><i class="fas fa-times"></i></button>
                </div>
                <iframe src="${API_URL}/uploads/${source.manual_id}_${source.manual_name}#page=${source.page_number}&view=FitH" class="w-full flex-1 bg-white"></iframe>
            `;
        }

        function toggleLowSignal() {
            document.body.classList.toggle('low-signal-mode');
            const btn = document.getElementById('low-signal-btn');
            const badge = document.getElementById('data-usage-badge');
            
            if (document.body.classList.contains('low-signal-mode')) {
                btn.className = "text-[10px] font-mono bg-[#FACC15]/20 text-[#FACC15] border border-[#FACC15]/50 px-3 py-1.5 rounded hover:bg-[#FACC15]/30 transition flex items-center gap-2";
                btn.innerHTML = `<i class="fas fa-signal"></i> LIMITED CONNECTIVITY`;
                if(badge) badge.classList.remove('hidden');
                localStorage.setItem('low_signal_mode', 'true');
                showToast('Low Signal Mode Enabled (Animations off)', 'accent');
            } else {
                btn.className = "text-[10px] font-mono bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/30 px-3 py-1.5 rounded hover:bg-[#22C55E]/20 transition flex items-center gap-2";
                btn.innerHTML = `<i class="fas fa-lock"></i> SECURE PLANT NETWORK`;
                if(badge) badge.classList.add('hidden');
                localStorage.setItem('low_signal_mode', 'false');
                showToast('Low Signal Mode Disabled', 'brand');
            }
        }
        
        function loadLowSignalState() {
            const btn = document.getElementById('low-signal-btn');
            const badge = document.getElementById('data-usage-badge');
            if (localStorage.getItem('low_signal_mode') === 'true') {
                document.body.classList.add('low-signal-mode');
                if(btn) {
                    btn.className = "text-[10px] font-mono bg-[#FACC15]/20 text-[#FACC15] border border-[#FACC15]/50 px-3 py-1.5 rounded hover:bg-[#FACC15]/30 transition flex items-center gap-2";
                    btn.innerHTML = `<i class="fas fa-signal"></i> LIMITED CONNECTIVITY`;
                }
                if(badge) badge.classList.remove('hidden');
            } else {
                if(btn) {
                    btn.className = "text-[10px] font-mono bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/30 px-3 py-1.5 rounded hover:bg-[#22C55E]/20 transition flex items-center gap-2";
                    btn.innerHTML = `<i class="fas fa-lock"></i> SECURE PLANT NETWORK`;
                }
                if(badge) badge.classList.add('hidden');
            }
        }

        let isEngineThrottled = false;
        let latestInsightsData = null;

        function syncHeaderSystemStatus() {
            const loadText = document.getElementById('load-text');
            const loadDot = document.getElementById('load-status-dot');
            if (!loadText || !loadDot) return;

            const hasManuals = filterIndustrialManuals(manuals).length > 0;

            if (isEngineThrottled) {
                loadText.className = 'cursor-pointer text-[10px] font-mono text-[#FACC15] bg-white/5 px-2 py-1 rounded flex items-center gap-1.5 border border-white/10 hover:bg-white/10 transition font-bold';
                loadDot.className = 'text-[#FACC15] text-xs leading-none';
                loadText.textContent = 'OPERATIONAL INTELLIGENCE: BUSY';
                return;
            }

            if (hasManuals) {
                loadText.className = 'cursor-pointer text-[10px] font-mono text-[#22C55E] bg-white/5 px-2 py-1 rounded flex items-center gap-1.5 border border-white/10 hover:bg-white/10 transition font-bold';
                loadDot.className = 'text-[#22C55E] text-xs leading-none';
                loadText.textContent = 'OPERATIONAL INTELLIGENCE';
            } else {
                loadText.className = 'cursor-pointer text-[10px] font-mono text-[#F97316] bg-white/5 px-2 py-1 rounded flex items-center gap-1.5 border border-white/10 hover:bg-white/10 transition font-semibold';
                loadDot.className = 'text-[#F97316] text-xs leading-none';
                loadText.textContent = 'OPERATIONAL INTELLIGENCE: STANDBY';
            }
        }

        function toggleEngineThrottle() {
            isEngineThrottled = !isEngineThrottled;
            syncHeaderSystemStatus();

            if (isEngineThrottled) {
                setSystemStatusLine('System Status: Processing — Please Wait', 'busy');
                showToast('System is processing — please wait.', 'accent');
            } else if (filterIndustrialManuals(manuals).length > 0) {
                setSystemStatusLine('System Status: Active — Manual Indexed', 'ready');
                showToast('System ready.', 'brand');
            } else {
                setSystemStatusLine('System Status: Standby — Awaiting Manual', 'idle');
            }
            if (currentTelemetry) renderTelemetry(currentTelemetry);
        }

        function startROITicker() {
            let currentSavings = 0.00;
            const tickerEl = document.getElementById('roi-savings-ticker');
            if(!tickerEl) return;
            
            setInterval(() => {
                const totalQueriesEl = document.getElementById('total-queries');
                const currentQueries = totalQueriesEl ? parseInt((totalQueriesEl.textContent || '0').replace(/[^0-9]/g, ''), 10) : 0;

                // Day 1 Reset: Don't tick if no manuals or no actual query activity
                if (!manuals || manuals.length === 0 || currentQueries <= 0) {
                    tickerEl.textContent = '$0.00';
                    return;
                }
                // Randomly tick up by small cents to make it feel live
                if (Math.random() > 0.4) {
                    currentSavings += (Math.random() * 0.5);
                    tickerEl.textContent = '$' + currentSavings.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                }
            }, 3000);
            
            // Listen for specific events to bump the savings bigger
            document.addEventListener('shift_handover_created', () => {
                currentSavings += 150.00; // Handover saves time
                tickerEl.classList.add('text-white', 'scale-110');
                setTimeout(() => tickerEl.classList.remove('text-white', 'scale-110'), 300);
                tickerEl.textContent = '$' + currentSavings.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            });
        }
        
        function initiateLogoutHandover() {
            // Pulse the "Draft Handover Report" buttons
            const draftBtns = document.querySelectorAll('button[onclick="draftHandoverReport()"], button[onclick="initiateLogoutHandover()"]');
            draftBtns.forEach(btn => btn.classList.add('animate-pulse', 'bg-[#F97316]'));

            const reportModal = document.createElement('div');
            reportModal.id = 'shift-handover-modal';
            reportModal.className = "fixed inset-0 z-[300] bg-black/95 flex items-center justify-center p-4 overflow-y-auto backdrop-blur-sm";
            
            reportModal.innerHTML = `
                <div class="w-full max-w-4xl bg-[#0a0a0a] border border-[#F97316]/50 p-6 shadow-[0_0_50px_rgba(249,115,22,0.15)] relative">
                    <pre class="whitespace-pre-wrap text-sm leading-relaxed text-[#F97316] font-mono">
┌──────────────────────────────────────────────────────────────────────────────┐
│ INDEX FIELD // MISSION CONTROL ENGINE v2.0 // SHIFT HANDOVER REPORT         │
├──────────────────────────────────────────────────────────────────────────────┤
│ SHIFT: DAY-A  //  OPERATOR: Danila  //  DATE: ${new Date().toISOString().slice(0,10)}                     │
│                                                                              │
│ [ SUMMARY OF TELEMETRY EXCEPTIONS ]                                          │
│ * CNC-01X: 14:22 EST - Bearing Temp exceeded threshold (91.2°C).             │
│   AI Insight: Thermal deviation correlates with 88.4% spindle load spike.    │
│                                                                              │
│ [ TRIBAL KNOWLEDGE ADDITIONS ]                                               │
│ * Note #04 added: "Vibration on Feed Pump 3A resolved after gasket swap."    │
│                                                                              │
│ [ OUTGOING STATUS ]                                                          │
│ * Open Alerts: 1  //  Isolated Assets: 0  //  System Stability: 98.4%       │
│                                                                              │
│ [ ] ESCALATE UNRESOLVED ALERTS TO NEXT SHIFT ENGINE                          │
│                                                                              │</pre>
                    <div class="flex items-center gap-6 mt-4 ml-4">
                        <button onclick="terminateSessionAndLogOut()" class="px-4 py-2 bg-[#F97316] text-black font-bold hover:bg-[#EA580C] transition flex items-center gap-2 font-mono">
                            [ SIGN & EXECUTE HANDOVER ]
                        </button>
                        <button onclick="document.getElementById('shift-handover-modal').remove(); document.querySelectorAll('button[onclick=\\'draftHandoverReport()\\'], button[onclick=\\'initiateLogoutHandover()\\']').forEach(b => b.classList.remove('animate-pulse', 'bg-[#F97316]'));" class="px-4 py-2 border border-[#F97316] text-[#F97316] font-bold hover:bg-[#F97316]/20 transition flex items-center gap-2 font-mono">
                            [ ABORT LOGOUT ]
                        </button>
                    </div>
                    <pre class="whitespace-pre-wrap text-sm leading-relaxed text-[#F97316] font-mono mt-4">└──────────────────────────────────────────────────────────────────────────────┘</pre>
                </div>
            `;
            document.body.appendChild(reportModal);
        }


        function terminateSessionAndLogOut() {
            showToast('Shift Log cryptographically sealed. Terminating session...', 'brand');
            setTimeout(() => {
                window.location.href = 'index.html';
            }, 1500);
        }
        
        function pdfZoom(delta) {
            currentZoom = Math.max(0.5, Math.min(2, currentZoom + delta));
            document.getElementById('zoom-level').textContent = Math.round(currentZoom * 100) + '%';
        }
        
        function pdfPage(delta) { if (!currentPdf) return; }
        
        function verifyResponse(btn) {
            const msg = btn.closest('.msg-ai');
            const msgId = msg.closest('[id^="msg-"]').id;
            msg.classList.add('verified');
            localStorage.setItem('verified-' + msgId, 'true');
            verifiedCount++;
            document.getElementById('verified-count').textContent = verifiedCount;
            saveToStorage();
            showToast('Procedure Verified by Senior Tech', 'brand');
            btn.remove(); // Only verify once - creates scarcity/authority
        }
        
        function openNoteModal(msgId) {
            currentMsgId = msgId;
            document.getElementById('note-modal').classList.remove('hidden');
            document.getElementById('note-text').value = '';
            document.getElementById('note-text').focus();
        }
        
        function hideNoteModal() { document.getElementById('note-modal').classList.add('hidden'); }
        
        function saveNote() {
            const text = document.getElementById('note-text').value.trim();
            if (!text || !currentMsgId) return;
            const container = document.getElementById('notes-' + currentMsgId);
            const note = document.createElement('div');
            note.className = 'text-[10px] text-light-slate bg-white/5 p-2 rounded border-l-2 border-[#F97316]';
            note.innerHTML = `<i class="fas fa-sticky-note mr-1"></i>${text}`;
            container.appendChild(note);
            
            // Save note to localStorage for persistence
            const savedNotes = JSON.parse(localStorage.getItem('indexfield_notes_' + currentMsgId) || '[]');
            savedNotes.push({ text, timestamp: new Date().toISOString() });
            localStorage.setItem('indexfield_notes_' + currentMsgId, JSON.stringify(savedNotes));
            
            notesCount++;
            document.getElementById('notes-count').textContent = notesCount;
            saveToStorage();
            hideNoteModal();
            showToast('Field Note added to Vector Index', 'accent');
            document.getElementById('note-text').value = '';
        }
        
        function loadNotesForMessage(msgId) {
            const savedNotes = JSON.parse(localStorage.getItem('indexfield_notes_' + msgId) || '[]');
            const container = document.getElementById('notes-' + msgId);
            if (container) {
                savedNotes.forEach(n => {
                    const note = document.createElement('div');
                    note.className = 'text-[10px] text-light-slate bg-white/5 p-2 rounded border-l-2 border-[#F97316]';
                    note.innerHTML = `<i class="fas fa-sticky-note mr-1"></i>${n.text}`;
                    container.appendChild(note);
                });
            }
        }
        
        function exportToWorkOrder(msgId, text) {
            const msg = document.getElementById(msgId);
            const sources = msg.dataset.sources ? JSON.parse(msg.dataset.sources) : [];
            const workOrder = {
                procedure: text,
                sources: sources.map(s => `${s.manual_name} p.${s.page_number}`),
                timestamp: new Date().toISOString(),
                verified: msg.querySelector('.msg-ai').classList.contains('verified')
            };
            const blob = new Blob([JSON.stringify(workOrder, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `WorkOrder_${Date.now()}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Exported to Work Order format', 'brand');
        }
        
        function insightsAccountIsEmpty() {
            return filterIndustrialManuals(manuals).length === 0;
        }

        function resetInsightsEmptyState() {
            const totalEl = document.getElementById('total-queries');
            const assetEl = document.getElementById('most-searched-asset');
            const verifiedEl = document.getElementById('verified-rate');
            const verifiedSub = document.getElementById('verified-rate-sub');
            const riskScoreEl = document.getElementById('risk-score');
            const riskStatusEl = document.getElementById('risk-score-status');

            if (totalEl) totalEl.textContent = '0';
            if (assetEl) assetEl.textContent = '--';
            if (verifiedEl) {
                verifiedEl.textContent = '--';
                verifiedEl.className = 'text-2xl font-bold text-slate-400';
            }
            if (verifiedSub) verifiedSub.textContent = 'Awaiting answers';

            if (riskScoreEl) {
                riskScoreEl.textContent = '--';
                riskScoreEl.className = 'text-2xl font-bold text-slate-400';
            }
            if (riskStatusEl) riskStatusEl.textContent = 'Awaiting first upload';
            const savingsTicker = document.getElementById('roi-savings-ticker');
            if (savingsTicker) savingsTicker.textContent = '$0.00';

            const heatmapEmpty = document.getElementById('fault-heatmap-empty');
            const grid = document.getElementById('fault-heatmap-grid');
            if (heatmapEmpty) heatmapEmpty.classList.remove('hidden');
            if (grid) {
                grid.classList.add('hidden');
                grid.innerHTML = '';
            }

            const trendingList = document.getElementById('trending-list');
            if (trendingList) trendingList.innerHTML = renderTrendingIssuesEmptyState();

            const alertsList = document.getElementById('predictive-alerts-list');
            if (alertsList) alertsList.innerHTML = renderPredictiveAlertsEmptyState();

            updateInsightsHeaderCta();
            renderShiftHandoverLog();
        }

        function updateInsightsHeaderCta() {
            const btn = document.getElementById('insights-header-cta');
            if (!btn) return;
            const hasManuals = filterIndustrialManuals(manuals).length > 0;
            if (hasManuals) {
                btn.className = 'px-3 py-1.5 bg-white/5 hover:bg-white/10 rounded text-xs transition inline-flex items-center gap-1.5 text-white';
                btn.innerHTML = '<i class="fas fa-download"></i> Export Executive Summary';
                btn.onclick = exportExecutiveSummaryReport;
                btn.disabled = false;
            } else {
                btn.className = 'px-4 py-2 bg-[#F97316] hover:bg-[#EA580C] text-black font-semibold rounded-lg text-xs transition shadow-[0_0_20px_rgba(249,115,22,0.25)] inline-flex items-center gap-1.5';
                btn.innerHTML = '<i class="fas fa-plus"></i> Upload First Manual';
                btn.onclick = () => showUploadModal();
                btn.disabled = false;
            }
        }

        function renderShiftHandoverLog() {
            const logCard = document.getElementById('shift-handover-log');
            const logContent = document.getElementById('handover-log-content');
            const handoverNoteInput = document.getElementById('handover-note-input');
            const state = localStorage.getItem('shift_handover_note');
            if (!logCard || !logContent) return;
            if (!state) {
                logCard.classList.add('hidden');
                return;
            }

            let note = null;
            try {
                note = JSON.parse(state);
            } catch (err) {
                note = null;
            }

            if (!note) {
                logCard.classList.add('hidden');
                return;
            }

            logCard.classList.remove('hidden');
            logContent.innerHTML = `
                <div class="space-y-3 text-sm">
                    <div class="text-[10px] uppercase tracking-wider font-semibold text-[#22C55E]">${note.category || 'Shift Handover Log'}</div>
                    <div class="text-base font-bold text-white">${note.title || 'Pinned item for next shift'}</div>
                    <div class="text-[11px] text-slate-400">${note.description || 'No description provided.'}</div>
                    ${note.note ? `<div class="mt-3 p-3 bg-slate-900/90 rounded-lg text-[11px] text-slate-200 border border-white/10"><strong class="block text-[10px] uppercase tracking-wider text-slate-400 mb-2">Operator note</strong>${note.note}</div>` : ''}
                    <div class="text-[10px] text-slate-500">Pinned at ${new Date(note.timestamp).toLocaleString()}</div>
                </div>`;
            if (handoverNoteInput) handoverNoteInput.value = note.note || '';
        }

        function pinShiftHandover(el) {
            if (!el || !el.dataset) return;
            const note = {
                category: el.dataset.category || 'Shift Handover Note',
                title: el.dataset.title || 'Pinned issue',
                description: decodeURIComponent(el.dataset.description || ''),
                note: document.getElementById('handover-note-input')?.value.trim() || '',
                timestamp: new Date().toISOString()
            };
            localStorage.setItem('shift_handover_note', JSON.stringify(note));
            renderShiftHandoverLog();
            showToast(`Pinned to Shift Handover: ${note.title}`, 'brand');
        }

        function saveHandoverNote() {
            const state = localStorage.getItem('shift_handover_note');
            if (!state) return;
            let note = null;
            try { note = JSON.parse(state); } catch (err) { note = null; }
            if (!note) return;
            note.note = document.getElementById('handover-note-input')?.value.trim() || note.note || '';
            note.timestamp = new Date().toISOString();
            localStorage.setItem('shift_handover_note', JSON.stringify(note));
            renderShiftHandoverLog();
            showToast('Shift handover note saved.', 'brand');
        }

        function clearShiftHandover() {
            localStorage.removeItem('shift_handover_note');
            renderShiftHandoverLog();
            showToast('Shift handover cleared.', 'accent');
        }

        function exportExecutiveSummaryReport() {
            const data = latestInsightsData || {
                total_queries: 0,
                most_searched_asset: '--',
                verified_answer_rate: 0,
                fleet_risk_score: '--',
                fault_codes: [],
                trending_issues: [],
                predictive_alerts: []
            };
            const rows = [
                ['Executive Summary'],
                ['Generated On', new Date().toLocaleString()],
                ['Total Queries', data.total_queries],
                ['Most Searched Asset', data.most_searched_asset],
                ['Verified Answer Rate', `${Math.round((data.verified_answer_rate || 0) * 100)}%`],
                ['Fleet Risk Score', data.fleet_risk_score || '--'],
                ['Estimated Cost Savings', document.getElementById('roi-savings-ticker')?.textContent || '$0.00'],
                ['Downtime Avoided', document.getElementById('roi-downtime-avoided-val')?.textContent || '0 days'],
                [],
                ['Pinned Shift Handover', getShiftHandoverState() ? 'Yes' : 'No'],
                ['Handover Note', getShiftHandoverState()?.note || '--'],
                [],
                ['Trending Issues'],
                ['Issue Code', 'Description', 'Count', 'Trend']
            ];

            (data.trending_issues || []).forEach(issue => {
                rows.push([issue.code, issue.description, issue.count, issue.trend]);
            });
            rows.push([]);
            rows.push(['Predictive Alerts']);
            rows.push(['Title', 'Message', 'Severity']);
            (data.predictive_alerts || []).forEach(alert => {
                rows.push([alert.title, alert.message, alert.severity]);
            });

            const csv = rows.map(row => row.map(cell => `"${String(cell || '').replace(/"/g, '""')}"`).join(',')).join('\r\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `IndexField_Executive_Summary_${new Date().toISOString().slice(0,10)}.csv`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast('Executive summary downloaded.', 'brand');
        }

        function getShiftHandoverState() {
            try {
                return JSON.parse(localStorage.getItem('shift_handover_note'));
            } catch (err) {
                return null;
            }
        }

        function renderTrendingIssuesEmptyState() {
            return `<div class="text-center py-6">
                <div class="relative inline-flex items-center justify-center mb-4 opacity-25" aria-hidden="true">
                    <i class="fas fa-chart-line text-4xl text-slate-400"></i>
                    <i class="fas fa-slash absolute text-3xl text-slate-500 -rotate-12"></i>
                </div>
                <p class="text-[11px] text-slate-400 font-medium">No trending issues detected.</p>
                <div class="flex flex-wrap items-center justify-center gap-2 mt-4">
                    <button type="button" onclick="showView('chat')" class="px-4 py-2 text-xs font-semibold border border-slate-600 bg-slate-800/50 hover:bg-slate-700/60 hover:border-[#06B6D4]/40 text-slate-100 rounded-lg transition-all inline-flex items-center gap-2">
                        <i class="fas fa-comments text-[#06B6D4]"></i> Go to Ask Questions
                    </button>
                    <button type="button" onclick="showUploadModal()" class="px-4 py-2 text-xs font-semibold border border-slate-600 bg-slate-800/50 hover:bg-slate-700/60 hover:border-[#F97316]/40 text-slate-100 rounded-lg transition-all inline-flex items-center gap-2">
                        <i class="fas fa-cloud-upload-alt text-[#F97316]"></i> Upload a Manual
                    </button>
                </div>
            </div>`;
        }

        function renderPredictiveAlertsEmptyState() {
            return `<div class="p-4 border border-white/10 rounded-lg text-center">
                <div class="flex justify-center mb-3 opacity-40">
                    <i class="fas fa-shield-alt text-4xl text-[#22C55E]" aria-hidden="true"></i>
                </div>
                <p class="text-[11px] text-slate-300 font-medium">System monitoring active. Awaiting data.</p>
                <div class="flex flex-wrap items-center justify-center gap-2 mt-4">
                    <button type="button" onclick="showView('assets')" class="px-4 py-2 text-xs font-semibold border border-slate-600 bg-slate-800/50 hover:bg-slate-700/60 hover:border-[#06B6D4]/40 text-slate-100 rounded-lg transition-all inline-flex items-center gap-2">
                        <i class="fas fa-industry text-[#06B6D4]"></i> Go to Asset Registry
                    </button>
                    <button type="button" onclick="showView('assets'); importAssets()" class="px-4 py-2 text-xs font-semibold border border-slate-600 bg-slate-800/50 hover:bg-slate-700/60 hover:border-[#22C55E]/40 text-slate-100 rounded-lg transition-all inline-flex items-center gap-2">
                        <i class="fas fa-plus-circle text-[#22C55E]"></i> Add Fleet Equipment
                    </button>
                </div>
            </div>`;
        }

        function applyInsightsTopMetrics(insights) {
            const hasManuals = filterIndustrialManuals(manuals).length > 0;
            const totalEl = document.getElementById('total-queries');
            const assetEl = document.getElementById('most-searched-asset');
            const verifiedSub = document.getElementById('verified-rate-sub');
            const verifiedEl = document.getElementById('verified-rate');
            const riskScoreEl = document.getElementById('risk-score');
            const riskScoreStatusEl = document.getElementById('risk-score-status');

            if (totalEl) totalEl.textContent = (insights.total_queries || 0).toLocaleString();
            if (assetEl) assetEl.textContent = insights.most_searched_asset || '--';

            if (verifiedEl) {
                latestInsightsData = insights;
                if (insights.verified_answer_rate > 0) {
                    verifiedEl.textContent = Math.round(insights.verified_answer_rate * 100) + '%';
                    verifiedEl.className = 'text-2xl font-bold text-[#22C55E]';
                    if (verifiedSub) verifiedSub.textContent = 'Senior tech validated';
                } else {
                    verifiedEl.textContent = '--';
                    verifiedEl.className = 'text-2xl font-bold text-slate-400';
                    if (verifiedSub) verifiedSub.textContent = 'Awaiting answers';
                }
            }

            if (riskScoreEl) {
                const score = insights.fleet_risk_score;
                if (hasManuals && score && score !== '--' && score !== 'NOMINAL') {
                    riskScoreEl.textContent = score;
                    riskScoreEl.className = 'text-2xl font-bold text-[#22C55E]';
                    if (riskScoreStatusEl) {
                        riskScoreStatusEl.textContent = (insights.total_queries || 0) > 0
                            ? 'Building baseline'
                            : 'System healthy';
                    }
                } else {
                    riskScoreEl.textContent = '--';
                    riskScoreEl.className = 'text-2xl font-bold text-slate-400';
                    if (riskScoreStatusEl) {
                        riskScoreStatusEl.textContent = (insights.total_queries || 0) > 0
                            ? 'Requires more data'
                            : 'Awaiting first upload';
                    }
                }
            }
        }

        async function generateHeatmap() {
            if (insightsAccountIsEmpty()) {
                resetInsightsEmptyState();
                return;
            }

            try {
                const response = await fetch(`${API_URL}/api/insights`);
                if (!response.ok) throw new Error(`Failed to load insights (${response.status})`);
                const insights = await response.json();

                if ((insights.total_queries || 0) === 0
                    && !(insights.trending_issues && insights.trending_issues.length)
                    && !(insights.fault_codes && insights.fault_codes.length)) {
                    resetInsightsEmptyState();
                    return;
                }

                applyInsightsTopMetrics(insights);
                renderShiftHandoverLog();
                
                // Generate fault code heatmap
                const heatmapEmpty = document.getElementById('fault-heatmap-empty');
                const grid = document.getElementById('fault-heatmap-grid');
                const faultCodes = insights.fault_codes || [];

                if (grid && faultCodes.length > 0) {
                    if (heatmapEmpty) heatmapEmpty.classList.add('hidden');
                    grid.classList.remove('hidden');
                    grid.innerHTML = '';

                    faultCodes.forEach(fault => {
                        const cell = document.createElement('div');
                        cell.className = 'heatmap-cell h-8 rounded-sm cursor-help transition-all hover:ring-2 hover:ring-white';

                        const activity = fault.activity;
                        if (activity > 80) cell.style.backgroundColor = '#F97316';
                        else if (activity > 60) cell.style.backgroundColor = '#64748B';
                        else if (activity > 40) cell.style.backgroundColor = '#475569';
                        else if (activity > 20) cell.style.backgroundColor = '#1F2937';
                        else cell.style.backgroundColor = '#111827';

                        cell.title = `${fault.code}: ${activity} searches this week`;
                        grid.appendChild(cell);
                    });
                } else {
                    if (heatmapEmpty) heatmapEmpty.classList.remove('hidden');
                    if (grid) {
                        grid.classList.add('hidden');
                        grid.innerHTML = '';
                    }
                }
                
                // Trending issues
                const trendingList = document.getElementById('trending-list');
                if (trendingList) {
                    const issues = insights.trending_issues || [];
                    trendingList.innerHTML = issues.length
                        ? issues.map(t =>
                            `<div class="flex items-start justify-between p-3 bg-white/5 rounded ${t.urgent ? 'border-l-2 border-[#F59E0B]' : ''}">
                                <div class="max-w-[70%]"><span class="text-sm font-mono ${t.urgent ? 'text-[#F59E0B]' : 'text-[#F97316]'}">${t.code}</span>
                                <p class="text-[10px] text-light-slate mt-1">${t.description}</p></div>
                                <div class="flex flex-col items-end gap-2 text-right">
                                    <div class="text-sm font-bold">${t.count}</div>
                                    <div class="text-[10px] ${t.trend === 'up' ? 'text-[#F59E0B]' : t.trend === 'down' ? 'text-[#22C55E]' : 'text-light-slate'}">
                                        <i class="fas fa-arrow-${t.trend}"></i> ${t.trend === 'up' ? 'Trending' : t.trend === 'down' ? 'Declining' : 'Stable'}
                                    </div>
                                    <button type="button" onclick="pinShiftHandover(this)" data-category="Trending Issue" data-title="${t.code}" data-description="${encodeURIComponent(t.description)}" class="text-[10px] uppercase tracking-wider px-2 py-1 rounded border border-white/10 bg-slate-900/80 hover:bg-slate-800 transition text-slate-200">Pin to Handover</button>
                                </div>
                            </div>`
                        ).join('')
                        : renderTrendingIssuesEmptyState();
                }

                // Predictive alerts
                const alertsList = document.getElementById('predictive-alerts-list');
                if (alertsList) {
                    const alerts = insights.predictive_alerts || [];
                    alertsList.innerHTML = alerts.length
                        ? alerts.map(alert => `
                            <div class="p-3 bg-${alert.severity === 'warning' ? '[#F59E0B]' : '[#F97316]'}/10 border border-${alert.severity === 'warning' ? '[#F59E0B]' : '[#F97316]'}/30 rounded-lg space-y-3">
                                <div class="flex items-center gap-2 mb-1">
                                    <i class="fas fa-${alert.severity === 'warning' ? 'exclamation-triangle' : 'info-circle'} text-${alert.severity === 'warning' ? '[#F59E0B]' : '[#F97316]'} text-xs"></i>
                                    <span class="text-xs font-medium">${alert.title}</span>
                                </div>
                                <p class="text-[10px] text-light-slate">${alert.message}</p>
                                <button type="button" onclick="pinShiftHandover(this)" data-category="Predictive Alert" data-title="${alert.title}" data-description="${encodeURIComponent(alert.message)}" class="text-[10px] uppercase tracking-wider px-2 py-1 rounded border border-white/10 bg-slate-900/80 hover:bg-slate-800 transition text-slate-200">Pin to Handover</button>
                            </div>`
                        ).join('')
                        : renderPredictiveAlertsEmptyState();
                }
                
            } catch (err) {
                showToast('Failed to load insights: ' + err.message, 'accent');
            }
        }
        
        // ==================== ASSET REGISTRY ====================
        // ==================== ASSET REGISTRY ====================
        // 1. Asset Registry Page (Main Controller) Reactive State Trackers
        let activeMachineList = [];
        let selectedMachineId = null;
        let isShiftHandoverVisible = false;

        function toggleAssetSystemStatus() {
            const drawer = document.getElementById('asset-system-status-drawer');
            const chevron = document.getElementById('asset-system-status-chevron');
            if (!drawer) return;
            drawer.classList.toggle('hidden');
            if (chevron) {
                chevron.classList.toggle('fa-chevron-down', drawer.classList.contains('hidden'));
                chevron.classList.toggle('fa-chevron-up', !drawer.classList.contains('hidden'));
            }
        }

        function renderAssetProtocolPanel() {
            const panel = document.getElementById('asset-protocol-panel');
            const metrics = document.getElementById('asset-protocol-metrics');
            const drawerOpc = document.getElementById('asset-drawer-opc');
            const drawerMqtt = document.getElementById('asset-drawer-mqtt');
            const drawerModbus = document.getElementById('asset-drawer-modbus');
            const hasAssets = activeMachineList.length > 0;
            const streamLive = typeof scadaActive !== 'undefined' && scadaActive;

            if (panel) {
                panel.classList.toggle('opacity-50', !hasAssets);
            }

            if (!metrics) return;

            if (!hasAssets) {
                metrics.innerHTML = `
                    <div class="flex items-center justify-between"><span>Plant Data Link:</span><span class="font-mono text-xs uppercase tracking-wider text-slate-500">STANDBY</span></div>
                    <div class="flex items-center justify-between"><span>Live Stream:</span><span class="font-mono text-xs uppercase tracking-wider text-slate-500">Awaiting Connection</span></div>
                    <div class="flex items-center justify-between"><span>Field Gateway:</span><span class="font-mono text-xs uppercase tracking-wider text-slate-500">Not Connected</span></div>
                `;
                if (drawerOpc) drawerOpc.textContent = 'Standby';
                if (drawerMqtt) drawerMqtt.textContent = 'Standby';
                if (drawerModbus) drawerModbus.textContent = 'Not configured';
                return;
            }

            panel?.classList.remove('opacity-50');
            metrics.innerHTML = `
                <div class="flex items-center justify-between"><span>Plant Data Link:</span><span class="text-[#22C55E] font-mono text-xs">Online & Ready</span></div>
                <div class="flex items-center justify-between"><span>Live Stream:</span><span class="font-mono text-xs ${streamLive ? 'text-[#22C55E]' : 'text-slate-400'}">${streamLive ? 'Connected' : 'Awaiting Connection'}</span></div>
                <div class="flex items-center justify-between"><span>Field Gateway:</span><span class="font-mono text-xs text-slate-400">${streamLive ? 'Receiving data' : 'Standby'}</span></div>
            `;
            if (drawerOpc) drawerOpc.textContent = streamLive ? 'Listening (Port 4840)' : 'Standby';
            if (drawerMqtt) drawerMqtt.textContent = streamLive ? 'Connected — plant/floor1/#' : 'Awaiting Connection';
            if (drawerModbus) drawerModbus.textContent = 'Idle';
        }

        function updateAssetStats() {
            const totalRows = activeMachineList.length;
            const anomalyRows = activeMachineList.filter(a => a.status === 'warning' || a.status === 'offline').length;
            const totalMatch = activeMachineList.reduce((sum, a) => sum + (a.match_percentage || 100), 0);
            const averageMatch = totalRows > 0 ? Math.round(totalMatch / totalRows) : 0;

            const totalAssetsEl = document.getElementById('total-assets');
            const activeAlertsEl = document.getElementById('active-alerts');
            const aiCoverageEl = document.getElementById('ai-coverage');
            const alertsSub = document.getElementById('active-alerts-sub');
            const coverageSub = document.getElementById('ai-coverage-sub');

            if (totalRows === 0) {
                if (totalAssetsEl) {
                    totalAssetsEl.textContent = '0';
                    totalAssetsEl.className = 'text-2xl font-bold text-slate-400';
                }
                if (activeAlertsEl) {
                    activeAlertsEl.textContent = '0';
                    activeAlertsEl.className = 'text-2xl font-bold text-slate-400';
                }
                if (aiCoverageEl) {
                    aiCoverageEl.textContent = '--';
                    aiCoverageEl.className = 'text-2xl font-bold text-slate-400';
                }
                if (alertsSub) alertsSub.textContent = 'System awaiting sync';
                if (coverageSub) coverageSub.textContent = 'System awaiting sync';
                renderAssetProtocolPanel();
                syncPrognosticsView();
                return;
            }

            if (totalAssetsEl) {
                totalAssetsEl.textContent = totalRows;
                totalAssetsEl.className = 'text-2xl font-bold gradient-text';
            }
            if (activeAlertsEl) {
                activeAlertsEl.textContent = anomalyRows;
                activeAlertsEl.className = anomalyRows > 0
                    ? 'text-2xl font-bold text-red-500'
                    : 'text-2xl font-bold text-slate-400';
            }
            if (aiCoverageEl) {
                aiCoverageEl.textContent = `${averageMatch}%`;
                aiCoverageEl.className = 'text-2xl font-bold text-slate-400';
            }
            if (alertsSub) alertsSub.textContent = anomalyRows > 0 ? 'Requires attention' : 'System nominal';
            if (coverageSub) coverageSub.textContent = 'Assets with manuals';
            renderAssetProtocolPanel();
            syncPrognosticsView();
        }
        
        async function loadAssetRegistry() {
            try {
                const response = await fetch(`${API_URL}/assets`);
                activeMachineList = await response.json();
                
                updateAssetStats();
                renderAssetList();
                syncPrognosticsView();
            } catch (err) {
                showToast('Failed to load assets: ' + err.message, 'accent');
            }
        }
        
        function renderAssetList() {
            const list = document.getElementById('asset-list');
            const emptyState = document.getElementById('asset-active-fleet');
            
            // 2. Asset Inventory Grid - Conditional Layout Switch
            if (activeMachineList.length === 0) {
                if (emptyState) emptyState.classList.remove('hidden');
                if (list) list.classList.add('hidden');
                updateAssetStats();
                updateEnvelopeState(false);
                syncPrognosticsView();
                return;
            }
            
            // If populated, completely hide the placeholder graphic
            if (emptyState) emptyState.classList.add('hidden');
            if (list) list.classList.remove('hidden');

            let matrixHtml = `
                <div class="glass-card rounded-xl border border-white/10 overflow-hidden shadow-[0_0_15px_rgba(0,0,0,0.5)]">
                    <table class="w-full text-left text-sm font-mono whitespace-nowrap">
                        <thead class="bg-black/60 text-light-slate text-[10px] uppercase tracking-wider border-b border-white/10">
                            <tr>
                                <th class="px-4 py-3">Status</th>
                                <th class="px-4 py-3">Machine Identifier</th>
                                <th class="px-4 py-3">Criticality Tier</th>
                                <th class="px-4 py-3">Live Telemetry</th>
                                <th class="px-4 py-3">AI Sync</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
            `;

            matrixHtml += activeMachineList.map(asset => {
                const isLoto = asset.status === 'loto';
                const alertState = !isLoto && (asset.status === 'warning' || asset.status === 'offline');
                const sensor = {
                    name: asset.name,
                    value: isLoto ? 0 : Number(asset.value ?? (alertState ? 82 : 37)),
                    min: Number(asset.min ?? 10),
                    max: Number(asset.max ?? 100),
                    alert_threshold: Number(asset.alert_threshold ?? 70),
                    trend: isLoto ? [0,0,0,0] : (asset.trend || [asset.min ?? 10, asset.value ?? 28, asset.value ?? 37, alertState ? (asset.value ?? 82) : (asset.value ?? 52)]),
                    unit: asset.unit || (asset.model?.toLowerCase().includes('temp') ? '°C' : 'mm/s')
                };
                
                if (isLoto) {
                    return `
                        <tr class="bg-[repeating-linear-gradient(45deg,transparent,transparent_10px,rgba(234,179,8,0.1)_10px,rgba(234,179,8,0.1)_20px)] border-l-4 border-yellow-500 opacity-90">
                            <td class="px-4 py-4">
                                <span class="px-2 py-1 bg-yellow-500/20 text-yellow-500 border border-yellow-500/50 rounded text-[10px] font-bold animate-pulse tracking-widest">⚠️ LOTO ACTIVE</span>
                            </td>
                            <td class="px-4 py-4">
                                <div class="font-bold text-yellow-500">${asset.name}</div>
                                <div class="text-[10px] text-yellow-500/70 mt-1">ID: ${asset.id.toUpperCase()} // ${asset.model}</div>
                            </td>
                            <td class="px-4 py-4">
                                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-white/10 text-yellow-500/50">${asset.priority}</span>
                            </td>
                            <td class="px-4 py-4 text-yellow-500 font-bold tracking-widest text-[10px]">[ REMOTE LOCK ENGAGED ]</td>
                            <td class="px-4 py-4"><button class="px-3 py-1 bg-yellow-500 text-black text-[10px] font-bold hover:bg-yellow-400 rounded transition shadow-[0_0_10px_rgba(234,179,8,0.3)]">VIEW PERMIT</button></td>
                        </tr>
                    `;
                }

                const { path, areaPath, envelopeTop, envelopeHeight } = buildSparkline(sensor);
                const statusLabel = alertState ? (sensor.value > sensor.alert_threshold ? 'FAULT' : 'WARNING') : 'HEALTHY';
                const statusPillStyle = alertState ? 'bg-red-500/10 text-red-400 border-red-500/30' : 'bg-[#22C55E]/10 text-[#22C55E] border-[#22C55E]/30';
                const priorityLabel = asset.priority ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold ${asset.priority.includes('Tier 1') ? 'bg-red-500 text-white shadow-[0_0_10px_rgba(239,68,68,0.5)]' : 'bg-white/10 text-light-slate'}">${asset.priority}</span>` : '';
                const trClass = alertState ? 'bg-red-950/10 hover:bg-red-900/20 cursor-pointer transition' : 'hover:bg-white/5 cursor-pointer transition';

                return `
                    <tr class="${trClass}" onclick="selectAsset('${asset.id}')">
                        <td class="px-4 py-4">
                            <span class="px-2 py-1 border rounded text-[10px] font-bold ${statusPillStyle}">${statusLabel}</span>
                        </td>
                        <td class="px-4 py-4">
                            <div class="font-semibold text-white">${asset.name}</div>
                            <div class="text-[10px] text-light-slate mt-1">${asset.model} // ${asset.location}</div>
                        </td>
                        <td class="px-4 py-4">
                            ${priorityLabel}
                        </td>
                        <td class="px-4 py-4 w-48">
                            <div class="flex items-center gap-3">
                                <span class="text-xs ${alertState ? 'text-[#F97316] font-bold animate-pulse' : 'text-slate-300'} w-12">${sensor.value} ${sensor.unit}</span>
                                <div class="relative h-6 w-24 overflow-hidden rounded bg-[#111827] border border-white/5">
                                    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 220 60" preserveAspectRatio="none">
                                        <rect x="0" y="${envelopeTop}" width="220" height="${envelopeHeight}" fill="rgba(6,182,212,0.08)" />
                                        <path d="${areaPath}" fill="rgba(249,115,22,0.08)" />
                                        <path d="${path}" fill="none" stroke="${alertState ? '#F97316' : '#22C55E'}" stroke-width="2" stroke-linecap="round" />
                                    </svg>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-2">
                                <div class="w-16 h-1.5 bg-black rounded-full overflow-hidden border border-white/10">
                                    <div class="h-full bg-[#06B6D4]" style="width: ${asset.match_percentage || 100}%"></div>
                                </div>
                                <span class="text-[10px] text-light-slate">${asset.match_percentage || 100}%</span>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
            
            matrixHtml += `
                        </tbody>
                    </table>
                </div>
            `;
            
            list.innerHTML = matrixHtml;
        }
        
        function selectAsset(assetId) {
            selectedMachineId = assetId;
            showToast(`Loading asset details for ${assetId}...`, 'accent');
            const selectedAsset = activeMachineList.find(a => a.id === assetId);
            updateEnvelopeState(selectedAsset?.status === 'loto');
        }

        function updateEnvelopeState(isLoto = false) {
            const disabledEls = document.querySelectorAll('.smart-envelope-disabled');
            const svgEls = document.querySelectorAll('.smart-envelope-svg');
            
            // 3. Smart Threshold Envelope: Ensure graph hides if no machine is selected
            if (!selectedMachineId) {
                disabledEls.forEach(el => {
                    el.classList.remove('hidden');
                    if (!el.closest('#assets-view')) {
                        el.innerHTML = '<div class="absolute inset-0 flex items-center justify-center font-mono text-light-slate font-bold bg-black/60 backdrop-blur-sm z-20">[ WAITING FOR ASSET SELECTION ]</div>';
                    }
                });
                svgEls.forEach(el => el.classList.add('hidden'));
                return;
            }

            // Check if selected machine is isolated for LOTO
            if (isLoto) {
                disabledEls.forEach(el => {
                    el.classList.remove('hidden');
                    el.innerHTML = '<div class="absolute inset-0 flex items-center justify-center font-mono text-yellow-500 font-bold bg-black/80 backdrop-blur-sm z-20"><span class="animate-pulse">[ SAFE MAINTENANCE MODE: MODELS PAUSED ]</span></div>';
                });
                svgEls.forEach(el => el.classList.add('hidden'));
                return;
            }

            // Display live graph numbers when selected and active
            disabledEls.forEach(el => el.classList.add('hidden'));
            svgEls.forEach(el => el.classList.remove('hidden'));
        }

        function troubleshootAsset(assetId) {
            showToast(`Launching troubleshoot workflow for ${assetId}`, 'brand');
        }

        function queryErrorCode(assetId) {
            showToast(`Querying error code guidance for ${assetId}`, 'accent');
        }
        
        async function importAssets() {
            // Create a simple file input for CSV/JSON import
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.json,.csv';
            input.onchange = async (e) => {
                const file = e.target.files[0];
                if (!file) return;
                
                try {
                    const text = await file.text();
                    let assets;
                    
                    if (file.name.endsWith('.json')) {
                        assets = JSON.parse(text);
                    } else {
                        // Simple CSV parsing - in production use a proper CSV parser
                        showToast('CSV import requires server-side parsing. Please use JSON format.', 'accent');
                        return;
                    }
                    
                    const response = await fetch(`${API_URL}/assets/import`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ assets })
                    });
                    
                    const result = await response.json();
                    if (result.success) {
                        showToast(`Imported ${result.imported_count} assets successfully`, 'brand');
                        loadAssetRegistry();
                    } else {
                        showToast(`Imported ${result.imported_count} assets with ${result.errors.length} errors`, 'accent');
                    }
                } catch (err) {
                    showToast('Failed to import assets: ' + err.message, 'accent');
                }
            };
            input.click();
        }

        function injectDemoAssetStream() {
            const demoAssets = [
                { id: 'demo-01', name: 'Turbine 02', model: 'AX-9000', location: 'Plant Floor 1', status: 'warning', priority: 'Tier 1: Production Critical', value: 85, min: 20, max: 110, alert_threshold: 75, trend: [38, 42, 56, 85], unit: '°C', match_percentage: 100 },
                { id: 'demo-02', name: 'Pump P-101', model: 'TZ-7', location: 'Boiler House', status: 'loto', priority: 'Tier 3: Redundant', value: 0, min: 10, max: 90, alert_threshold: 72, trend: [0, 0, 0, 0], unit: 'mm/s', match_percentage: 92 },
                { id: 'demo-03', name: 'Compressor C4', model: 'CMP-21', location: 'Bay 4', status: 'online', priority: 'Tier 2: Standard', value: 52, min: 10, max: 95, alert_threshold: 70, trend: [44, 47, 50, 52], unit: '°C', match_percentage: 95 }
            ];
            
            // Send data into the activeMachineList tracker
            activeMachineList = demoAssets;
            
            // Instantly trigger calculations and conditional layout switch
            updateAssetStats();
            renderAssetList();
            
            showToast('Demo factory stream injected into Asset Registry', 'brand');
            updateEnvelopeState(false);
            renderAssetProtocolPanel();
            hydrateLoToPage();
            syncPrognosticsView();
            
            // Force evaluate telemetry to catch the Tier 1 critical alert styling
            const classACritical = activeMachineList.some(a => a.priority === 'Tier 1: Production Critical' && (a.status === 'warning' || a.status === 'offline' || Number(a.value) > Number(a.alert_threshold)));
            const activeAlertsEl = document.getElementById('active-alerts');
            const topBar = document.querySelector('header');
            const sidebarOpsBtn = document.getElementById('nav-chat');
            
            if (classACritical) {
                if (topBar) topBar.classList.add('bg-red-900/40', 'border-red-500/30');
                if (sidebarOpsBtn && !document.getElementById('critical-tag-ops')) {
                    sidebarOpsBtn.innerHTML += `<span id="critical-tag-ops" class="ml-auto px-1.5 py-0.5 bg-red-500 text-white text-[8px] font-bold rounded animate-pulse">CRITICAL EXCEPTION</span>`;
                }
                if (activeAlertsEl) activeAlertsEl.className = "text-2xl font-bold text-red-600 animate-pulse drop-shadow-[0_0_8px_rgba(220,38,38,0.8)]";
            }
        }

        // ==================== LOCKOUT / TAGOUT ====================
        let selectedLotoAsset = null;
        let lotoInterlockInterval = null;
        // Checkbox state: step1=electrical, step2=pneumatic, step3=hydraulic
        let lotoChecks = { step1: false, step2: false, step3: false };

        const LOTO_DEMO_ASSETS = [
            { id: 'M-402', name: 'CNC Milling Center', model: 'HAAS VF-4', location: 'Bay 3', status: 'warning', priority: 'Tier 1: Production Critical', elapsed: '0h 22m', phase: 'PENDING ISOLATION', phaseColor: 'text-amber-400 bg-amber-500/10 border-amber-500/30' },
            { id: 'S-901', name: 'Main Spindle Assembly', model: 'Fanuc 30i-B', location: 'Bay 2', status: 'warning', priority: 'Tier 1: Production Critical', elapsed: '0h 08m', phase: 'PENDING ISOLATION', phaseColor: 'text-amber-400 bg-amber-500/10 border-amber-500/30' },
            { id: 'L-118', name: 'Heavy Duty Lathe',   model: 'Mazak QT-250', location: 'Bay 1', status: 'loto',    priority: 'Tier 2: Standard',             elapsed: '1h 47m', phase: 'SECURE',            phaseColor: 'text-[#22C55E] bg-[#22C55E]/10 border-[#22C55E]/30' }
        ];

        function startMockIntervention() {
            const bodyEl = document.getElementById('loto-protocol-body');
            const confEl = document.getElementById('loto-ai-confidence');
            const btn    = document.getElementById('mock-intervention-btn');

            if (btn) {
                btn.disabled = true;
                btn.classList.add('cursor-wait', 'opacity-50');
                btn.innerHTML = 'CREATING MOCK INTERVENTION...';
            }
            if (confEl) {
                confEl.innerHTML = `<span class="text-[#F97316]">LOCAL AI PARSING MANUAL</span> // <span class="text-[#94A3B8]">EXTRACTING SHUTDOWN SEQUENCE</span>`;
            }
            if (bodyEl) {
                bodyEl.classList.remove('dragover-active');
                bodyEl.classList.remove('border-dashed');
                bodyEl.innerHTML = `
                    <div class="flex-1 flex flex-col justify-center items-center gap-4 text-center animate-pulse">
                        <div class="h-4 w-3/4 rounded-full bg-white/10"></div>
                        <div class="h-4 w-2/3 rounded-full bg-white/10"></div>
                        <div class="h-4 w-1/2 rounded-full bg-white/10"></div>
                        <div class="mt-2 text-[11px] text-[#94A3B8] uppercase tracking-[0.3em]">PARSING LOCAL PDF MANUAL...</div>
                        <div class="mt-3 w-24 h-2 rounded-full bg-[#F97316]/30"></div>
                    </div>
                `;
            }

            setTimeout(() => {
                injectLotoDemoAssets();
                if (confEl) confEl.textContent = 'SELECT ASSET TO LOAD PROTOCOL';
                if (btn) {
                    btn.disabled = false;
                    btn.classList.remove('cursor-wait', 'opacity-50');
                    btn.innerHTML = 'Create Mock Intervention';
                }
                setTimeout(() => {
                    selectLotoIntervention('demo-01');
                }, 650);
            }, 2400);
        }

        function injectLotoDemoAssets() {
            const permitsEl = document.getElementById('loto-permits-count');
            const securedEl = document.getElementById('loto-secured-count');
            const countEl   = document.getElementById('loto-intervention-count');
            const listEl    = document.getElementById('loto-intervention-list');

            if (permitsEl) permitsEl.textContent = '3';
            if (securedEl) securedEl.textContent = '1';
            if (countEl)   countEl.textContent = '3 ITEMS';

            if (listEl) {
                listEl.innerHTML = LOTO_DEMO_ASSETS.map(a => `
                    <div id="loto-row-${a.id}" class="p-3 rounded-lg border border-white/10 ${a.status === 'loto' ? 'bg-[repeating-linear-gradient(45deg,transparent,transparent_8px,rgba(234,179,8,0.05)_8px,rgba(234,179,8,0.05)_16px)]' : ''} hover:border-yellow-500/40 cursor-pointer transition-all" onclick="selectLotoDemoAsset('${a.id}')">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[10px] font-mono font-bold text-white">${a.id}</span>
                            <span class="text-[8px] font-mono font-bold px-1.5 py-0.5 rounded border ${a.phaseColor}">${a.phase}</span>
                        </div>
                        <div class="text-xs text-white font-semibold">${a.name}</div>
                        <div class="text-[10px] text-light-slate mt-1">${a.model} // ${a.location}</div>
                        <div class="flex items-center justify-between mt-2">
                            <span class="text-[9px] text-light-slate font-mono"><i class="fas fa-clock mr-1"></i>Offline: ${a.elapsed}</span>
                            <span class="text-[9px] text-light-slate font-mono">${a.priority}</span>
                        </div>
                    </div>
                `).join('');
            }
            // Reset right panel to initial unselected state
            resetInterlockPanel();
        }

        function hydrateLoToPage() {
            const lotoAssets    = activeMachineList.filter(a => a.status === 'loto');
            const warningAssets = activeMachineList.filter(a => a.status === 'warning' || a.status === 'offline');
            const all           = [...lotoAssets, ...warningAssets];
            const permitsEl = document.getElementById('loto-permits-count');
            const securedEl = document.getElementById('loto-secured-count');
            const breachEl  = document.getElementById('loto-breach-count');
            const countEl   = document.getElementById('loto-intervention-count');
            const listEl    = document.getElementById('loto-intervention-list');
            if (permitsEl) permitsEl.textContent = all.length;
            if (securedEl) securedEl.textContent = lotoAssets.length;
            if (breachEl)  breachEl.textContent  = '0';
            if (countEl)   countEl.textContent   = `${all.length} ITEMS`;
            if (listEl && all.length > 0) {
                listEl.innerHTML = all.map(asset => {
                    const isLoto     = asset.status === 'loto';
                    const phase      = isLoto ? 'SECURE - LOTO ACTIVE' : 'PENDING ISOLATION';
                    const phaseColor = isLoto ? 'text-yellow-500 bg-yellow-500/10 border-yellow-500/30' : 'text-red-400 bg-red-500/10 border-red-500/30';
                    const bgStyle    = isLoto ? 'bg-[repeating-linear-gradient(45deg,transparent,transparent_8px,rgba(234,179,8,0.06)_8px,rgba(234,179,8,0.06)_16px)]' : '';
                    const elapsed    = isLoto ? '2h 14m' : '0h 38m';
                    return `
                        <div class="p-3 rounded-lg border border-white/10 ${bgStyle} hover:border-yellow-500/40 cursor-pointer transition-all" onclick="selectLotoIntervention('${asset.id}')">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-[10px] font-mono font-bold text-white">${asset.id.toUpperCase()}</span>
                                <span class="text-[8px] font-mono font-bold px-1.5 py-0.5 rounded border ${phaseColor}">${phase}</span>
                            </div>
                            <div class="text-xs text-white font-semibold">${asset.name}</div>
                            <div class="text-[10px] text-light-slate mt-1">${asset.model} // ${asset.location}</div>
                            <div class="flex items-center justify-between mt-2">
                                <span class="text-[9px] text-light-slate font-mono"><i class="fas fa-clock mr-1"></i>Offline: ${elapsed}</span>
                                <span class="text-[9px] text-light-slate font-mono">${asset.priority}</span>
                            </div>
                        </div>`;
                }).join('');
            }
            resetInterlockPanel();
        }

        let activeDemoAssetId = null;
        function resetInterlockPanel() {
            lotoChecks = { step1: false, step2: false, step3: false };
            if (lotoInterlockInterval) { clearInterval(lotoInterlockInterval); lotoInterlockInterval = null; }
            const voltEl  = document.getElementById('loto-voltage');
            const pressEl = document.getElementById('loto-pressure');
            const rpmEl   = document.getElementById('loto-rpm');
            const authBtn = document.getElementById('loto-authorize-btn');
            const hint    = document.getElementById('loto-auth-hint');
            if (voltEl)  { voltEl.innerHTML  = '--<span class="text-sm text-light-slate ml-1">V</span>';   voltEl.className  = 'text-3xl font-black font-mono tracking-tighter text-light-slate'; }
            if (pressEl) { pressEl.innerHTML = '--<span class="text-sm text-light-slate ml-1">PSI</span>'; pressEl.className = 'text-3xl font-black font-mono tracking-tighter text-light-slate'; }
            if (rpmEl)   { rpmEl.innerHTML   = '--<span class="text-sm text-light-slate ml-1">RPM</span>'; rpmEl.className   = 'text-3xl font-black font-mono tracking-tighter text-light-slate'; }
            
            const voltStatus  = document.getElementById('loto-voltage-status');
            const pressStatus = document.getElementById('loto-pressure-status');
            const rpmStatus   = document.getElementById('loto-rpm-status');
            if (voltStatus)  { voltStatus.innerHTML = 'Disconnected <span class="telemetry-tooltip-trigger cursor-help text-slate-400/70 hover:text-slate-300 transition-colors"><i class="fas fa-info-circle text-[8px]"></i><span class="telemetry-tooltip">Expected Topic: plant/floor1/spindle/voltage<br>OPC UA: ns=2;s=Spindle.Voltage</span></span>'; voltStatus.className = 'mt-1 text-[8px] font-mono tracking-wider uppercase text-amber-500/60 flex items-center justify-center gap-1'; }
            if (pressStatus) { pressStatus.innerHTML = 'Disconnected <span class="telemetry-tooltip-trigger cursor-help text-slate-400/70 hover:text-slate-300 transition-colors"><i class="fas fa-info-circle text-[8px]"></i><span class="telemetry-tooltip">Expected Topic: plant/floor1/hydraulic/pressure<br>OPC UA: ns=2;s=Hydraulic.Pressure</span></span>'; pressStatus.className = 'mt-1 text-[8px] font-mono tracking-wider uppercase text-amber-500/60 flex items-center justify-center gap-1'; }
            if (rpmStatus)   { rpmStatus.innerHTML = 'Disconnected <span class="telemetry-tooltip-trigger cursor-help text-slate-400/70 hover:text-slate-300 transition-colors"><i class="fas fa-info-circle text-[8px]"></i><span class="telemetry-tooltip">Expected Topic: plant/floor1/spindle/rpm<br>OPC UA: ns=2;s=Spindle.RPM</span></span>'; rpmStatus.className = 'mt-1 text-[8px] font-mono tracking-wider uppercase text-amber-500/60 flex items-center justify-center gap-1'; }

            if (authBtn) { authBtn.disabled = true; authBtn.className = 'w-full py-4 bg-slate-950 border-2 border-slate-700/30 text-slate-300 font-mono font-bold uppercase text-sm tracking-widest rounded-lg cursor-not-allowed opacity-100 transition-all'; authBtn.innerHTML = '<i class="fas fa-lock mr-2"></i> AUTHORIZE SAFE ENTRY'; authBtn.onclick = null; }
            if (hint)    { hint.textContent = 'ALL INTERLOCKS MUST READ ZERO BEFORE ENTRY IS AUTHORIZED'; hint.className = 'text-[9px] text-[#FF453A] font-black tracking-wider font-mono text-center uppercase'; }
        }

        function selectLotoDemoAsset(assetId) {
            activeDemoAssetId = assetId;
            // Highlight selected row
            document.querySelectorAll('#loto-intervention-list > div').forEach(r => {
                r.classList.remove('border-yellow-500', 'ring-1', 'ring-yellow-500/30');
            });
            const row = document.getElementById('loto-row-' + assetId);
            if (row) row.classList.add('border-yellow-500', 'ring-1', 'ring-yellow-500/30');

            const asset = LOTO_DEMO_ASSETS.find(a => a.id === assetId);
            if (!asset) return;

            // Update confidence badge
            const confEl = document.getElementById('loto-ai-confidence');
            if (confEl) confEl.innerHTML = `<span class="text-[#06B6D4]">MANUAL EXTRACT SYNC</span> // <span class="text-[#22C55E]">CONFIDENCE: 98.7%</span>`;

            const bodyEl = document.getElementById('loto-protocol-body');
            if (!bodyEl) return;

            if (assetId === 'M-402') {
                // Reset interlock gauges to hot/dangerous state for CNC
                lotoChecks = { step1: false, step2: false, step3: false };
                if (lotoInterlockInterval) { clearInterval(lotoInterlockInterval); lotoInterlockInterval = null; }
                setGauge('loto-voltage', '480', 'V', false);
                setGauge('loto-pressure', '120', 'PSI', false);
                setGauge('loto-rpm', '0', 'RPM', true);
                lockAuthButton();

                bodyEl.innerHTML = `
                    <div class="mb-4 pb-4 border-b border-white/10">
                        <div class="text-[10px] text-light-slate mb-1">TARGET ASSET</div>
                        <div class="text-base font-bold text-white">CNC Milling Center <span class="text-light-slate font-normal text-sm">(HAAS VF-4)</span></div>
                        <div class="text-[10px] text-[#94A3B8] mt-1">Bay 3 // Tier 1: Production Critical</div>
                    </div>
                    <div class="text-[10px] text-[#06B6D4] font-bold uppercase tracking-widest mb-4">EXTRACTED PROTOCOL: OEM MANUAL PG. 412</div>
                    <div class="space-y-3">
                        <div id="loto-step-1" class="flex items-start gap-3 p-3 rounded-lg border border-white/10 bg-white/5 cursor-pointer hover:border-yellow-500/40 transition-all" onclick="toggleLotoStep(1)">
                            <div id="loto-check-1" class="w-6 h-6 rounded border-2 border-white/20 flex items-center justify-center text-xs font-bold mt-0.5 shrink-0 text-light-slate transition-all">1</div>
                            <div class="flex-1">
                                <p class="text-sm text-white">Isolate main 480V electrical breaker at Sub-Panel C.</p>
                                <div class="mt-2 inline-flex items-center gap-2 px-2 py-1 rounded border border-yellow-500/30 text-yellow-500 text-[10px] font-bold font-mono">
                                    <span id="loto-verify-1">[ &nbsp; ]</span> VERIFY AIR GAP
                                </div>
                            </div>
                        </div>
                        <div id="loto-step-2" class="flex items-start gap-3 p-3 rounded-lg border border-white/10 bg-white/5 cursor-pointer hover:border-yellow-500/40 transition-all" onclick="toggleLotoStep(2)">
                            <div id="loto-check-2" class="w-6 h-6 rounded border-2 border-white/20 flex items-center justify-center text-xs font-bold mt-0.5 shrink-0 text-light-slate transition-all">2</div>
                            <div class="flex-1">
                                <p class="text-sm text-white">Close main pneumatic supply valve P-1.</p>
                                <div class="mt-2 inline-flex items-center gap-2 px-2 py-1 rounded border border-yellow-500/30 text-yellow-500 text-[10px] font-bold font-mono">
                                    <span id="loto-verify-2">[ &nbsp; ]</span> ENGAGE MECHANICAL LOCK
                                </div>
                            </div>
                        </div>
                        <div id="loto-step-3" class="flex items-start gap-3 p-3 rounded-lg border border-white/10 bg-white/5 cursor-pointer hover:border-yellow-500/40 transition-all" onclick="toggleLotoStep(3)">
                            <div id="loto-check-3" class="w-6 h-6 rounded border-2 border-white/20 flex items-center justify-center text-xs font-bold mt-0.5 shrink-0 text-light-slate transition-all">3</div>
                            <div class="flex-1">
                                <p class="text-sm text-white">Bleed residual hydraulic pressure via bleeder valve H-4.</p>
                                <div class="mt-2 inline-flex items-center gap-2 px-2 py-1 rounded border border-yellow-500/30 text-yellow-500 text-[10px] font-bold font-mono">
                                    <span id="loto-verify-3">[ &nbsp; ]</span> CONFIRM 0 PSI ON LOCAL GAUGE
                                </div>
                            </div>
                        </div>
                    </div>`;
            } else if (assetId === 'S-901') {
                // Reset interlock gauges to hot/dangerous state for Spindle
                lotoChecks = { step1: false, step2: false, step3: false };
                if (lotoInterlockInterval) { clearInterval(lotoInterlockInterval); lotoInterlockInterval = null; }
                setGauge('loto-voltage', '230', 'V', false);
                setGauge('loto-pressure', '0', 'PSI', true);
                setGauge('loto-rpm', '1800', 'RPM', false);
                lockAuthButton();

                bodyEl.innerHTML = `
                    <div class="mb-4 pb-4 border-b border-white/10">
                        <div class="text-[10px] text-light-slate mb-1">TARGET ASSET</div>
                        <div class="text-base font-bold text-white">Main Spindle Assembly <span class="text-light-slate font-normal text-sm">(Fanuc 30i-B)</span></div>
                        <div class="text-[10px] text-[#94A3B8] mt-1">Bay 2 // Tier 1: Production Critical</div>
                    </div>
                    <div class="text-[10px] text-[#06B6D4] font-bold uppercase tracking-widest mb-4">EXTRACTED PROTOCOL: OEM SERVICE MANUAL PG. 84</div>
                    <div class="space-y-3">
                        <div id="loto-step-1" class="flex items-start gap-3 p-3 rounded-lg border border-white/10 bg-white/5 cursor-pointer hover:border-yellow-500/40 transition-all" onclick="toggleLotoStep(1)">
                            <div id="loto-check-1" class="w-6 h-6 rounded border-2 border-white/20 flex items-center justify-center text-xs font-bold mt-0.5 shrink-0 text-light-slate transition-all">1</div>
                            <div class="flex-1">
                                <p class="text-sm text-white">Power down auxiliary drive unit via Main Control Board Q3.</p>
                                <div class="mt-2 inline-flex items-center gap-2 px-2 py-1 rounded border border-yellow-500/30 text-yellow-500 text-[10px] font-bold font-mono">
                                    <span id="loto-verify-1">[ &nbsp; ]</span> VERIFY VOLTAGE DECAY
                                </div>
                            </div>
                        </div>
                        <div id="loto-step-2" class="flex items-start gap-3 p-3 rounded-lg border border-white/10 bg-white/5 cursor-pointer hover:border-yellow-500/40 transition-all" onclick="toggleLotoStep(2)">
                            <div id="loto-check-2" class="w-6 h-6 rounded border-2 border-white/20 flex items-center justify-center text-xs font-bold mt-0.5 shrink-0 text-light-slate transition-all">2</div>
                            <div class="flex-1">
                                <p class="text-sm text-white">Engage mechanical spindle brake caliper locking pin.</p>
                                <div class="mt-2 inline-flex items-center gap-2 px-2 py-1 rounded border border-yellow-500/30 text-yellow-500 text-[10px] font-bold font-mono">
                                    <span id="loto-verify-2">[ &nbsp; ]</span> VERIFY SPINDLE AT REST (0 RPM)
                                </div>
                            </div>
                        </div>
                        <div id="loto-step-3" class="flex items-start gap-3 p-3 rounded-lg border border-white/10 bg-white/5 cursor-pointer hover:border-yellow-500/40 transition-all" onclick="toggleLotoStep(3)">
                            <div id="loto-check-3" class="w-6 h-6 rounded border-2 border-white/20 flex items-center justify-center text-xs font-bold mt-0.5 shrink-0 text-light-slate transition-all">3</div>
                            <div class="flex-1">
                                <p class="text-sm text-white">Verify Zero Energy state across all primary subsystems.</p>
                                <div class="mt-2 inline-flex items-center gap-2 px-2 py-1 rounded border border-yellow-500/30 text-yellow-500 text-[10px] font-bold font-mono">
                                    <span id="loto-verify-3">[ &nbsp; ]</span> CONFIRM VERIFICATION SIGN-OFF
                                </div>
                            </div>
                        </div>
                    </div>`;
            } else {
                // L-118 is already secured — show all steps done, gauges drain automatically
                lotoChecks = { step1: true, step2: true, step3: true };
                setGauge('loto-voltage', '8.2', 'V', false);
                setGauge('loto-pressure', '5', 'PSI', false);
                setGauge('loto-rpm', '0', 'RPM', true);
                drainGauge('loto-voltage', 8.2, 2.0, 'V', () => drainComplete());
                drainGauge('loto-pressure', 5, 1.5, 'PSI', () => {});

                bodyEl.innerHTML = `
                    <div class="mb-4 pb-4 border-b border-white/10">
                        <div class="text-[10px] text-light-slate mb-1">TARGET ASSET</div>
                        <div class="text-base font-bold text-white">Heavy Duty Lathe <span class="text-light-slate font-normal text-sm">(Mazak QT-250)</span></div>
                        <div class="text-[10px] text-light-slate mt-1">Bay 1 // Tier 2: Standard</div>
                    </div>
                    <div class="text-[10px] text-[#06B6D4] font-bold uppercase tracking-widest mb-4">EXTRACTED PROTOCOL: OEM MANUAL PG. 412</div>
                    <div class="space-y-3">
                        ${[
                            ['Isolate main 480V electrical breaker at Sub-Panel C.', 'VERIFY AIR GAP'],
                            ['Close main pneumatic supply valve P-1.', 'ENGAGE MECHANICAL LOCK'],
                            ['Bleed residual hydraulic pressure via bleeder valve H-4.', 'CONFIRM 0 PSI ON LOCAL GAUGE']
                        ].map((s, i) => `
                        <div class="flex items-start gap-3 p-3 rounded-lg border border-[#22C55E]/20 bg-[#22C55E]/5">
                            <div class="w-6 h-6 rounded bg-[#22C55E] flex items-center justify-center text-xs font-bold mt-0.5 shrink-0 text-black"><i class="fas fa-check"></i></div>
                            <div class="flex-1">
                                <p class="text-sm text-[#22C55E]">${s[0]}</p>
                                <div class="mt-2 inline-flex items-center gap-2 px-2 py-1 rounded border border-[#22C55E]/30 text-[#22C55E] text-[10px] font-bold font-mono">
                                    <span>[ ✓ ]</span> ${s[1]}
                                </div>
                            </div>
                        </div>`).join('')}
                    </div>`;
            }
        }

        function toggleLotoStep(stepNum) {
            const key   = 'step' + stepNum;
            lotoChecks[key] = !lotoChecks[key];
            const checked   = lotoChecks[key];
            const checkEl   = document.getElementById('loto-check-' + stepNum);
            const verifyEl  = document.getElementById('loto-verify-' + stepNum);
            const stepEl    = document.getElementById('loto-step-'  + stepNum);

            if (checkEl) {
                checkEl.className = `w-6 h-6 rounded border-2 flex items-center justify-center text-xs font-bold mt-0.5 shrink-0 transition-all ${checked ? 'bg-[#22C55E] border-[#22C55E] text-black' : 'border-white/20 text-light-slate'}`;
                checkEl.innerHTML = checked ? '<i class="fas fa-check"></i>' : stepNum;
            }
            if (verifyEl) verifyEl.innerHTML = checked ? '[ ✓ ]' : '[ &nbsp; ]';
            if (stepEl) {
                stepEl.className = `flex items-start gap-3 p-3 rounded-lg border cursor-pointer hover:border-yellow-500/40 transition-all ${checked ? 'border-[#22C55E]/20 bg-[#22C55E]/5' : 'border-white/10 bg-white/5'}`;
                const verifyDiv = stepEl.querySelector('.inline-flex');
                if (verifyDiv) verifyDiv.className = `mt-2 inline-flex items-center gap-2 px-2 py-1 rounded border ${checked ? 'border-[#22C55E]/30 text-[#22C55E]' : 'border-yellow-500/30 text-yellow-500'} text-[10px] font-bold font-mono`;
                const textEl = stepEl.querySelector('p');
                if (textEl) textEl.className = `text-sm ${checked ? 'text-[#22C55E]' : 'text-white'}`;
            }

            // Phase 3: Gauge linkage
            if (activeDemoAssetId === 'S-901') {
                if (stepNum === 1) {
                    if (checked) drainGauge('loto-voltage', 230, 40, 'V', checkAllInterlocks);
                    else setGauge('loto-voltage', '230', 'V', false);
                }
                if (stepNum === 2) {
                    if (checked) drainGauge('loto-rpm', 1800, 300, 'RPM', checkAllInterlocks);
                    else setGauge('loto-rpm', '1800', 'RPM', false);
                }
                if (stepNum === 3) {
                    checkAllInterlocks();
                }
            } else {
                if (stepNum === 1) {
                    if (checked) drainGauge('loto-voltage', 480, 80, 'V', checkAllInterlocks);
                    else setGauge('loto-voltage', '480', 'V', false);
                }
                if (stepNum === 2 || stepNum === 3) {
                    const bothChecked = lotoChecks.step2 && lotoChecks.step3;
                    if (bothChecked) drainGauge('loto-pressure', 120, 20, 'PSI', checkAllInterlocks);
                    else setGauge('loto-pressure', '120', 'PSI', false);
                }
            }
        }

        function setGauge(id, val, unit, isSafe) {
            const el = document.getElementById(id);
            if (!el) return;
            el.innerHTML = `${val}<span class="text-sm ${isSafe ? 'text-light-slate' : 'text-red-500'} ml-1">${unit}</span>`;
            el.className = `text-3xl font-black font-mono tracking-tighter ${isSafe ? 'text-[#22C55E]' : 'text-red-500 animate-pulse'}`;
            
            const statusEl = document.getElementById(`${id}-status`);
            if (statusEl) {
                let topic = '';
                let node = '';
                if (id.includes('voltage')) { topic = 'plant/floor1/spindle/voltage'; node = 'ns=2;s=Spindle.Voltage'; }
                else if (id.includes('pressure')) { topic = 'plant/floor1/hydraulic/pressure'; node = 'ns=2;s=Hydraulic.Pressure'; }
                else if (id.includes('rpm')) { topic = 'plant/floor1/spindle/rpm'; node = 'ns=2;s=Spindle.RPM'; }

                statusEl.innerHTML = `
                    <span class="text-green-500 mr-1">&#9679;</span> Live
                    <span class="telemetry-tooltip-trigger cursor-help text-green-500/40 hover:text-green-500 transition-colors"><i class="fas fa-info-circle text-[8px]"></i><span class="telemetry-tooltip">Expected Topic: ${topic}<br>OPC UA: ${node}</span></span>
                `;
                statusEl.className = 'mt-1 text-[8px] font-mono tracking-wider uppercase text-green-500 font-bold flex items-center justify-center gap-1';
            }
        }

        function drainGauge(id, from, step, unit, onZero) {
            let val = from;
            const t = setInterval(() => {
                val = Math.max(0, val - step - Math.random() * (step * 0.4));
                val = Math.round(val * 10) / 10;
                const done = val <= 0;
                const el = document.getElementById(id);
                if (el) {
                    el.innerHTML = `${done ? '0.0' : val}<span class="text-sm ${done ? 'text-light-slate' : 'text-red-500'} ml-1">${unit}</span>`;
                    el.className = `text-3xl font-black font-mono tracking-tighter ${done ? 'text-[#22C55E]' : 'text-red-500 animate-pulse'}`;
                }
                const statusEl = document.getElementById(`${id}-status`);
                if (statusEl) {
                    let topic = '';
                    let node = '';
                    if (id.includes('voltage')) { topic = 'plant/floor1/spindle/voltage'; node = 'ns=2;s=Spindle.Voltage'; }
                    else if (id.includes('pressure')) { topic = 'plant/floor1/hydraulic/pressure'; node = 'ns=2;s=Hydraulic.Pressure'; }
                    else if (id.includes('rpm')) { topic = 'plant/floor1/spindle/rpm'; node = 'ns=2;s=Spindle.RPM'; }

                    statusEl.innerHTML = `
                        <span class="text-green-500 mr-1">&#9679;</span> Live
                        <span class="telemetry-tooltip-trigger cursor-help text-green-500/40 hover:text-green-500 transition-colors"><i class="fas fa-info-circle text-[8px]"></i><span class="telemetry-tooltip">Expected Topic: ${topic}<br>OPC UA: ${node}</span></span>
                    `;
                    statusEl.className = 'mt-1 text-[8px] font-mono tracking-wider uppercase text-green-500 font-bold flex items-center justify-center gap-1';
                }
                if (done) { clearInterval(t); onZero(); }
            }, 300);
        }

        function checkAllInterlocks() {
            // Read current gauge text values
            const vEl = document.getElementById('loto-voltage');
            const pEl = document.getElementById('loto-pressure');
            const rEl = document.getElementById('loto-rpm');
            const vDone = vEl && vEl.textContent.startsWith('0');
            const pDone = pEl && pEl.textContent.startsWith('0');
            const rDone = rEl && rEl.textContent.startsWith('0');
            if (activeDemoAssetId === 'S-901') {
                const step3Done = lotoChecks.step3;
                if (vDone && rDone && step3Done) drainComplete();
            } else {
                if (vDone && pDone && rDone) drainComplete();
            }
        }

        function drainComplete() {
            const authBtn = document.getElementById('loto-authorize-btn');
            const hint    = document.getElementById('loto-auth-hint');
            if (authBtn) {
                authBtn.disabled  = false;
                authBtn.className = 'w-full py-4 bg-[#22C55E] border-2 border-[#22C55E] text-black font-mono font-bold uppercase text-sm tracking-widest rounded-lg cursor-pointer opacity-100 transition-all hover:bg-[#16A34A] shadow-[0_0_25px_rgba(34,197,94,0.4)] animate-pulse';
                authBtn.innerHTML = '<i class="fas fa-lock-open mr-2"></i> AUTHORIZE SAFE ENTRY';
                authBtn.onclick   = () => {
                    showToast('✅ SAFE ENTRY AUTHORIZED. Permit digitally signed.', 'brand');
                    authBtn.innerHTML = '<i class="fas fa-check-circle mr-2"></i> ENTRY AUTHORIZED';
                    authBtn.disabled  = true;
                    authBtn.className = 'w-full py-4 bg-[#22C55E]/20 border-2 border-[#22C55E]/30 text-[#22C55E] font-mono font-bold uppercase text-sm tracking-widest rounded-lg cursor-default opacity-100 transition-all';
                };
            }
            if (hint) {
                hint.textContent = 'ALL INTERLOCKS VERIFIED — ZERO ENERGY STATE CONFIRMED';
                hint.className   = 'text-[9px] text-[#22C55E] font-mono text-center font-bold';
            }
        }

        function lockAuthButton() {
            const authBtn = document.getElementById('loto-authorize-btn');
            const hint    = document.getElementById('loto-auth-hint');
            if (authBtn) { authBtn.disabled = true; authBtn.className = 'w-full py-4 bg-slate-950 border-2 border-slate-700/30 text-slate-300 font-mono font-bold uppercase text-sm tracking-widest rounded-lg cursor-not-allowed opacity-100 transition-all'; authBtn.innerHTML = '<i class="fas fa-lock mr-2"></i> AUTHORIZE SAFE ENTRY'; authBtn.onclick = null; }
            if (hint) { hint.textContent = 'ALL INTERLOCKS MUST READ ZERO BEFORE ENTRY IS AUTHORIZED'; hint.className = 'text-[9px] text-[#FF453A] font-black tracking-wider font-mono text-center uppercase'; }
        }

        function selectLotoIntervention(assetId) {
            selectedLotoAsset = activeMachineList.find(a => a.id === assetId);
            if (!selectedLotoAsset) return;
            document.querySelectorAll('#loto-intervention-list > div').forEach(r => r.classList.remove('border-yellow-500', 'ring-1', 'ring-yellow-500/30'));
            document.querySelectorAll('#loto-intervention-list > div').forEach(r => { if (r.innerHTML.includes(assetId.toUpperCase())) r.classList.add('border-yellow-500', 'ring-1', 'ring-yellow-500/30'); });
            const isLoto    = selectedLotoAsset.status === 'loto';
            const confEl    = document.getElementById('loto-ai-confidence');
            if (confEl) confEl.innerHTML = `<span class="text-[#06B6D4]">MANUAL EXTRACT SYNC</span> // <span class="text-[#22C55E]">CONFIDENCE: 98.7%</span>`;
            if (isLoto) {
                setGauge('loto-voltage', '8.2', 'V', false);
                setGauge('loto-pressure', '5', 'PSI', false);
                setGauge('loto-rpm', '0', 'RPM', true);
                drainGauge('loto-voltage', 8.2, 2.0, 'V', () => drainComplete());
                drainGauge('loto-pressure', 5, 1.5, 'PSI', () => {});
            } else {
                setGauge('loto-voltage', '480', 'V', false);
                setGauge('loto-pressure', '120', 'PSI', false);
                setGauge('loto-rpm', '0', 'RPM', true);
                lockAuthButton();
            }
        }


        // ==================== LIVE TELEMETRY ====================
        let telemetryInterval;
        let currentTelemetry = null;
        let oscStreamInterval = null;
        let aiLogTimeout = null;
        let prognosticsDensity = 'expanded';

        function prognosticsFleetLinked() {
            return Array.isArray(activeMachineList) && activeMachineList.length > 0;
        }

        function prognosticsStatusPill(type, label) {
            const styles = {
                warning: 'bg-yellow-500/10 text-yellow-500 border-yellow-500/20',
                critical: 'bg-red-500/10 text-red-400 border-red-500/20',
                info: 'bg-[#06B6D4]/10 text-[#06B6D4] border-[#06B6D4]/20',
                success: 'bg-[#22C55E]/10 text-[#22C55E] border-[#22C55E]/20',
                neutral: 'bg-white/5 text-slate-400 border-white/10'
            };
            const icons = {
                warning: 'fa-triangle-exclamation',
                critical: 'fa-circle-exclamation',
                info: 'fa-circle-info',
                success: 'fa-circle-check',
                neutral: 'fa-minus'
            };
            const cls = styles[type] || styles.neutral;
            const icon = icons[type] || icons.neutral;
            return `<span class="status-pill border ${cls}"><i class="fas ${icon} text-[8px]" aria-hidden="true"></i>${label}</span>`;
        }

        function setPrognosticsDensity(mode) {
            prognosticsDensity = mode === 'compact' ? 'compact' : 'expanded';
            const active = document.getElementById('prognostics-active');
            const compactBtn = document.getElementById('prog-density-compact');
            const expandedBtn = document.getElementById('prog-density-expanded');
            if (active) {
                active.classList.toggle('prognostics-density-compact', prognosticsDensity === 'compact');
                active.classList.toggle('prognostics-density-expanded', prognosticsDensity === 'expanded');
            }
            if (compactBtn) compactBtn.classList.toggle('active', prognosticsDensity === 'compact');
            if (expandedBtn) expandedBtn.classList.toggle('active', prognosticsDensity === 'expanded');
        }

        function openPrognosticsGlobalSearch() {
            const query = window.prompt('Search assets, maintenance logs, or fault records:');
            if (query && query.trim()) {
                showToast(`Searching fleet records for "${query.trim()}"…`, 'brand');
                showView('assets');
                const search = document.getElementById('asset-search');
                if (search) {
                    search.value = query.trim();
                    search.dispatchEvent(new Event('input', { bubbles: true }));
                }
            }
        }

        function openPrognosticsNotifications() {
            const pending = activeMachineList.filter(a => a.status === 'warning' || a.status === 'offline').length;
            if (pending === 0) {
                showToast('No pending maintenance alerts.', 'brand');
            } else {
                showToast(`${pending} asset(s) require attention. Opening Asset Registry.`, 'accent');
                showView('assets');
            }
        }

        function prognosticsLinkAssets() {
            showView('assets');
            showToast('Connect hardware nodes from Asset Registry.', 'brand');
            setTimeout(() => {
                const fleet = document.getElementById('asset-active-fleet');
                if (fleet) fleet.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 300);
        }

        function renderPrognosticsFleetData() {
            const failuresEl = document.getElementById('prog-metric-failures');
            const sparesEl = document.getElementById('prog-metric-spares');
            const savedEl = document.getElementById('prog-metric-saved');
            const confidenceEl = document.getElementById('prog-ai-confidence');
            const rulRows = document.getElementById('prognostics-rul-rows');
            const actionQueue = document.getElementById('prognostics-action-queue');
            const procurement = document.getElementById('prognostics-procurement-body');
            const erpSync = document.getElementById('prog-erp-sync');

            const atRisk = activeMachineList.filter(a => a.status === 'warning' || a.status === 'offline');
            const avgMatch = activeMachineList.length
                ? Math.round(activeMachineList.reduce((s, a) => s + (a.match_percentage || 0), 0) / activeMachineList.length)
                : 0;

            if (failuresEl) failuresEl.textContent = String(atRisk.length);
            if (sparesEl) sparesEl.textContent = String(atRisk.filter(a => a.status === 'warning').length);
            if (savedEl) savedEl.textContent = atRisk.length ? '—' : '$0';
            if (confidenceEl) {
                confidenceEl.textContent = `AI confidence: ${avgMatch > 0 ? avgMatch + '%' : '—'}`;
                confidenceEl.title = 'Fleet-wide prediction confidence from indexed manuals and telemetry';
            }

            if (rulRows) {
                rulRows.innerHTML = activeMachineList.map(asset => {
                    const wear = Math.min(96, Math.max(8, Math.round(((asset.value - asset.min) / Math.max(asset.max - asset.min, 1)) * 100)));
                    const warnAt = Math.min(92, wear + 12);
                    const failAt = Math.min(98, wear + 22);
                    const barColor = asset.status === 'offline' ? 'bg-red-500' : asset.status === 'warning' ? 'bg-yellow-500' : 'bg-[#06B6D4]';
                    const labelClass = asset.status === 'warning' ? 'text-yellow-500' : asset.status === 'offline' ? 'text-red-400' : 'text-white';
                    const pill = asset.status === 'warning'
                        ? prognosticsStatusPill('warning', 'Watch')
                        : asset.status === 'offline'
                            ? prognosticsStatusPill('critical', 'Critical')
                            : prognosticsStatusPill('success', 'Nominal');
                    return `
                        <div class="prog-rul-row flex flex-wrap items-center gap-3 w-full">
                            <div class="w-full sm:w-[30%] flex items-center justify-between gap-2 pr-2">
                                <span class="text-[10px] font-bold uppercase tracking-wider ${labelClass}">${asset.name}</span>
                                ${pill}
                            </div>
                            <div class="flex-1 min-w-[140px] relative h-4 bg-white/5 rounded overflow-hidden">
                                <div class="absolute inset-0 ${barColor} opacity-80" style="width:${wear}%"></div>
                                <div class="absolute top-0 bottom-0 w-0.5 bg-yellow-500" style="left:${warnAt}%"></div>
                                <div class="absolute top-0 bottom-0 w-1 bg-red-500" style="left:${failAt}%"></div>
                            </div>
                        </div>`;
                }).join('');
            }

            if (actionQueue) {
                if (atRisk.length === 0) {
                    actionQueue.innerHTML = `<p class="text-[11px] text-slate-400 text-center py-8">${prognosticsStatusPill('success', 'Nominal')}<span class="block mt-2">No AI-prescribed actions for this fleet window.</span></p>`;
                } else {
                    actionQueue.innerHTML = atRisk.map(asset => {
                        const isCritical = asset.status === 'offline';
                        const pillType = isCritical ? 'critical' : 'warning';
                        const label = isCritical ? 'Critical Response' : 'Preventative';
                        const border = isCritical ? 'border-red-500/30 bg-red-500/5' : 'border-yellow-500/30 bg-yellow-500/5';
                        const conf = asset.match_percentage || avgMatch;
                        return `
                            <div class="prog-action-card p-3 border ${border} rounded flex flex-col gap-2">
                                <div class="flex justify-between items-center flex-wrap gap-2">
                                    ${prognosticsStatusPill(pillType, label)}
                                    <span class="text-[9px] text-light-slate font-mono">Model: ${conf}%</span>
                                </div>
                                <p class="text-xs text-white">Review <span class="font-bold">${asset.name}</span> at ${asset.location} — telemetry ${asset.status === 'offline' ? 'offline' : 'outside nominal band'}.</p>
                            </div>`;
                    }).join('');
                }
            }

            if (procurement) {
                procurement.innerHTML = atRisk.length
                    ? `<p class="py-6">${prognosticsStatusPill('info', 'ERP Pending')}<span class="block mt-2 text-slate-400">Link procurement integration to auto-stage spares for flagged assets.</span></p>`
                    : `<p class="py-6">${prognosticsStatusPill('success', 'Clear')}<span class="block mt-2">No open spare-part requests.</span></p>`;
            }
            if (erpSync) {
                erpSync.textContent = atRisk.length ? 'ALERTS PENDING' : 'SYNC READY';
                erpSync.className = atRisk.length
                    ? 'text-[9px] text-yellow-500 font-bold tracking-widest'
                    : 'text-[9px] text-[#22C55E] font-bold tracking-widest';
            }
        }

        function syncPrognosticsView() {
            const linked = prognosticsFleetLinked();
            const overlay = document.getElementById('prognostics-onboarding-overlay');
            const active = document.getElementById('prognostics-active');
            const skeleton = document.getElementById('prognostics-skeleton');
            const chip = document.getElementById('prognostics-status-chip');
            const detail = document.getElementById('prognostics-health-detail');
            const notifBadge = document.getElementById('prog-notif-badge');
            const pending = activeMachineList.filter(a => a.status === 'warning' || a.status === 'offline').length;

            if (overlay) overlay.classList.toggle('hidden', linked);
            if (active) active.classList.toggle('hidden', !linked);
            if (skeleton) skeleton.classList.toggle('opacity-20', linked);

            if (chip) {
                chip.textContent = linked ? 'FORECAST ACTIVE' : 'FORECAST STANDBY';
                chip.className = linked
                    ? 'text-[10px] uppercase px-3 py-1.5 bg-[#22C55E]/10 rounded border border-[#22C55E]/30 font-mono text-[#22C55E] font-bold tracking-widest whitespace-nowrap'
                    : 'text-[10px] uppercase px-3 py-1.5 bg-white/5 rounded border border-white/10 font-mono text-slate-400 font-bold tracking-widest whitespace-nowrap';
            }
            if (detail) {
                detail.textContent = linked
                    ? `${activeMachineList.length} asset(s) under lifecycle monitoring.`
                    : 'Predictive models loaded and ready.';
            }
            if (notifBadge) {
                if (pending > 0) {
                    notifBadge.textContent = String(pending);
                    notifBadge.classList.remove('hidden');
                } else {
                    notifBadge.classList.add('hidden');
                }
            }
            if (linked) renderPrognosticsFleetData();
            setPrognosticsDensity(prognosticsDensity);
        }

        function syncTelemetryOpsView() {
            const view = document.getElementById('telemetry-view');
            const hasFleet = prognosticsFleetLinked();
            if (view) view.classList.toggle('telemetry-stream-active', scadaActive);

            const countBadge = document.getElementById('connected-sensors-count');
            const oscBadge = document.getElementById('osc-live-badge');
            const caption = document.getElementById('osc-chart-caption');
            const scanLine = document.getElementById('osc-scan-line');
            const titlePulse = document.getElementById('telemetry-title-pulse');
            const detail = document.getElementById('telemetry-health-detail');
            const normalBand = document.getElementById('osc-normal-band');

            if (countBadge) {
                if (scadaActive) countBadge.textContent = 'Live stream active';
                else if (hasFleet) countBadge.textContent = 'Awaiting live link';
                else countBadge.textContent = 'Awaiting asset link';
            }
            if (oscBadge) {
                if (scadaActive) {
                    oscBadge.textContent = '● LIVE SYNC';
                    oscBadge.className = 'text-[10px] uppercase px-2 py-1 bg-[#22C55E]/10 rounded border border-[#22C55E]/30 font-mono text-[#22C55E] animate-pulse';
                } else {
                    oscBadge.textContent = '○ STANDING BY';
                    oscBadge.className = 'text-[10px] uppercase px-2 py-1 bg-white/5 rounded border border-white/10 font-mono text-slate-400';
                }
            }
            if (caption) {
                caption.textContent = scadaActive
                    ? 'Live waveform — shaded band = normal operating range'
                    : (hasFleet ? 'Initiate Live Link to begin streaming' : 'Awaiting asset link');
            }
            if (scanLine) {
                const live = scadaActive;
                scanLine.classList.toggle('hidden', !live);
                if (live) scanLine.className = 'absolute top-0 bottom-0 w-0.5 bg-[#22C55E]/50 left-[95%] shadow-[0_0_10px_#22C55E]';
            }
            if (titlePulse) {
                titlePulse.className = scadaActive
                    ? 'w-3 h-3 rounded-full bg-[#22C55E] status-pulse'
                    : 'w-3 h-3 rounded-full bg-slate-500 status-pulse';
            }
            if (detail) {
                detail.innerHTML = scadaActive
                    ? 'IndexField is active on this node. <span class="text-slate-300">Monitoring live plant data.</span>'
                    : `IndexField is active on this node. <span class="text-slate-400 text-[10px]">${hasFleet ? 'Fleet linked — connect telemetry when ready.' : 'Awaiting asset link.'}</span>`;
            }
            if (normalBand) {
                normalBand.setAttribute('fill', scadaActive ? 'rgba(34, 197, 94, 0.07)' : 'rgba(148, 163, 184, 0.04)');
            }

            if (!scadaActive) {
                resetTelemetryGauges();
                resetTelemetryAnomalyTicker();
                resetAiTerminalStandby();
                const tempPath = document.getElementById('osc-temperature');
                const vibPath = document.getElementById('osc-vibration');
                if (tempPath) tempPath.setAttribute('d', 'M0,100 L1000,100');
                if (vibPath) vibPath.setAttribute('d', 'M0,100 L1000,100');
            }
        }

        function resetTelemetryGauges() {
            const gaugeSpindle = document.getElementById('gauge-spindle');
            const gaugeCoolant = document.getElementById('gauge-coolant');
            const gaugeFlow = document.getElementById('gauge-flow');
            if (gaugeSpindle) gaugeSpindle.innerHTML = '—<span class="text-sm text-light-slate ml-1">%</span>';
            if (gaugeCoolant) gaugeCoolant.innerHTML = '—<span class="text-sm text-light-slate ml-1">PSI</span>';
            if (gaugeFlow) gaugeFlow.innerHTML = '—<span class="text-base text-light-slate ml-2">L/min</span>';
            ['gauge-spindle-trend', 'gauge-coolant-trend'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = '<i class="fas fa-minus"></i>';
            });
        }

        function resetTelemetryAnomalyTicker() {
            const ticker = document.getElementById('telemetry-anomaly-ticker');
            if (!ticker) return;
            ticker.innerHTML = `
                <li class="telemetry-anomaly-standby flex gap-2 text-slate-400 py-2 items-start">
                    <span class="ready-dot shrink-0 mt-1" style="width:5px;height:5px;"></span>
                    <span class="italic">No anomalies recorded — awaiting live link</span>
                </li>`;
        }

        function resetAiTerminalStandby() {
            const feed = document.getElementById('ai-terminal-feed');
            if (!feed) return;
            feed.innerHTML = `
                <div id="ai-terminal-standby" class="text-slate-400 text-[11px] leading-relaxed">
                    <span class="text-[#22C55E]/80">&gt;</span> Monitoring engine <span class="text-[#22C55E]">online</span>.<br>
                    <span class="text-[#22C55E]/80">&gt;</span> <span class="text-slate-300">Awaiting telemetry stream.</span>
                </div>`;
        }
        
        async function fetchTelemetry() {
            try {
                const response = await fetch(`${API_URL}/telemetry`);
                currentTelemetry = await response.json();
                if (!currentTelemetry?.sensors?.length && !scadaActive) {
                    syncTelemetryOpsView();
                    return;
                }
                renderTelemetry(currentTelemetry);
                
                if (currentTelemetry.anomaly_detected) {
                    showToast('Anomaly detected in telemetry data', 'accent');
                }
                if (currentTelemetry && currentTelemetry.sensors && currentTelemetry.sensors.length > 0) {
                    updateEnvelopeState(true);
                }
            } catch (err) {
                console.error('Failed to fetch telemetry:', err);
            }
        }
        
        function buildSparkline(sensor) {
            const values = sensor.trend && sensor.trend.length >= 4
                ? sensor.trend
                : [
                    sensor.min + (sensor.value - sensor.min) * 0.15,
                    sensor.min + (sensor.value - sensor.min) * 0.4,
                    sensor.value,
                    sensor.value + (sensor.max - sensor.value) * 0.08
                ];
            const maxValue = Math.max(...values, sensor.max, sensor.alert_threshold || sensor.max);
            const minValue = Math.min(...values, sensor.min);
            const points = values.map((value, index) => {
                const x = index * (220 / (values.length - 1));
                const y = 56 - ((value - minValue) / Math.max(maxValue - minValue, 1)) * 40;
                return { x, y };
            });
            const path = points.map((point, index) => `${index === 0 ? 'M' : 'L'} ${point.x} ${point.y}`).join(' ');
            const areaPath = `${path} L 220 56 L 0 56 Z`;
            const envelopeLow = sensor.min + (sensor.max - sensor.min) * 0.25;
            const envelopeHigh = sensor.min + (sensor.max - sensor.min) * 0.75;
            const envelopeTop = 56 - ((envelopeHigh - minValue) / Math.max(maxValue - minValue, 1)) * 40;
            const envelopeBottom = 56 - ((envelopeLow - minValue) / Math.max(maxValue - minValue, 1)) * 40;
            const envelopeHeight = Math.max(10, envelopeBottom - envelopeTop);
            return { path, areaPath, envelopeTop, envelopeHeight };
        }
        
        let oscTempData = Array(50).fill(68.0);
        let oscVibData = Array(50).fill(3.0);
        let scadaActive = false;

        function connectDataStream() {
            if (scadaActive) return;
            scadaActive = true;
            syncTelemetryOpsView();
            
            showToast('Live link initiated. Monitoring plant floor sensors…', 'brand');
            document.getElementById('data-stream-modal')?.classList.add('hidden');
            if (currentView === 'assets') renderAssetProtocolPanel();

            // 1. Oscilloscope Engine
            const tempPath = document.getElementById('osc-temperature');
            const vibPath = document.getElementById('osc-vibration');

            if (oscStreamInterval) clearInterval(oscStreamInterval);
            oscStreamInterval = setInterval(() => {
                // Generate bounded data
                const lastTemp = oscTempData[oscTempData.length - 1];
                let newTemp = lastTemp + (Math.random() - 0.5) * 1.5;
                if (newTemp < 65.0) newTemp = 65.0;
                if (newTemp > 72.0) newTemp = 72.0;

                let newVib = 2.0 + Math.random() * 2.5; // Noisier oscillation 2.0 to 4.5

                oscTempData.push(newTemp);
                oscTempData.shift();

                oscVibData.push(newVib);
                oscVibData.shift();

                // Draw SVG paths (Width 1000, Height 200)
                if (tempPath && vibPath) {
                    const dx = 1000 / (oscTempData.length - 1);
                    // Map Temp 60-80 to Y 200-0
                    const tempD = oscTempData.map((val, i) => `${i === 0 ? 'M' : 'L'}${i * dx},${200 - ((val - 60) / 20 * 200)}`).join(' ');
                    tempPath.setAttribute('d', tempD);

                    // Map Vib 0-6 to Y 200-0
                    const vibD = oscVibData.map((val, i) => `${i === 0 ? 'M' : 'L'}${i * dx},${200 - ((val) / 6 * 200)}`).join(' ');
                    vibPath.setAttribute('d', vibD);
                }

                // 2. Instantaneous Gauges
                const gaugeSpindle = document.getElementById('gauge-spindle');
                const gaugeCoolant = document.getElementById('gauge-coolant');
                const gaugeFlow = document.getElementById('gauge-flow');

                if (gaugeSpindle) {
                    const spindle = (42.0 + Math.random() * 6.0).toFixed(1);
                    gaugeSpindle.innerHTML = `${spindle}<span class="text-sm text-light-slate ml-1">%</span>`;
                }
                const spindleTrend = document.getElementById('gauge-spindle-trend');
                if (spindleTrend) {
                    const dir = Math.random() > 0.55 ? 'up' : Math.random() > 0.5 ? 'down' : 'flat';
                    spindleTrend.className = 'text-slate-500 text-xs';
                    spindleTrend.innerHTML = dir === 'up'
                        ? '<i class="fas fa-arrow-up"></i>'
                        : dir === 'down'
                            ? '<i class="fas fa-arrow-down"></i>'
                            : '<i class="fas fa-minus"></i>';
                }

                if (gaugeCoolant) {
                    const coolant = Math.round(40 + (Math.random() > 0.5 ? 1 : -1) * Math.random() * 1.5);
                    gaugeCoolant.innerHTML = `${coolant}<span class="text-sm text-light-slate ml-1">PSI</span>`;
                }
                const coolantTrend = document.getElementById('gauge-coolant-trend');
                if (coolantTrend) {
                    const dir = Math.random() > 0.5 ? 'up' : 'down';
                    coolantTrend.className = 'text-slate-500 text-xs';
                    coolantTrend.innerHTML = dir === 'up'
                        ? '<i class="fas fa-arrow-up"></i>'
                        : '<i class="fas fa-arrow-down"></i>';
                }

                if (gaugeFlow) {
                    const flow = (12.4 + Math.random() * 0.2).toFixed(1);
                    gaugeFlow.innerHTML = `${flow}<span class="text-base text-light-slate ml-2">L/min</span>`;
                }
            }, 500);

            // 3. AI Anomaly Stream
            const terminalFeed = document.getElementById('ai-terminal-feed');
            if (terminalFeed) {
                terminalFeed.innerHTML = `<div>> <span class="text-white font-bold">[ CONNECTED ]</span> Establishing handshake with local node... <span class="text-[#22C55E]">SUCCESS</span>.</div>`;
                
                const phrases = [
                    "> Analyzing harmonic resonance... Baseline nominal.",
                    "> Thermal envelope steady.",
                    "> Minor pressure fluctuation detected... within safe tolerances.",
                    "> Checking OPC-UA packets... synchronization active.",
                    "> Verifying telemetry signatures... match 99.8%.",
                    "> Spindle load optimal... awaiting phase shift.",
                    "> [ROUTINE] Sweeping historical records... no anomalies."
                ];

                function pushAiLog() {
                    const phrase = phrases[Math.floor(Math.random() * phrases.length)];
                    const time = new Date().toTimeString().split(' ')[0];
                    const logEntry = document.createElement('div');
                    logEntry.innerHTML = `<span class="text-light-slate">[${time}]</span> ${phrase}`;
                    terminalFeed.appendChild(logEntry);
                    
                    // Auto-scroll to bottom
                    terminalFeed.scrollTop = terminalFeed.scrollHeight;
                    
                    // Fire next log in 4-8 seconds
                    const nextTick = 4000 + Math.random() * 4000;
                    aiLogTimeout = setTimeout(pushAiLog, nextTick);
                }
                
                // Start AI loop shortly after connection
                aiLogTimeout = setTimeout(pushAiLog, 2000);
            }
            syncTelemetryOpsView();
        }

        function closeDataStreamModal() {
            document.getElementById('data-stream-modal')?.classList.add('hidden');
        }

        async function connectLiveUrl() {
            const urlInput = document.getElementById('live-stream-url');
            const url = urlInput?.value?.trim();
            if (!url) {
                showToast('Enter an MQTT/WebSocket URL to connect.', 'accent');
                return;
            }

            closeDataStreamModal();
            showToast(`Connecting to ${url}...`, 'brand');

            currentTelemetry = currentTelemetry || { sensors: [], alerts: [] };
            currentTelemetry.protocols = [
                { label: 'OPC UA Server Bridge', value: 'LISTENING (Port 4840)', state: 'good' },
                { label: 'Modbus TCP Broker', value: 'IDLE', state: 'idle' },
                { label: 'MQTT Data Ingestion Stream', value: `CONNECTED (${url.includes('mqtt') ? 'Topic: plant/floor1/#' : 'Streaming JSON'})`, state: 'good' }
            ];
            renderTelemetry(currentTelemetry);
            updateEnvelopeState(true);
        }

        function uploadDemoTelemetryFile() {
            closeDataStreamModal();
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.json,.csv';
            input.onchange = async (event) => {
                const file = event.target.files[0];
                if (!file) return;

                const text = await file.text();
                let payload;
                if (file.name.endsWith('.json')) {
                    try {
                        payload = JSON.parse(text);
                    } catch (err) {
                        showToast('Invalid telemetry JSON file.', 'accent');
                        return;
                    }
                } else {
                    payload = parseTelemetryCSV(text);
                    if (!payload) {
                        showToast('CSV import failed. Expect comma-separated sensor rows.', 'accent');
                        return;
                    }
                }

                loadTelemetryPayload(payload);
                showToast('Telemetry stream loaded from file.', 'brand');
            };
            input.click();
        }

        function loadTelemetryPayload(payload) {
            if (!payload || !payload.sensors) {
                showToast('Telemetry file must include sensor data.', 'accent');
                return;
            }

            currentTelemetry = {
                ...payload,
                connected_count: payload.sensors.length,
                anomaly_detected: payload.sensors.some(s => Number(s.value) > Number(s.alert_threshold) || s.status === 'warning'),
                alerts: payload.alerts || []
            };
            renderTelemetry(currentTelemetry);
            updateEnvelopeState(true);
        }

        function parseTelemetryCSV(text) {
            const lines = text.trim().split(/\r?\n/).filter(Boolean);
            if (lines.length < 2) return null;
            const headers = lines[0].split(',').map(header => header.trim());
            const sensors = lines.slice(1).map(line => {
                const cols = line.split(',').map(col => col.trim());
                const row = {};
                headers.forEach((header, index) => {
                    row[header.toLowerCase()] = cols[index] || '';
                });
                return {
                    id: row.id || `sensor-${Math.random().toString(36).slice(2, 6)}`,
                    name: row.name || row.sensor || 'Unknown Sensor',
                    value: parseFloat(row.value) || 0,
                    unit: row.unit || row.u || '',
                    min: parseFloat(row.min) || 0,
                    max: parseFloat(row.max) || 100,
                    alert_threshold: parseFloat(row.alert_threshold || row.threshold) || 100,
                    status: row.status || 'normal',
                    timestamp: row.timestamp || new Date().toISOString()
                };
            });
            return { sensors };
        }

        function renderTelemetry(telemetry) {
            const grid = document.getElementById('sensor-grid');
            const insightsDiv = document.getElementById('ai-insights');
            const countBadge = document.getElementById('connected-sensors-count');
            const statusBadge = document.getElementById('telemetry-status-badge');
            const protocolStatus = document.getElementById('protocol-status');
            const protocolMetrics = document.getElementById('protocol-metrics');

            if (!telemetry?.sensors?.length) {
                if (!scadaActive) syncTelemetryOpsView();
                return;
            }

            const protocols = telemetry.protocols || [
                { label: 'OPC UA Server Bridge', value: 'LISTENING (Port 4840)', state: 'good' },
                { label: 'Modbus TCP Broker', value: 'IDLE', state: 'idle' },
                { label: 'MQTT Data Ingestion Stream', value: 'CONNECTED (Topic: plant/floor1/#)', state: 'good' }
            ];

            if (countBadge) {
                countBadge.textContent = `Connected: ${telemetry.connected_count || telemetry.sensors.length}`;
            }

            if (statusBadge) {
                const anomaly = telemetry.anomaly_detected;
                statusBadge.textContent = anomaly ? 'FAULT' : 'Nominal';
                statusBadge.className = `text-[10px] uppercase px-2 py-1 rounded font-semibold ${anomaly ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 'bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/20'}`;
            }

            if (grid) grid.innerHTML = telemetry.sensors.map(sensor => {
                const isAlert = sensor.value > sensor.alert_threshold || sensor.status === 'warning';
                const { path, areaPath, envelopeTop, envelopeHeight } = buildSparkline(sensor);
                const manualReference = sensor.name.toLowerCase().includes('vibration')
                    ? { title: '"Section 8.3: Bearing Realignment"', page: '142', action: 'VIBRATION SPIKE -> Contained in Manual:' }
                    : sensor.name.toLowerCase().includes('temp')
                        ? { title: '"Section 5.4: Cooling Loops"', page: '87', action: 'TEMP RISE -> Contained in Manual:' }
                        : { title: '"Section 2.1: System Overview"', page: '34', action: 'Anomaly Detected -> Matched to Manual:' };
                const statusLabel = isAlert ? (sensor.value > sensor.alert_threshold ? 'FAULT' : 'WARNING') : 'HEALTHY';
                const alertChip = isAlert ? `
                    <div class="mt-4 inline-flex items-center gap-2 flex-wrap px-3 py-2 rounded-full bg-[#F97316]/10 text-[#F97316] border border-[#F97316]/20 text-[10px] font-semibold">
                        <span>⚠️</span>
                        <span>${manualReference.action}</span>
                        <a href="#" class="underline font-semibold">${manualReference.title}</a>
                        <span class="text-light-slate">(p. ${manualReference.page})</span>
                    </div>
                ` : '';

                return `
                    <div class="glass-card p-4 rounded-2xl border ${isAlert ? 'border-red-500/30 bg-red-950/10' : 'border-white/10'}" data-sensor-id="${sensor.id}">
                        <div class="flex items-start justify-between gap-3 mb-4">
                            <div>
                                <p class="text-[10px] text-light-slate uppercase tracking-widest">${sensor.name}</p>
                                <div class="text-xl font-bold ${isAlert ? 'text-red-400' : 'text-white'} sensor-value">${sensor.value.toFixed(1)} <span class="text-xs font-normal text-light-slate">${sensor.unit}</span></div>
                            </div>
                            <span class="px-2 py-1 rounded-full text-[10px] font-semibold ${isAlert ? 'bg-red-500/10 text-red-400' : 'bg-[#22C55E]/10 text-[#22C55E]' }">${statusLabel}</span>
                        </div>
                        <div class="relative h-20 overflow-hidden rounded-xl bg-[#111827] border border-white/5">
                            <svg class="absolute inset-0 w-full h-full" viewBox="0 0 220 60" preserveAspectRatio="none">
                                <rect x="0" y="${envelopeTop}" width="220" height="${envelopeHeight}" fill="rgba(6,182,212,0.08)" />
                                <path d="${areaPath}" fill="rgba(249,115,22,0.08)" />
                                <path d="${path}" fill="none" stroke="${isAlert ? '#F97316' : '#22C55E'}" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </div>
                        ${alertChip}
                    </div>
                `;
            }).join('');

            // Criticality Matrix Update
            const classACritical = telemetry.sensors && telemetry.sensors.some(a => a.priority === 'Tier 1: Production Critical' && (a.status === 'warning' || a.status === 'offline' || Number(a.value) > Number(a.alert_threshold)));
            const topBar = document.querySelector('header');
            const sidebarOpsBtn = document.getElementById('nav-chat');
            const activeAlertsEl = document.getElementById('active-alerts');
            
            if (classACritical) {
                if (topBar) topBar.classList.add('bg-red-900/40', 'border-red-500/30');
                if (sidebarOpsBtn && !document.getElementById('critical-tag-ops')) {
                    sidebarOpsBtn.innerHTML += `<span id="critical-tag-ops" class="ml-auto px-1.5 py-0.5 bg-red-500 text-white text-[8px] font-bold rounded animate-pulse">CRITICAL EXCEPTION</span>`;
                }
                if (activeAlertsEl) activeAlertsEl.className = "text-2xl font-bold text-red-600 animate-pulse drop-shadow-[0_0_8px_rgba(220,38,38,0.8)]";
            } else {
                if (topBar) topBar.classList.remove('bg-red-900/40', 'border-red-500/30');
                const tag = document.getElementById('critical-tag-ops');
                if (tag) tag.remove();
                if (activeAlertsEl) activeAlertsEl.className = "text-2xl font-bold text-slate-400";
            }

            const protocolMetricsHtml = protocols.map(protocol => {
                let valHtml = protocol.value;
                if (protocol.label.includes('OPC UA')) {
                    valHtml = `LISTENING (Port 4840) <span class="inline-block w-1.5 h-1.5 bg-[#22C55E] rounded-full ml-1.5 animate-pulse" style="box-shadow: 0 0 8px #22C55E;"></span>`;
                } else if (protocol.label.includes('MQTT') && protocol.value.includes('CONNECTED')) {
                    const speed = typeof isEngineThrottled !== 'undefined' && isEngineThrottled ? (1.0 + Math.random() * 0.3).toFixed(1) : (3.5 + Math.random() * 1.5).toFixed(1);
                    const msgs = typeof isEngineThrottled !== 'undefined' && isEngineThrottled ? Math.floor(4 + Math.random() * 3) : Math.floor(20 + Math.random() * 15);
                    const throttleMsg = typeof isEngineThrottled !== 'undefined' && isEngineThrottled ? `<span class="text-yellow-500 text-[10px] ml-2 animate-pulse">[ ENGINE THROTTLED FOR STABILITY ]</span>` : '';
                    valHtml = `CONNECTED (Topic: plant/floor1/#) <span class="text-xs ${typeof isEngineThrottled !== 'undefined' && isEngineThrottled ? 'text-yellow-500' : 'text-[#06B6D4]/90'} font-mono ml-1.5">[ ${speed} kB/s | ${msgs} msg/s ]</span>${throttleMsg}`;
                }
                return `
                <div class="flex items-center justify-between text-sm ${protocol.state === 'idle' ? 'text-light-slate' : protocol.state === 'good' ? 'text-[#22C55E]' : 'text-red-400'}">
                    <span>${protocol.label}:</span>
                    <span>${valHtml}</span>
                </div>
                `;
            }).join('');

            if (protocolStatus) {
                protocolStatus.innerHTML = protocolMetricsHtml;
            }

            const assetProtocolMetrics = document.getElementById('asset-protocol-metrics');
            if (assetProtocolMetrics && currentView === 'assets') {
                renderAssetProtocolPanel();
            } else if (assetProtocolMetrics) {
                assetProtocolMetrics.innerHTML = protocolMetricsHtml;
            }

            if (protocolMetrics) {
                protocolMetrics.innerHTML = protocolMetricsHtml;
            }

            if (insightsDiv && telemetry.alerts && telemetry.alerts.length > 0) {
                insightsDiv.innerHTML = telemetry.alerts.map(alert => `
                    <div class="p-3 bg-red-500/10 border border-red-500/30 rounded-lg">
                        <div class="flex items-center gap-2 mb-1">
                            <i class="fas fa-exclamation-triangle text-red-400 text-xs"></i>
                            <span class="text-xs font-medium text-red-400">${alert.title || 'Anomaly Detected'}</span>
                        </div>
                        <p class="text-[10px] text-light-slate">${alert.message}</p>
                    </div>
                `).join('');
            } else if (insightsDiv) {
                insightsDiv.innerHTML = `
                    <div class="p-3 bg-white/5 rounded-lg text-sm text-light-slate text-center">
                        <i class="fas fa-check-circle text-[#22C55E] mr-2"></i>
                        All systems nominal. Monitoring ${telemetry.connected_count || telemetry.sensors.length} sensors.
                    </div>
                `;
            }
        }
        
        function draftHandoverReport() {
            const summaryEl = document.getElementById('handover-summary');
            const snippets = [];
            const activeAlerts = Array.isArray(currentTelemetry?.alerts) ? currentTelemetry.alerts : [];
            const recentAlerts = activeAlerts.slice(-4);

            if (recentAlerts.length > 0) {
                recentAlerts.forEach(alert => {
                    const when = alert.timestamp ? new Date(alert.timestamp) : new Date();
                    const timeLabel = when.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    snippets.push(`${alert.asset_id || 'Asset'} reported ${alert.message.toLowerCase()} at ${timeLabel}.`);
                });
            } else {
                snippets.push('No telemetry anomalies were detected during the last shift window.');
            }

            if (queryHistory.length > 0) {
                const recentQueries = queryHistory.slice(-5).map(q => typeof q === 'string' ? q : q.query).filter(Boolean);
                if (recentQueries.length > 0) {
                    snippets.push(`Operators searched for ${recentQueries.map(q => `"${q}"`).join('; ')}.`);
                }
            } else {
                snippets.push('No operator query history is available yet.');
            }

            snippets.push('Recommend reviewing the related manuals and prioritizing any assets with unresolved warnings for the next shift.');

            summaryEl.innerHTML = snippets.map(line => `<p class="text-sm text-slate-300 leading-relaxed">• ${line}</p>`).join('');
            showToast('Shift handover draft created', 'brand');
        }

        function startTelemetrySimulation() {
            if (telemetryInterval) {
                clearInterval(telemetryInterval);
            }
            fetchTelemetry();
            telemetryInterval = setInterval(fetchTelemetry, 3000);
        }
        
        async function simulateAlert() {
            try {
                const response = await fetch(`${API_URL}/telemetry/simulate-alert`, { method: 'POST' });
                const data = await response.json();
                document.getElementById('ai-alert-overlay').classList.remove('hidden');
                showToast('AI Anomaly Detection: ' + data.alert.message, 'brand');
                fetchTelemetry();
            } catch (err) {
                showToast('Failed to simulate alert', 'accent');
            }
        }
        
        function handleAlert(action) {
            document.getElementById('ai-alert-overlay').classList.add('hidden');
            if (action === 'workorder') {
                generateWorkOrder('P-101');
            }
        }
        
        // ==================== KNOWLEDGE VAULT (Enhanced) ====================
        let knowledgePosts = [];
        
        async function loadKnowledgeFeed() {
            try {
                const response = await fetch(`${API_URL}/knowledge`);
                knowledgePosts = await response.json();
                
                // Update vault count
                document.getElementById('vault-count').textContent = knowledgePosts.length;
                const verifiedCount = knowledgePosts.filter(p => p.verified).length;
                document.getElementById('verified-count').textContent = verifiedCount;
                
                renderKnowledgeFeed(knowledgePosts);
            } catch (err) {
                showToast('Failed to load knowledge vault: ' + err.message, 'accent');
            }
        }
        
        function renderKnowledgeFeed(posts) {
            const feed = document.getElementById('knowledge-feed');
            if (!posts || posts.length === 0) {
                feed.innerHTML = '<p class="text-light-slate text-center py-8">No knowledge posts yet</p>';
                return;
            }
            
            feed.innerHTML = posts.map(post => `
                <div class="glass-card rounded-xl p-6 ${post.verified ? 'border-l-2 border-[#22C55E]' : ''}">
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#F97316]/20 to-[#22C55E]/20 flex items-center justify-center text-sm font-bold">
                            ${post.avatar}
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1 flex-wrap">
                                <span class="font-semibold">${post.author}</span>
                                <span class="text-[10px] px-2 py-0.5 rounded bg-white/10 text-light-slate">${post.role}</span>
                                ${post.verified ? `<span class="text-[10px] px-2 py-0.5 rounded bg-[#22C55E]/20 text-[#22C55E] font-medium"><i class="fas fa-check-double mr-1"></i>VERIFIED BY SENIOR TECH</span>` : ''}
                            </div>
                            <div class="flex items-center gap-2 text-[10px] text-light-slate mb-3">
                                <span>${post.timestamp}</span>
                                <span>·</span>
                                <button onclick="viewAssetTwin('${post.assetId}')" class="text-[#F97316] hover:underline flex items-center gap-1">
                                    <i class="fas fa-microchip"></i> ${post.asset}
                                </button>
                            </div>
                            <h4 class="font-semibold mb-2">${post.title}</h4>
                            <p class="text-sm text-light-slate leading-relaxed">${post.content}</p>
                            
                            ${post.verified ? `
                            <div class="mt-3 p-2 bg-[#22C55E]/5 rounded border border-[#22C55E]/20">
                                <p class="text-[10px] text-[#22C55E]"><i class="fas fa-shield-alt mr-1"></i>This field hack has been verified and is now part of the AI training corpus</p>
                            </div>
                            ` : ''}
                            
                            <div class="flex items-center gap-4 mt-4 pt-4 border-t border-white/5">
                                <button onclick="likePost(${post.id})" class="text-[10px] text-light-slate hover:text-[#22C55E] transition flex items-center gap-1">
                                    <i class="fas fa-thumbs-up"></i> ${post.likes}
                                </button>
                                <button class="text-[10px] text-light-slate hover:text-white transition flex items-center gap-1">
                                    <i class="fas fa-comment"></i> ${post.comments}
                                </button>
                                <button class="text-[10px] text-light-slate hover:text-white transition flex items-center gap-1">
                                    <i class="fas fa-share"></i> Share
                                </button>
                                ${!post.verified && canVerify() ? `
                                <button onclick="verifyKnowledgePost(${post.id})" class="ml-auto text-[10px] px-2 py-1 bg-[#22C55E]/10 hover:bg-[#22C55E]/20 border border-[#22C55E]/30 rounded text-[#22C55E] transition">
                                    <i class="fas fa-check mr-1"></i>Verify
                                </button>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        }
        
        function viewAssetTwin(assetId) {
            showView('telemetry');
            showToast(`Loading asset details and telemetry for ${assetId}...`, 'accent');
        }
        
        async function verifyKnowledgePost(id) {
            if (!canVerify()) {
                showToast('Level 3 Technician clearance required to verify knowledge', 'accent');
                return;
            }
            try {
                const response = await fetch(`${API_URL}/knowledge/${id}/verify?user_level=3`, { method: 'POST' });
                if (response.ok) {
                    showToast('Field hack verified and added to AI training corpus', 'brand');
                    loadKnowledgeFeed(); // Refresh
                }
            } catch (err) {
                showToast('Failed to verify post', 'accent');
            }
        }
        
        async function likePost(id) {
            try {
                const response = await fetch(`${API_URL}/knowledge/${id}/like`, { method: 'POST' });
                if (response.ok) {
                    const data = await response.json();
                    showToast('Knowledge contribution acknowledged', 'brand');
                    loadKnowledgeFeed(); // Refresh
                }
            } catch (err) {
                showToast('Failed to like post', 'accent');
            }
        }
        
        function createKnowledgePost() {
            showToast('Knowledge creation modal would open - upload photos, add field notes', 'accent');
        }
        
        // ==================== FROM THE FIELD AI INJECTOR ====================
        function getFieldHackForAsset(assetId) {
            const vault = {
                'P-101': {
                    author: "Senior Tech Bob",
                    hack: "The manual says drain entire system, but you can isolate just the pump housing using the V-22 bypass valve to save 4 hours of downtime.",
                    verified: true
                },
                'HVAC-301': {
                    author: "Maria Rodriguez",
                    hack: "Hold the TEST button for 5 seconds before replacing filter. Prevents false positives.",
                    verified: false
                },
                'T-501': {
                    author: "James Chen",
                    hack: "Switched to Klüberplex BEM 41-141 after 2024 rebuild. Better high-temp performance than Mobil.",
                    verified: true
                }
            };
            
            const data = vault[assetId] || knowledgePosts.find(p => p.assetId === assetId && p.verified);
            if (!data) return '';

            return `
                <div class="mt-4 p-3 bg-[#22C55E]/5 border-l-2 border-[#22C55E] rounded-r-lg">
                    <div class="flex items-center gap-2 mb-2">
                        <i class="fas fa-hard-hat text-[#22C55E] text-xs"></i>
                        <span class="text-[10px] font-bold text-[#22C55E] tracking-widest uppercase">From the Field: ${data.verified ? 'Verified Hack' : 'Community Tip'}</span>
                    </div>
                    <p class="text-xs italic text-white/80">"${data.hack || data.content}"</p>
                    <div class="mt-2 text-[9px] text-light-slate flex justify-between items-center">
                        <span>— ${data.author}</span>
                        <button onclick="showView('vault')" class="underline hover:text-[#22C55E]">View in Vault</button>
                    </div>
                </div>
            `;
        }
        
        // Helper to check if query mentions an asset and inject field hack
        function injectFieldHackIntoResponse(text, responseHtml) {
            // Check for asset mentions in the response
            const assetMatches = ['P-101', 'HVAC-301', 'T-501', 'CONV-205'];
            for (const assetId of assetMatches) {
                if (text.toUpperCase().includes(assetId) || text.toLowerCase().includes(assetId.toLowerCase())) {
                    const hack = getFieldHackForAsset(assetId);
                    if (hack) {
                        return responseHtml + hack;
                    }
                }
            }
            return responseHtml;
        }
        
        // ==================== FIELD SCAN ====================
        function simulateQRScan() {
            const scannerArea = document.getElementById('qr-scanner-area');
            const result = document.getElementById('qr-result');
            
            scannerArea.innerHTML = `
                <i class="fas fa-circle-notch fa-spin text-3xl text-[#F97316] mb-3"></i>
                <p class="text-sm text-[#F97316]">Scanning QR code...</p>
            `;
            
            setTimeout(() => {
                scannerArea.classList.add('hidden');
                result.classList.remove('hidden');
                showToast('Asset P-101 identified via QR scan', 'brand');
            }, 1500);
        }
        
        function loadAssetManual(assetId) {
            showView('chat');
            setQuery(`Show me the maintenance manual for ${assetId}`);
            showToast(`Loading manual for ${assetId}...`, 'accent');
        }
        
        function showAssetHistory(assetId) {
            showToast(`Loading last 3 maintenance records for ${assetId}`, 'accent');
        }
        
        function requestAssistance(assetId) {
            showView('chat');
            setQuery(`What's the most common issue with ${assetId}?`);
            showToast(`AI analyzing ${assetId} maintenance patterns...`, 'accent');
        }
        
        // ==================== ONBOARDING WIZARD (CLI Style) ====================
        const userProfile = { level: 3, name: 'Admin User' }; // Current user level
        
        // =============================================
        // ONBOARDING WIZARD — Real Supabase-backed
        // =============================================
        let onboardingFiles = [];

        async function initializeOnboarding() {
            try {
                const { data: { session } } = await supabaseClient.auth.getSession();
                if (!session) return;

                const { data: profile } = await supabaseClient
                    .from('profiles')
                    .select('onboarded')
                    .eq('id', session.user.id)
                    .single();

                if (profile && !profile.onboarded) {
                    document.getElementById('onboarding-wizard').classList.remove('hidden');
                    renderOnboardingStep(0);
                }
            } catch (e) {
                console.warn('Onboarding check failed:', e);
            }
        }

        function renderOnboardingStep(stepIndex) {
            const container = document.getElementById('step-content');
            const totalSteps = 3;
            const progress = ((stepIndex + 1) / totalSteps) * 100;
            document.getElementById('onboarding-progress').style.width = `${progress}%`;

            if (stepIndex === 0) {
                // Step 1: Welcome + Profile
                container.innerHTML = `
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight text-[#F97316] mb-2">WELCOME TO INDEXFIELD</h2>
                        <p class="text-light-slate text-sm mb-6 font-mono">> Let's set up your workspace</p>
                        
                        <div class="space-y-4">
                            <div>
                                <label class="text-xs text-light-slate block mb-1">Company Name</label>
                                <input id="ob-company" type="text" placeholder="e.g. Acme Manufacturing" 
                                    class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg text-sm text-white placeholder-white/30 focus:border-[#F97316]/50 focus:outline-none transition">
                            </div>
                            <div>
                                <label class="text-xs text-light-slate block mb-1">Your Job Title</label>
                                <input id="ob-jobtitle" type="text" placeholder="e.g. Maintenance Manager" 
                                    class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg text-sm text-white placeholder-white/30 focus:border-[#F97316]/50 focus:outline-none transition">
                            </div>
                        </div>
                        
                        <div class="flex justify-end mt-8 pt-6 border-t border-white/10">
                            <button onclick="saveOnboardingProfile()" class="px-6 py-3 bg-[#F97316]/20 border border-[#F97316]/50 rounded-lg font-bold hover:bg-[#F97316]/30 transition font-mono text-sm">
                                NEXT >
                            </button>
                        </div>
                    </div>
                `;
            } else if (stepIndex === 1) {
                // Step 2: Upload files
                container.innerHTML = `
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight text-[#F97316] mb-2">UPLOAD YOUR DOCUMENTS</h2>
                        <p class="text-light-slate text-sm mb-6 font-mono">> Drop your technical manuals, PDFs, or documentation</p>
                        
                        <div id="ob-dropzone" class="border-2 border-dashed border-white/10 p-10 rounded-xl text-center hover:border-[#F97316]/30 transition-all cursor-pointer"
                             onclick="document.getElementById('ob-file-input').click()">
                            <i class="fas fa-cloud-upload-alt text-4xl text-light-slate mb-4"></i>
                            <p class="text-sm text-white mb-1">Drop files here or click to browse</p>
                            <p class="text-xs text-light-slate">PDF, TXT, CSV, Images — up to 100MB each</p>
                            <input type="file" id="ob-file-input" multiple accept=".pdf,.txt,.csv,.docx" class="hidden" onchange="handleOnboardingFiles(this)">
                        </div>
                        
                        <div id="ob-file-list" class="mt-4 space-y-2"></div>
                        
                        <div id="ob-upload-progress" class="hidden mt-4">
                            <div class="flex items-center gap-2 text-sm text-[#F97316]">
                                <i class="fas fa-circle-notch fa-spin"></i>
                                <span id="ob-upload-status">Uploading...</span>
                            </div>
                            <div class="h-2 bg-white/10 rounded-full overflow-hidden mt-2">
                                <div id="ob-progress-bar" class="h-full bg-[#F97316] transition-all" style="width: 0%"></div>
                            </div>
                        </div>
                        
                        <div class="flex justify-between mt-8 pt-6 border-t border-white/10">
                            <button onclick="renderOnboardingStep(0)" class="px-4 py-2 text-light-slate hover:text-white transition font-mono text-xs">< BACK</button>
                            <div class="flex gap-3">
                                <button onclick="renderOnboardingStep(2)" class="px-4 py-2 text-light-slate hover:text-white transition font-mono text-xs">Skip for now</button>
                                <button id="ob-upload-btn" onclick="uploadOnboardingFiles()" class="px-6 py-3 bg-[#F97316]/20 border border-[#F97316]/50 rounded-lg font-bold hover:bg-[#F97316]/30 transition font-mono text-sm disabled:opacity-30" disabled>
                                    UPLOAD & CONTINUE >
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            } else if (stepIndex === 2) {
                // Step 3: Complete
                const fileCount = onboardingFiles.length;
                container.innerHTML = `
                    <div class="text-center py-6">
                        <div class="w-20 h-20 rounded-full bg-[#22C55E]/20 flex items-center justify-center mx-auto mb-6">
                            <i class="fas fa-check text-3xl text-[#22C55E]"></i>
                        </div>
                        <h2 class="text-2xl font-bold tracking-tight text-white mb-2">YOU'RE ALL SET</h2>
                        <p class="text-light-slate text-sm mb-2 font-mono">> Workspace initialized successfully</p>
                        ${fileCount > 0 ? `<p class="text-xs text-[#22C55E] font-mono">> ${fileCount} document(s) indexed and ready for AI queries</p>` : '<p class="text-xs text-light-slate font-mono">> You can upload documents anytime from the dashboard</p>'}
                        
                        <div class="mt-8">
                            <button onclick="completeOnboarding()" class="px-8 py-4 bg-[#F97316]/20 border border-[#F97316]/50 rounded-lg font-bold hover:bg-[#F97316]/30 transition font-mono text-sm">
                                LAUNCH DASHBOARD >
                            </button>
                        </div>
                    </div>
                `;
            }
        }

        async function saveOnboardingProfile() {
            const company = document.getElementById('ob-company').value.trim();
            const jobTitle = document.getElementById('ob-jobtitle').value.trim();

            try {
                const { data: { session } } = await supabaseClient.auth.getSession();
                if (session) {
                    await supabaseClient
                        .from('profiles')
                        .update({ company: company, job_title: jobTitle })
                        .eq('id', session.user.id);

                    // Update UI immediately
                    if (company) document.getElementById('dropdown-user-company').textContent = company + ' • Enterprise';
                    if (jobTitle) document.getElementById('dropdown-user-title').textContent = jobTitle;
                }
            } catch (e) {
                console.warn('Profile save failed:', e);
            }
            renderOnboardingStep(1);
        }

        function handleOnboardingFiles(input) {
            const picked = Array.from(input.files || []);
            const rejected = picked.filter(f => !isAllowedUploadFile(f));
            onboardingFiles = picked.filter(f => isAllowedUploadFile(f));
            if (rejected.length > 0) {
                showToast('Skipped non-document files. Use PDF, TXT, CSV, or DOCX only.', 'accent');
            }
            const listEl = document.getElementById('ob-file-list');
            const uploadBtn = document.getElementById('ob-upload-btn');

            if (onboardingFiles.length > 0) {
                uploadBtn.disabled = false;
                listEl.innerHTML = onboardingFiles.map(f => `
                    <div class="flex items-center gap-3 p-3 bg-white/5 rounded-lg">
                        <i class="fas fa-file-pdf text-[#F97316]"></i>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm truncate">${f.name}</p>
                            <p class="text-xs text-light-slate">${(f.size / 1024 / 1024).toFixed(1)} MB</p>
                        </div>
                        <i class="fas fa-check-circle text-[#22C55E] text-xs"></i>
                    </div>
                `).join('');
            }
        }

        async function uploadOnboardingFiles() {
            const progressEl = document.getElementById('ob-upload-progress');
            const progressBar = document.getElementById('ob-progress-bar');
            const statusEl = document.getElementById('ob-upload-status');
            const uploadBtn = document.getElementById('ob-upload-btn');

            progressEl.classList.remove('hidden');
            uploadBtn.disabled = true;

            const { data: { session } } = await supabaseClient.auth.getSession();

            for (let i = 0; i < onboardingFiles.length; i++) {
                const file = onboardingFiles[i];
                const pct = Math.round(((i) / onboardingFiles.length) * 100);
                progressBar.style.width = `${pct}%`;
                statusEl.textContent = `Processing ${file.name} (${i + 1}/${onboardingFiles.length})...`;

                try {
                    // Upload to backend for RAG processing
                    const formData = new FormData();
                    formData.append('file', file);

                    const response = await fetch(`${API_URL}/upload?asset_type=Industrial%20Equipment`, {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        const result = await response.json();
                        // Save metadata to Supabase
                        if (session) {
                            await supabaseClient.from('user_manuals').insert({
                                user_id: session.user.id,
                                backend_id: result.manual.id,
                                filename: file.name,
                                asset_type: result.manual.asset_type,
                                status: 'Ready',
                                page_count: result.manual.page_count,
                                section_count: result.manual.section_count,
                                file_size_bytes: file.size
                            });
                        }
                    }
                } catch (e) {
                    console.error(`Upload failed for ${file.name}:`, e);
                }
            }

            progressBar.style.width = '100%';
            statusEl.textContent = 'All files processed!';

            setTimeout(() => renderOnboardingStep(2), 1000);
        }

        async function completeOnboarding() {
            try {
                const { data: { session } } = await supabaseClient.auth.getSession();
                if (session) {
                    await supabaseClient
                        .from('profiles')
                        .update({ onboarded: true })
                        .eq('id', session.user.id);
                }
            } catch (e) {
                console.warn('Onboarding completion failed:', e);
            }

            document.getElementById('onboarding-wizard').classList.add('hidden');
            showToast('Workspace initialized. Welcome to IndexField.', 'brand');
            
            // Reload dashboard data
            await loadSupabaseData();
            showView('chat');
        }

        // =============================================
        // SUPABASE DATA LOADING — Real persistence
        // =============================================
        async function loadSupabaseData() {
            try {
                const { data: { session } } = await supabaseClient.auth.getSession();
                if (!session) {
                    syncDashboardState();
                    return;
                }

                const userId = session.user.id;

                // Load manuals count
                const { data: manualsData } = await supabaseClient
                    .from('user_manuals')
                    .select('*')
                    .eq('user_id', userId);

                if (manualsData) {
                    manuals = filterIndustrialManuals(
                        manualsData.map(m => ({
                            id: m.backend_id || m.id,
                            filename: m.filename,
                            asset_type: m.asset_type,
                            status: m.status,
                            uploaded_at: m.created_at,
                            page_count: m.page_count,
                            section_count: m.section_count
                        }))
                    );
                }

                // Load knowledge posts count
                const { count: postsCount } = await supabaseClient
                    .from('knowledge_posts')
                    .select('*', { count: 'exact', head: true })
                    .eq('user_id', userId);

                const { count: verifiedPosts } = await supabaseClient
                    .from('knowledge_posts')
                    .select('*', { count: 'exact', head: true })
                    .eq('user_id', userId)
                    .eq('verified', true);

                notesCount = postsCount || 0;
                verifiedCount = verifiedPosts || 0;

                // Update UI counters
                const vcEl = document.getElementById('verified-count');
                const ncEl = document.getElementById('notes-count');
                if (vcEl) {
                    vcEl.textContent = verifiedCount;
                    if (verifiedCount === 0) vcEl.classList.add('opacity-50');
                    else vcEl.classList.remove('opacity-50');
                }
                if (ncEl) {
                    ncEl.textContent = notesCount;
                    if (notesCount === 0) ncEl.classList.add('opacity-50');
                    else ncEl.classList.remove('opacity-50');
                }

                // Update Vault Count and Manual Count
                const vaultEl = document.getElementById('vault-count');
                const manualEl = document.getElementById('manual-count');
                const mLen = manuals ? manuals.length : 0;
                if (vaultEl) {
                    vaultEl.textContent = mLen;
                    if (mLen === 0) vaultEl.classList.add('opacity-50');
                    else vaultEl.classList.remove('opacity-50');
                }
                if (manualEl) {
                    manualEl.textContent = mLen;
                    if (mLen === 0) manualEl.classList.add('hidden');
                    else manualEl.classList.remove('hidden');
                }

                // Load query history
                const { data: queries } = await supabaseClient
                    .from('query_history')
                    .select('query, created_at')
                    .eq('user_id', userId)
                    .order('created_at', { ascending: false })
                    .limit(50);

                if (queries) {
                    queryHistory = queries.map(q => q.query);
                }

                // Update dynamic lists
                const recentQueriesList = document.getElementById('recent-queries-list');
                if (recentQueriesList) {
                    if (filterIndustrialManuals(manuals).length > 0 && queryHistory.length > 0) {
                        recentQueriesList.innerHTML = queryHistory.slice(0, 5).map((q, i) => `
                            <button type="button" class="data-surface p-1.5 rounded text-[11px] text-left flex items-center gap-2 cursor-pointer hover:bg-white/5 transition" onclick="activatePromptShortcut('${q.replace(/'/g, "\\'")}')">
                                <span class="w-1 h-1 rounded-full ${i % 2 === 0 ? 'bg-[#F97316]' : 'bg-[#22C55E]'}"></span>
                                <span class="text-light-slate">${q}</span>
                            </button>
                        `).join('');
                    } else {
                        recentQueriesList.innerHTML = '<p class="text-[10px] text-light-slate/60 text-center py-2">💡 Upload your first manual to see suggested questions here.</p>';
                    }
                }

                refreshKnowledgeBaseUI();

                // Update empty state chips
                if (filterIndustrialManuals(manuals).length === 0) {
                    document.getElementById('quick-queries-real')?.classList.add('hidden');
                    document.getElementById('quick-queries-demo')?.classList.remove('hidden');
                } else {
                    document.getElementById('quick-queries-real')?.classList.remove('hidden');
                    document.getElementById('quick-queries-demo')?.classList.add('hidden');
                }

                console.log(`[Supabase] Loaded: ${manuals.length} manuals, ${notesCount} notes, ${queryHistory.length} queries`);
                syncDashboardState();

            } catch (e) {
                console.warn('Supabase data load failed:', e);
                syncDashboardState(); // Guarantees UI un-hides if network fails
            }
        }

        async function saveQueryToSupabase(query, answer, sources) {
            try {
                const { data: { session } } = await supabaseClient.auth.getSession();
                if (!session) return;

                await supabaseClient.from('query_history').insert({
                    user_id: session.user.id,
                    query: query,
                    answer: answer,
                    sources: sources || []
                });
            } catch (e) {
                console.warn('Query save failed:', e);
            }
        }

        async function saveManualToSupabase(manualResult, fileSize) {
            try {
                const { data: { session } } = await supabaseClient.auth.getSession();
                if (!session) return;

                await supabaseClient.from('user_manuals').insert({
                    user_id: session.user.id,
                    backend_id: manualResult.id,
                    filename: manualResult.filename,
                    asset_type: manualResult.asset_type,
                    status: manualResult.status || 'Ready',
                    page_count: manualResult.page_count,
                    section_count: manualResult.section_count,
                    file_size_bytes: fileSize || 0
                });
            } catch (e) {
                console.warn('Manual save failed:', e);
            }
        }
        
        function canVerify() {
            return true; // All users can verify in their own workspace
        }
        
        function resetPdfPreview() {
            currentPdf = null;
            const frame = document.getElementById('pdf-frame');
            const placeholder = document.getElementById('pdf-placeholder');
            if (frame) {
                frame.src = '';
                frame.classList.add('hidden');
            }
            if (placeholder) {
                placeholder.classList.remove('hidden');
            }
            setRightPanelTransitionState(false);
            updatePlantDocumentsLabel();
        }

        function clearChat() {
            document.getElementById('messages').innerHTML = '';
            document.getElementById('welcome-message').classList.remove('hidden');
            resetPdfPreview();
        }

        function showUploadModal() { document.getElementById('upload-modal').classList.remove('hidden'); }
        function hideUploadModal() { document.getElementById('upload-modal').classList.add('hidden'); document.getElementById('upload-status').classList.add('hidden'); }
        
        function injectHistoryQuery(target, query, match) {
            if (!manuals || manuals.length === 0) {
                showToast('Upload a manual before trying sample searches.', 'accent');
                return;
            }
            document.getElementById('history-empty-state').classList.add('hidden');
            document.getElementById('history-active-state').classList.remove('hidden');
            
            const tbody = document.getElementById('history-table-body');
            const now = new Date();
            const timeStr = now.toISOString().split('T')[1].substring(0, 8) + ' UTC';
            
            const row = document.createElement('tr');
            row.className = 'hover:bg-white/5 transition-colors group';
            row.innerHTML = `
                <td class="p-4 text-light-slate font-mono text-[10px] whitespace-nowrap">${timeStr}</td>
                <td class="p-4 text-white/80 font-bold tracking-wide text-[10px]">${target}</td>
                <td class="p-4 text-[#F97316] font-mono text-[11px]">"${query}"</td>
                <td class="p-4 text-white/60 text-[10px]">${match}</td>
                <td class="p-4 text-right">
                    <span class="inline-flex items-center gap-1.5 px-2 py-1 bg-[#22C55E]/10 border border-[#22C55E]/20 text-[#22C55E] text-[9px] rounded font-bold tracking-widest">
                        <i class="fas fa-check-circle"></i> COMPLETED
                    </span>
                </td>
            `;
            tbody.prepend(row);
            
            // Navigate to Ask Questions with query pre-filled
            setTimeout(() => {
                showView('chat');
                setQuery(query);
            }, 600);
        }
        
        function injectDemoManual(containerId) {
            loadSamplePumpManual({ matrixContainerId: containerId || 'upload-modal-content' });
        }

        async function loadSamplePumpManual(options = {}) {
            const { matrixContainerId = null, quiet = false, skipMatrix = false, afterMatrix = false } = options;
            if (matrixContainerId && !skipMatrix) {
                startProcessingMatrix(matrixContainerId, () => loadSamplePumpManual({ quiet, skipMatrix: true, afterMatrix: true }));
                return;
            }
            const sampleBtn = document.getElementById('load-sample-manual-btn');
            if (sampleBtn) {
                sampleBtn.disabled = true;
                sampleBtn.classList.add('opacity-60', 'cursor-wait');
            }
            if (!quiet) {
                showToast('Indexing sample centrifugal pump manual…', 'brand');
            }
            try {
                const response = await fetch(`${API_URL}/demo/load_sample_manual`, { method: 'POST' });
                const data = await response.json().catch(() => ({}));
                if (!response.ok) {
                    const msg = typeof data.detail === 'string' ? data.detail : 'Could not load sample manual';
                    throw new Error(msg);
                }
                if (afterMatrix) {
                    hideUploadModal();
                    hideManualsModal();
                    showView('chat');
                }
                resetPdfPreview();
                await loadManuals();
                if (!quiet) {
                    showToast('Sample pump manual ready — try a Quick Action or ask a question', 'brand');
                }
            } catch (err) {
                console.warn('Sample manual load failed:', err);
                showToast(err.message || 'Sample manual unavailable. Start the backend server.', 'accent');
            } finally {
                if (sampleBtn) {
                    sampleBtn.disabled = false;
                    sampleBtn.classList.remove('opacity-60', 'cursor-wait');
                }
            }
        }

        function runQuickAction(actionKey) {
            const prompt = QUICK_ACTION_PROMPTS[actionKey];
            if (!prompt) return;
            if (!filterIndustrialManuals(manuals).length) {
                const messages = {
                    fault: 'Please upload a manual to enable fault analysis.',
                    maintenance: 'Please upload a manual to enable maintenance insights.',
                    loto: 'Please upload a manual to enable lockout / tagout guidance.'
                };
                showToast(messages[actionKey] || 'Please upload a manual first to enable this action.', 'accent');
                return;
            }
            activatePromptShortcut(prompt);
        }

        async function importFromAssetRegistry() {
            showView('chat');
            try {
                const res = await fetch(`${API_URL}/assets`);
                let assets = res.ok ? await res.json() : [];
                if (!Array.isArray(assets)) assets = [];

                if (assets.length === 0) {
                    injectDemoAssetStream();
                    showToast('Demo fleet loaded. Indexing pump manual for P-101…', 'brand');
                    await loadSamplePumpManual({ quiet: true });
                    return;
                }

                const linkedManuals = [];
                for (const asset of assets) {
                    try {
                        const mRes = await fetch(`${API_URL}/assets/${asset.id}/manuals`);
                        if (!mRes.ok) continue;
                        const linked = await mRes.json();
                        if (Array.isArray(linked) && linked.length) {
                            linkedManuals.push(...linked);
                        }
                    } catch (_) { /* skip */ }
                }

                if (linkedManuals.length > 0) {
                    await loadManuals();
                    showToast(`Synced ${linkedManuals.length} manual(s) from your Asset Registry`, 'brand');
                    return;
                }

                if (filterIndustrialManuals(manuals).length > 0) {
                    showToast('Knowledge base already has manuals — add more via upload.', 'brand');
                    return;
                }

                showToast('No manuals linked to assets yet. Loading sample pump manual…', 'brand');
                await loadSamplePumpManual({ quiet: true });
            } catch (err) {
                showToast('Asset Registry unavailable. Is the backend running?', 'accent');
            }
        }
        
        function startProcessingMatrix(containerId, onComplete) {
            const container = document.getElementById(containerId);
            if (!container) return;
            
            container.innerHTML = `
                <div class="flex flex-col h-[350px] bg-[#0a0d12] border border-[#F97316]/30 rounded-lg font-mono text-xs overflow-hidden relative shadow-[0_0_50px_rgba(249,115,22,0.1)] w-full">
                    <div class="p-4 border-b border-[#F97316]/20 bg-[#F97316]/10 flex items-center justify-between">
                        <span class="text-[#F97316] font-bold tracking-widest text-[11px]"><i class="fas fa-microchip mr-2"></i>PROCESSING MATRIX ACTIVE</span>
                        <span class="text-[#22C55E] animate-pulse text-[10px]">■ UPLINK SECURE</span>
                    </div>
                    <div id="terminal-log" class="flex-1 p-6 overflow-y-auto space-y-3 text-white/80 font-mono tracking-wide text-[11px]">
                        <div class="text-[#F97316]">> INITIALIZING SECURE INGESTION PROTOCOL...</div>
                    </div>
                    <div class="h-1.5 w-full bg-white/5"><div id="matrix-progress" class="h-full bg-gradient-to-r from-[#F97316] to-[#22C55E] w-0 transition-all duration-300"></div></div>
                </div>
            `;
            
            const log = document.getElementById('terminal-log');
            const progress = document.getElementById('matrix-progress');
            
            const lines = [
                { text: "> CONNECTING TO LOCAL EMBEDDING ENGINE...", delay: 500 },
                { text: "> [OK] Model: IndexField-V2.8_Pro loaded", delay: 1200, color: "text-[#22C55E]" },
                { text: "> PARSING PAGES (Grundfos_CR_Centrifugal_Pump_Manual.pdf)...", delay: 2000 },
                { text: "> EXTRACTING SCHEMATICS AND WIRING DIAGRAMS...", delay: 3500, color: "text-[#06B6D4]" },
                { text: "> [OK] 14 tables identified and structured", delay: 4200, color: "text-[#22C55E]" },
                { text: "> GENERATING VECTOR EMBEDDINGS (CHUNK SIZE: 1000)...", delay: 5500, color: "text-[#FACC15]" },
                { text: "> HASHING CHUNKS INTO LOCAL DATABASE...", delay: 6800 },
                { text: "> [SUCCESS] 142 CHUNKS INDEXED SECURELY", delay: 8000, color: "text-[#22C55E] font-bold" },
                { text: "> PIPELINE COMPLETE. REDIRECTING TO ASK QUESTIONS...", delay: 9500, color: "text-[#F97316] animate-pulse" }
            ];
            
            lines.forEach((line, index) => {
                setTimeout(() => {
                    log.innerHTML += `<div class="${line.color || ''} terminal-line mt-2">${line.text}</div>`;
                    log.scrollTop = log.scrollHeight;
                    progress.style.width = `${((index + 1) / lines.length) * 100}%`;
                    
                    if (index === lines.length - 1) {
                        setTimeout(() => {
                            if (typeof onComplete === 'function') onComplete();
                        }, 2000);
                    }
                }, line.delay);
            });
        }
        
        function handleUpload(input) {
            const file = input.files[0];
            if (!file) return;
            if (!isAllowedUploadFile(file)) {
                showToast('Only PDF, TXT, CSV, and DOCX plant manuals can be indexed.', 'accent');
                input.value = '';
                return;
            }
            document.getElementById('upload-status')?.classList.remove('hidden');
            const formData = new FormData();
            formData.append('file', file);
            formData.append('asset_type', 'Industrial Equipment');
            fetch(`${API_URL}/upload`, { method: 'POST', body: formData })
            .then(async r => {
                const data = await r.json().catch(() => ({}));
                if (!r.ok) {
                    const msg = typeof data.detail === 'string' ? data.detail : 'Upload rejected';
                    showToast(msg, 'accent');
                    return;
                }
                if (data.success) {
                    const chunkCount = extractUploadChunkCount(data);
                    showToast(
                        chunkCount !== null ? `${chunkCount} chunks indexed` : 'Manual indexed successfully',
                        'brand'
                    );
                    saveManualToSupabase(data.manual, file.size);
                    resetPdfPreview();
                    loadManuals();
                    hideUploadModal();
                }
            })
            .catch(() => showToast('Upload failed', 'accent'))
            .finally(() => { input.value = ''; });
        }

        // Batch upload queue management
        let uploadQueue = [];
        let uploadBatchId = 0;

        function handleBatchUpload(input) {
            const files = Array.from(input.files);
            if (files.length === 0) return;

            // Filter valid files
            const validFiles = files.filter(file => isAllowedUploadFile(file));
            if (validFiles.length === 0) {
                showToast('Only PDF, TXT, CSV, and DOCX plant manuals can be indexed.', 'accent');
                input.value = '';
                return;
            }

            // Add files to queue
            validFiles.forEach(file => {
                const fileId = ++uploadBatchId;
                uploadQueue.push({
                    id: fileId,
                    file: file,
                    status: 'queued',
                    progress: 0,
                    legibilityScore: Math.floor(Math.random() * 30) + 70, // Simulated score 70-99
                    fileSize: formatFileSize(file.size),
                    pageCount: Math.floor(Math.random() * 200) + 20 // Simulated page count
                });
            });

            updateBatchQueueUI();
            addTerminalLog(`[BATCH] ${validFiles.length} file(s) added to processing queue`);
            input.value = '';

            // Enable process button with green color
            const processBtn = document.getElementById('process-batch-btn');
            if (processBtn) {
                processBtn.disabled = false;
                processBtn.classList.remove('bg-[#F97316]/20', 'text-white/50', 'border-[#F97316]/30');
                processBtn.classList.add('bg-[#22C55E]', 'text-white', 'hover:bg-[#22C55E]/90', 'border-[#22C55E]/30', 'shadow-[0_0_20px_rgba(34,197,94,0.3)]');
                processBtn.onclick = processBatchQueue;
            }
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function updateBatchQueueUI() {
            const queueContainer = document.getElementById('batch-queue');
            const queueCount = document.getElementById('queue-count');
            if (!queueContainer) return;

            if (uploadQueue.length === 0) {
                queueContainer.innerHTML = `
                    <div class="text-center py-8">
                        <i class="fas fa-inbox text-2xl text-white/20 mb-2"></i>
                        <p class="text-[10px] text-white/30">No files in queue</p>
                    </div>
                `;
            } else {
                queueContainer.innerHTML = uploadQueue.map(item => {
                    const legibilityClass = item.legibilityScore >= 85 ? 'text-[#22C55E]' : (item.legibilityScore >= 70 ? 'text-[#FACC15]' : 'text-[#EF4444]');
                    const legibilityWarning = item.legibilityScore < 75 ? '<span class="text-[9px] text-[#EF4444] ml-2">⚠️ Heavy OCR Required</span>' : '';
                    const statusColor = item.status === 'completed' ? 'text-[#22C55E]' : (item.status === 'processing' ? 'text-[#F97316]' : 'text-white/50');

                    return `
                        <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-file-pdf text-[#F97316] text-xs"></i>
                                    <span class="text-xs text-white/90 font-medium truncate max-w-[180px]">${item.file.name}</span>
                                </div>
                                <span class="text-[9px] ${statusColor} uppercase tracking-wider">${item.status}</span>
                            </div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-[9px] text-white/40">${item.fileSize} • ${item.pageCount} pages</span>
                                <span class="text-[9px] ${legibilityClass}">${item.legibilityScore}% legible${legibilityWarning}</span>
                            </div>
                            <div class="w-full bg-white/10 rounded-full h-1.5">
                                <div class="bg-gradient-to-r from-[#F97316] to-[#22C55E] h-1.5 rounded-full transition-all duration-300" style="width: ${item.progress}%"></div>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            if (queueCount) {
                queueCount.textContent = `${uploadQueue.length} FILES QUEUED`;
            }
        }

        function addTerminalLog(message, type = 'info') {
            const terminal = document.getElementById('upload-terminal');
            if (!terminal) return;

            const timestamp = new Date().toLocaleTimeString('en-US', { hour12: false });
            const colorClass = type === 'success' ? 'text-[#22C55E]' : (type === 'warning' ? 'text-[#FACC15]' : (type === 'error' ? 'text-[#EF4444]' : 'text-white/70'));
            
            const logEntry = document.createElement('p');
            logEntry.className = colorClass;
            logEntry.textContent = `[${timestamp}] ${message}`;
            terminal.appendChild(logEntry);
            terminal.scrollTop = terminal.scrollHeight;
        }

        async function processBatchQueue() {
            if (uploadQueue.length === 0) return;

            // Lock down all controls during processing
            lockDownControls(true);

            const processBtn = document.getElementById('process-batch-btn');
            if (processBtn) {
                processBtn.disabled = true;
                processBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> PROCESSING...';
            }

            addTerminalLog('[SYSTEM] Starting batch processing pipeline...', 'info');

            for (let i = 0; i < uploadQueue.length; i++) {
                const item = uploadQueue[i];
                item.status = 'processing';
                updateBatchQueueUI();

                addTerminalLog(`[UPLOAD] Processing: ${item.file.name}`, 'info');

                // Simulate processing steps with terminal output
                await simulateFileProcessing(item);

                // Actual upload
                const formData = new FormData();
                formData.append('file', item.file);
                formData.append('asset_type', 'Industrial Equipment');

                try {
                    const response = await fetch(`${API_URL}/upload`, { method: 'POST', body: formData });
                    const data = await response.json().catch(() => ({}));

                    if (response.ok && data.success) {
                        item.status = 'completed';
                        item.progress = 100;
                        addTerminalLog(`[SUCCESS] ${item.file.name} indexed successfully`, 'success');
                        saveManualToSupabase(data.manual, item.file.size);
                    } else {
                        item.status = 'failed';
                        addTerminalLog(`[ERROR] ${item.file.name} failed to process`, 'error');
                    }
                } catch (error) {
                    item.status = 'failed';
                    addTerminalLog(`[ERROR] ${item.file.name} upload failed`, 'error');
                }

                updateBatchQueueUI();
            }

            addTerminalLog('[SYSTEM] Batch processing complete', 'success');
            loadManuals();
            resetPdfPreview();

            // Clear queue after delay
            setTimeout(() => {
                uploadQueue = [];
                updateBatchQueueUI();
                if (processBtn) {
                    processBtn.disabled = true;
                    processBtn.innerHTML = '<i class="fas fa-cogs"></i> Process Batch';
                    processBtn.classList.remove('bg-[#22C55E]', 'text-white', 'hover:bg-[#22C55E]/90', 'border-[#22C55E]/30', 'shadow-[0_0_20px_rgba(34,197,94,0.3)]');
                    processBtn.classList.add('bg-[#F97316]/20', 'text-white/50', 'border-[#F97316]/30');
                }
                lockDownControls(false);
                hideUploadModal();
                showToast('Batch processing completed successfully', 'brand');
            }, 2000);
        }

        function lockDownControls(locked) {
            // Disable/enable dropdowns
            const plantZoneSelect = document.getElementById('plant-zone-select');
            const assetCategorySelect = document.getElementById('asset-category-select');
            if (plantZoneSelect) plantZoneSelect.disabled = locked;
            if (assetCategorySelect) assetCategorySelect.disabled = locked;

            // Disable/enable checkboxes
            const checkboxes = document.querySelectorAll('#upload-modal input[type="checkbox"]');
            checkboxes.forEach(cb => cb.disabled = locked);

            // Disable/enable drop zone
            const dropZone = document.querySelector('#upload-modal .relative.overflow-hidden');
            if (dropZone) {
                if (locked) {
                    dropZone.classList.add('pointer-events-none', 'opacity-50');
                } else {
                    dropZone.classList.remove('pointer-events-none', 'opacity-50');
                }
            }

            // Disable/enable Quick Start link
            const quickStartLink = document.querySelector('#upload-modal button[onclick="injectDemoManual(\'upload-modal-content\')"]');
            if (quickStartLink) {
                if (locked) {
                    quickStartLink.disabled = true;
                    quickStartLink.classList.add('opacity-50', 'pointer-events-none');
                } else {
                    quickStartLink.disabled = false;
                    quickStartLink.classList.remove('opacity-50', 'pointer-events-none');
                }
            }

            // Disable/enable close button
            const closeButton = document.querySelector('#upload-modal button[onclick="hideUploadModal()"]');
            if (closeButton) closeButton.disabled = locked;
        }

        async function simulateFileProcessing(item) {
            const steps = [
                { message: `> Analyzing PDF structure...`, progress: 10, type: 'info' },
                { message: `> Extracting ${item.pageCount} pages for content analysis...`, progress: 20, type: 'info' },
                { message: `> Detecting document layout and formatting...`, progress: 28, type: 'info' },
                { message: `> Isolating text blocks and tables...`, progress: 35, type: 'info' },
                { message: `> Identifying schematic diagrams and technical drawings...`, progress: 42, type: 'info' },
                { message: `> Extracting maintenance schedules and calibration data...`, progress: 50, type: 'success' },
                { message: `> Isolating fault codes and error patterns...`, progress: 58, type: 'success' },
                { message: `> Vectorizing ${Math.floor(item.pageCount * 42)} text segments...`, progress: 65, type: 'info' },
                { message: `> Running OCR quality assessment (score: ${item.legibilityScore}%)...`, progress: 72, type: 'info' },
                { message: `> Building semantic search index...`, progress: 80, type: 'info' },
                { message: `> Cross-referencing with existing knowledge base...`, progress: 88, type: 'info' },
                { message: `> VALIDATION COMPLETE. ${item.pageCount} pages indexed successfully.`, progress: 95, type: 'success' }
            ];

            for (const step of steps) {
                await new Promise(resolve => setTimeout(resolve, 600 + Math.random() * 400));
                item.progress = step.progress;
                addTerminalLog(step.message, step.type || 'info');
                updateBatchQueueUI();
            }

            // Legibility warning if needed
            if (item.legibilityScore < 75) {
                await new Promise(resolve => setTimeout(resolve, 400));
                addTerminalLog(`[WARNING] Low legibility detected (${item.legibilityScore}%) - Enhanced OCR processing required`, 'warning');
                await new Promise(resolve => setTimeout(resolve, 300));
                addTerminalLog(`> Applying adaptive thresholding and deskewing algorithms...`, 'info');
                item.progress = 98;
                updateBatchQueueUI();
            }
        }
        
        function showManualsModal() { loadManuals(); document.getElementById('manuals-modal').classList.remove('hidden'); }
        function hideManualsModal() { document.getElementById('manuals-modal').classList.add('hidden'); }
        
        function loadManuals() {
            fetch(`${API_URL}/manuals`)
            .then(r => r.json())
            .then(data => {
                manuals = filterIndustrialManuals(data);
                refreshKnowledgeBaseUI();
                
                const mcEl = document.getElementById('manual-count');
                if (mcEl) {
                    mcEl.textContent = manuals.length;
                    if (manuals.length === 0) mcEl.classList.add('hidden');
                    else mcEl.classList.remove('hidden');
                }
                const list = document.getElementById('manuals-list');
                if (manuals.length === 0) {
                    list.innerHTML = '<p class="text-light-slate text-center py-8">No manuals uploaded yet</p>';
                }
                syncDashboardState();
            });
        }

        function addDemoManual() {
            const tbody = document.getElementById('manuals-table-body');
            if (!tbody) return;
            
            // Add a demo manual row to the table
            const demoRow = document.createElement('tr');
            demoRow.className = 'hover:bg-white/5 transition-colors';
            demoRow.innerHTML = `
                <td class="py-3 px-4 text-sm text-white font-medium">Siemens_Gas_Turbine_Manual.pdf</td>
                <td class="py-3 px-4 text-sm text-slate-300">412 Pages</td>
                <td class="py-3 px-4 text-sm text-slate-300">Demo User</td>
                <td class="py-3 px-4">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[#22C55E]/10 text-[#22C55E] border border-[#22C55E]/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E]"></span>
                        Fully Indexed
                    </span>
                </td>
            `;
            tbody.appendChild(demoRow);
            
            // Show success message
            showToast('Demo manual added successfully', 'success');
        }
        
        // ==================== PROFILE & SETTINGS ====================
        function toggleProfileDropdown() {
            const dropdown = document.getElementById('profile-dropdown');
            const chevron = document.getElementById('profile-chevron');
            dropdown.classList.toggle('hidden');
            chevron.classList.toggle('profile-dropdown-open');
        }
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('profile-dropdown');
            const trigger = document.querySelector('[onclick="toggleProfileDropdown()"]');
            if (!dropdown.classList.contains('hidden') && !dropdown.contains(e.target) && !trigger.contains(e.target)) {
                dropdown.classList.add('hidden');
                document.getElementById('profile-chevron').classList.remove('profile-dropdown-open');
            }
        });
        
        function showSettings(tab = 'profile') {
            document.getElementById('settings-modal').classList.remove('hidden');
            switchSettingsTab(tab);
            // Hide dropdown if open
            document.getElementById('profile-dropdown').classList.add('hidden');
            document.getElementById('profile-chevron').classList.remove('profile-dropdown-open');
        }
        
        function hideSettings() {
            document.getElementById('settings-modal').classList.add('hidden');
        }
        
        function switchSettingsTab(tab) {
            // Update tab buttons
            document.querySelectorAll('.settings-tab-btn').forEach(btn => {
                btn.classList.remove('active', 'bg-white/10');
                if (btn.dataset.tab === tab) {
                    btn.classList.add('active', 'bg-white/10');
                }
            });
            
            // Show/hide tab content
            document.querySelectorAll('.settings-tab-content').forEach(content => {
                content.classList.add('hidden');
            });
            document.getElementById(`tab-${tab}`).classList.remove('hidden');
        }
        
        function showSystemStatus() {
            document.getElementById('system-status-modal').classList.remove('hidden');
            document.getElementById('profile-dropdown').classList.add('hidden');
            document.getElementById('profile-chevron').classList.remove('profile-dropdown-open');
        }
        
        function hideSystemStatus() {
            document.getElementById('system-status-modal').classList.add('hidden');
        }
        
        function showHelpCenter() {
            showView('help');
            document.getElementById('profile-dropdown').classList.add('hidden');
            document.getElementById('profile-chevron').classList.remove('profile-dropdown-open');
        }
        
        function showHelpGuide(guide) {
            // Hide main help content, show guide content
            document.getElementById('guide-content').classList.remove('hidden');
            
            // Hide all guide pages
            document.querySelectorAll('.guide-page').forEach(page => page.classList.add('hidden'));
            
            // Show selected guide
            const guidePage = document.getElementById(`guide-${guide}`);
            if (guidePage) {
                guidePage.classList.remove('hidden');
                
                // Update progress indicator
                const progressMap = {
                    'getting-started': 'Step 1 of 4',
                    'manuals': 'Step 2 of 4',
                    'ai-queries': 'Step 3 of 4',
                    'troubleshooting': 'Step 4 of 4'
                };
                document.getElementById('guide-progress').textContent = progressMap[guide] || '';
            }
            
            // Scroll to guide content
            document.getElementById('guide-content').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        
        function backToHelpCenter() {
            document.getElementById('guide-content').classList.add('hidden');
            document.querySelectorAll('.guide-page').forEach(page => page.classList.add('hidden'));
        }
        
        function showToast(text, type = 'brand') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `glass-card border-l-4 ${type === 'brand' ? 'border-[#22C55E]' : 'border-[#F97316]'} px-4 py-3 rounded shadow-2xl animate-in text-xs flex items-center gap-3 mb-2`;
            toast.innerHTML = `<i class="fas ${type === 'brand' ? 'fa-check-circle text-[#22C55E]' : 'fa-info-circle text-[#F97316]'}"></i> <span>${text}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }
        
        // ==================== GOLDEN THREAD STATE CONTROLLER ====================
        const AppState = {
            isAnomalyActive: false,
            currentAsset: 'P-101',
            vibrationLevel: 1.2, // normal
            onboardingComplete: localStorage.getItem('onboarding_complete') || false
        };
        
        // Simulate IoT Fluctuation every 3 seconds
        setInterval(() => {
            if (!AppState.isAnomalyActive) {
                AppState.vibrationLevel = parseFloat((Math.random() * (1.5 - 0.8) + 0.8).toFixed(2));
                updateTelemetryUI();
            }
        }, 3000);
        
        // Trigger the "Wow Factor" Anomaly
        function triggerAnomaly() {
            AppState.isAnomalyActive = true;
            AppState.vibrationLevel = 8.42;
            updateTelemetryUI();
            
            const alert = document.getElementById('ai-alert-overlay');
            alert.classList.remove('hidden');
            
            showToast('CRITICAL ALERT: P-101 Vibration Threshold Exceeded', 'accent');
        }
        
        // ==================== WORK ORDER GENERATOR ====================
        async function generateWorkOrder(assetId) {
            // Get asset details from backend
            let assetData;
            try {
                const response = await fetch(`${API_URL}/assets/${assetId}`);
                if (response.ok) {
                    const asset = await response.json();
                    assetData = { 
                        name: asset.name, 
                        location: asset.location, 
                        priority: asset.status === 'offline' ? 'CRITICAL' : 'HIGH' 
                    };
                } else {
                    throw new Error('Asset not found');
                }
            } catch (err) {
                // Fallback to mock data
                const mockData = {
                    'P-101': { name: 'Centrifugal Pump P-101', location: 'Building A - Floor 2', priority: 'CRITICAL' },
                    'HVAC-301': { name: 'HVAC Unit 301', location: 'Roof', priority: 'HIGH' },
                    'T-501': { name: 'Steam Turbine T-501', location: 'Power House', priority: 'MEDIUM' }
                };
                assetData = mockData[assetId] || { name: 'Unknown Asset', location: 'Unknown', priority: 'STANDARD' };
            }
            
            const hack = getFieldHackForAsset(assetId);
            
            // Create work order via API
            try {
                const response = await fetch(`${API_URL}/workorders`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        asset_id: assetId,
                        priority: assetData.priority,
                        procedure: 'Anomaly detected - inspection required',
                        sources: ['AI Anomaly Detection']
                    })
                });
                
                if (response.ok) {
                    const wo = await response.json();
                    showToast(`Work Order ${wo.id} created`, 'brand');
                }
            } catch (err) {
                console.error('Failed to create work order:', err);
            }
            
            const woId = `WO-${Date.now().toString().slice(-6)}`;
            
            // Create a high-tech "Printable" Modal with system fonts for professional appearance
            const woModal = document.createElement('div');
            woModal.id = 'work-order-modal';
            woModal.className = "fixed inset-0 z-[300] bg-black/95 flex items-center justify-center p-4 overflow-y-auto backdrop-blur-sm";
            woModal.innerHTML = `
                <div class="w-full max-w-4xl bg-white text-black p-12 rounded-sm shadow-2xl relative" style="font-family: Helvetica, Arial, sans-serif;">
                    <button onclick="closeWorkOrder()" class="absolute top-4 right-4 text-gray-400 hover:text-black print:hidden">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                    
                    <div class="flex justify-between border-b-4 border-black pb-6 mb-8">
                        <div>
                            <h1 class="text-4xl font-black tracking-tighter">WORK ORDER</h1>
                            <p class="text-sm font-mono mt-1">INDEXFIELD SYSTEM GENERATED // AUTH-${woId}</p>
                        </div>
                        <div class="text-right">
                            <div class="bg-black text-white px-4 py-1 font-bold mb-2">PRIORITY: ${data.priority}</div>
                            <p class="text-sm font-bold uppercase">Date: ${new Date().toLocaleDateString()}</p>
                            <p class="text-xs font-mono text-gray-500">WO#: ${woId}</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-12 mb-8">
                        <div>
                            <h3 class="font-black uppercase text-xs text-gray-500 mb-2">Asset Information</h3>
                            <p class="text-xl font-bold">${data.name} [${assetId}]</p>
                            <p class="text-sm italic">${data.location}</p>
                        </div>
                        <div>
                            <h3 class="font-black uppercase text-xs text-gray-500 mb-2">Anomaly Detected</h3>
                            <p class="text-xl font-bold text-red-600">Vibration Spike: 8.42 mm/s</p>
                            <p class="text-sm font-medium">Pattern Match: Manual Section 4.2 (Bearing Fatigue)</p>
                        </div>
                    </div>

                    <div class="border-2 border-black p-6 mb-8 bg-gray-50">
                        <h3 class="font-black uppercase text-xs mb-3 flex items-center gap-2">
                            <i class="fas fa-brain text-[#F97316]"></i> AI Recommended Procedure (Synthesized)
                        </h3>
                        <p class="text-sm leading-relaxed mb-4">
                            Immediate inspection of bearing housing required. Cross-reference SKF Manual p.42 for torque specs. 
                            <strong>AI Note:</strong> Historical data suggests secondary gasket failure often accompanies this vibration signature.
                        </p>
                        <div class="bg-white border-2 border-[#22C55E] p-4 rounded-sm">
                            <p class="text-xs font-bold text-[#22C55E] uppercase mb-1 flex items-center gap-1">
                                <i class="fas fa-hard-hat"></i> Institutional Knowledge / Tribal Hack Applied:
                            </p>
                            <p class="text-xs italic">"Isolate pump housing using V-22 bypass valve. Do not drain entire system." — Senior Tech Bob (Verified)</p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-3 gap-4 mb-8 text-center">
                        <div class="border border-black/20 p-3">
                            <p class="text-[10px] uppercase text-gray-500">Est. Downtime</p>
                            <p class="font-bold">4 Hours</p>
                        </div>
                        <div class="border border-black/20 p-3">
                            <p class="text-[10px] uppercase text-gray-500">Parts Required</p>
                            <p class="font-bold">Bearing 6205-RS</p>
                        </div>
                        <div class="border border-black/20 p-3">
                            <p class="text-[10px] uppercase text-gray-500">Skill Level</p>
                            <p class="font-bold">Level 2+</p>
                        </div>
                    </div>

                    <div class="flex gap-4 print:hidden">
                        <button onclick="completeWorkOrder()" class="flex-1 py-4 bg-black text-white font-bold hover:bg-gray-800 transition uppercase tracking-wider">
                            <i class="fas fa-check mr-2"></i>Print for Floor Tech
                        </button>
                        <button onclick="closeWorkOrder()" class="flex-1 py-4 border-2 border-black font-bold hover:bg-gray-100 transition uppercase tracking-wider">
                            <i class="fas fa-edit mr-2"></i>Edit Details
                        </button>
                    </div>
                    
                    <!-- Sovereign Seal Footer -->
                    <div class="mt-8 pt-4 border-t-2 border-black flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-[#22C55E]"></div>
                            <span class="text-[10px] font-mono font-bold uppercase tracking-wider">Sovereign Encryption: AES-256</span>
                        </div>
                        <p class="text-[9px] text-gray-500">Secure plant server — data cannot leak outside</p>
                    </div>
                </div>
            `;
            document.body.appendChild(woModal);
            
            // Hide the anomaly alert when work order opens
            document.getElementById('ai-alert-overlay').classList.add('hidden');
            showToast(`Work Order ${woId} generated`, 'brand');
        }
        
        function closeWorkOrder() {
            const modal = document.getElementById('work-order-modal');
            if (modal) modal.remove();
        }
        
        function completeWorkOrder() {
            closeWorkOrder();
            
            // Reset anomaly state
            AppState.isAnomalyActive = false;
            AppState.vibrationLevel = 1.0;
            updateTelemetryUI();
            
            // Increment work order count (simulating verification)
            const verifiedCount = document.getElementById('verified-count');
            if (verifiedCount) {
                const newCount = parseInt(verifiedCount.textContent) + 1;
                verifiedCount.textContent = newCount;
                localStorage.setItem('indexfield_verifiedCount', newCount.toString());
            }
            
            showToast('Work Order dispatched. System returning to nominal.', 'brand');
        }
        
        function updateTelemetryUI() {
            // Update sensor displays if they exist
            const vibDisplay = document.getElementById('vib-value-P-101');
            if (vibDisplay) {
                vibDisplay.textContent = `${AppState.vibrationLevel} mm/s`;
                vibDisplay.className = AppState.isAnomalyActive ? 'text-xl font-bold text-red-400' : 'text-xl font-bold text-white';
            }
            
            // Update the P-101 sensor card in telemetry grid if present
            const p101Card = document.querySelector('[data-asset="P-101"]');
            if (p101Card) {
                const valueEl = p101Card.querySelector('.sensor-value');
                if (valueEl) {
                    valueEl.textContent = `${AppState.vibrationLevel} mm/s`;
                    valueEl.className = `sensor-value text-xl font-bold ${AppState.isAnomalyActive ? 'text-red-400' : 'text-white'}`;
                }
            }
        }
        
        // Data Persistence — Now backed by Supabase
        function saveToStorage() {
            // Legacy compatibility — data now saved to Supabase in real-time
            // Keep localStorage as a fast cache
            localStorage.setItem('indexfield_queryHistory', JSON.stringify(queryHistory));
        }
        
        function loadFromStorage() {
            // Load from localStorage as fast cache, Supabase data overwrites later
            const savedQueries = localStorage.getItem('indexfield_queryHistory');
            if (savedQueries) {
                queryHistory = JSON.parse(savedQueries);
            }
        }

        function revealChatConsoleUI() {
            document.getElementById('welcome-message')?.classList.remove('hidden', 'opacity-0');
            document.getElementById('chat-input-area')?.classList.remove('opacity-0');
        }

        function syncDashboardState() {
            const displayManuals = filterIndustrialManuals(manuals);
            const hasManuals = displayManuals.length > 0;
            const welcomeMsg = document.getElementById('welcome-message');
            const messagesEl = document.getElementById('messages');
            const hasChatHistory = messagesEl && messagesEl.children.length > 0;
            const quickQueriesReal = document.getElementById('quick-queries-real');
            const quickQueriesDemo = document.getElementById('quick-queries-demo');
            const recentQueriesList = document.getElementById('recent-queries-list');
            const totalPages = displayManuals.reduce((acc, manual) => acc + (manual.page_count || 0), 0);
            const coverage = totalPages === 0 ? 0 : Math.min(100, Math.max(15, Math.round((totalPages / 12) * 100)));
            const defaultSuggestions = [
                { label: 'Check Grundfos CR fault codes', query: 'Check Grundfos CR fault codes' },
                { label: 'Show LOTO procedures', query: 'Show LOTO procedures' },
                { label: 'Summarize the safety-critical steps', query: 'Summarize the safety-critical steps in this manual' }
            ];

            if (welcomeMsg) {
                welcomeMsg.classList.toggle('welcome-empty-focus', !hasManuals && !hasChatHistory);
                welcomeMsg.classList.toggle('hidden', hasManuals || hasChatHistory);
            }

            if (quickQueriesReal && quickQueriesDemo) {
                quickQueriesReal.classList.toggle('hidden', !hasManuals);
                quickQueriesDemo.classList.toggle('hidden', hasManuals);
            }

            if (recentQueriesList) {
                const activeSuggestions = hasManuals
                    ? (queryHistory.length
                        ? queryHistory.slice(0, 3).map(query => ({
                            label: query.length > 48 ? `${query.slice(0, 48)}…` : query,
                            query
                        }))
                        : defaultSuggestions)
                    : [];

                recentQueriesList.innerHTML = hasManuals
                    ? activeSuggestions.map(({ label, query }) => `
                        <button type="button"
                            class="data-surface p-2 rounded text-[11px] text-left hover:bg-white/5 transition-all"
                            onclick="activatePromptShortcut('${query.replace(/'/g, "\\'")}')">
                            <span class="block text-white font-semibold leading-normal whitespace-normal break-words">${label}</span>
                            <span class="block text-[9px] text-slate-300/80 mt-1">Send this prompt now</span>
                        </button>
                    `).join('')
                    : '<p class="text-[10px] text-light-slate/60 text-center py-2">💡 Upload your first manual to see suggested questions here.</p>';
            }

            const insightsWidget = document.getElementById('maintenance-insights-widget');
            const insightsManuals = document.getElementById('maintenance-insights-manuals');
            const insightsPages = document.getElementById('maintenance-insights-pages');
            const coverageEl = document.getElementById('main-kb-coverage');

            if (insightsManuals) {
                insightsManuals.textContent = `${displayManuals.length} manual${displayManuals.length === 1 ? '' : 's'} indexed`;
            }
            if (insightsPages) {
                insightsPages.textContent = `${totalPages} page${totalPages === 1 ? '' : 's'} parsed`;
            }
            if (coverageEl) {
                coverageEl.textContent = `${coverage}%`;
            }
            
            const protocolBody = document.getElementById('loto-protocol-body');
            if (protocolBody) {
                if (!hasManuals) {
                    protocolBody.className = 'flex-1 overflow-y-auto p-5 font-mono text-sm flex flex-col justify-center';
                    protocolBody.innerHTML = `
                        <div class="flex-1 flex flex-col items-center justify-center text-center p-6 border border-dashed border-[#F97316]/30 hover:border-[#F97316] bg-black/40 rounded-xl transition-all duration-300 w-full" id="loto-onboarding-dragzone">
                            <i class="fas fa-cloud-upload-alt text-4xl text-[#F97316]/50 mb-4 animate-bounce" style="animation-duration: 3s"></i>
                            <p class="text-xs font-bold text-white font-mono uppercase tracking-wider">Awaiting Equipment Manuals</p>
                            <p class="text-[10px] text-[#94A3B8] font-mono mt-2 max-w-xs leading-relaxed">
                                The safety command engine requires an equipment manual to extract the precise step-by-step shutdown sequence and zero-energy protocol.
                            </p>
                            <button onclick="showUploadModal()" class="mt-5 px-4 py-2 bg-[#F97316] hover:bg-[#EA580C] active:scale-95 text-black text-xs font-bold font-mono rounded uppercase tracking-wider transition-all shadow-[0_0_15px_rgba(249,115,22,0.2)]">
                                [ Upload Your First Equipment Manual ]
                            </button>
                        </div>
                    `;
                } else {
                    protocolBody.className = 'flex-1 overflow-y-auto p-5 font-mono text-sm flex flex-col';
                    if (!protocolBody.innerHTML.includes('loto-step-1')) {
                        protocolBody.innerHTML = `
                            <div class="flex-1 flex flex-col items-center justify-center text-center opacity-40">
                                <i class="fas fa-file-alt text-4xl text-[#06B6D4]/30 mb-4"></i>
                                <p class="text-[11px] text-[#94A3B8] font-bold">AWAITING ASSET SELECTION</p>
                                <p class="text-[10px] text-[#94A3B8] mt-1">Click an intervention from the left panel to load<br/>the AI-extracted shutdown sequence from the indexed manual.</p>
                            </div>
                        `;
                    }
                }
            }
            
            // 1. Lock/Unlock chat input, send button, and in-field action icons
            const chatInput = document.getElementById('chat-input');
            const sendBtn = document.getElementById('send-btn');
            const chatMicBtn = document.getElementById('chat-mic-btn');
            const chatUploadBtn = document.getElementById('chat-upload-btn');
            const setChatBarActionState = (enabled) => {
                [chatMicBtn, chatUploadBtn].forEach(btn => {
                    if (!btn) return;
                    btn.classList.toggle('chat-bar-action-disabled', !enabled);
                    btn.disabled = !enabled;
                });
            };
            if (chatInput && sendBtn) {
                if (!hasManuals) {
                    chatInput.disabled = true;
                    chatInput.placeholder = '🔒 Upload a manual first to start asking questions...';
                    chatInput.classList.add('opacity-50', 'cursor-not-allowed');
                    sendBtn.disabled = true;
                    sendBtn.classList.add('opacity-30', 'cursor-not-allowed');
                    setChatBarActionState(false);
                } else {
                    chatInput.disabled = false;
                    chatInput.placeholder = '💬 Ask a question...';
                    chatInput.classList.remove('opacity-50', 'cursor-not-allowed');
                    sendBtn.disabled = false;
                    sendBtn.classList.remove('opacity-30', 'cursor-not-allowed');
                    setChatBarActionState(true);
                }
            }

            // Searchable pages counter — hidden until at least one manual is indexed
            const pagesCountEl = document.getElementById('searchable-pages-count');
            if (pagesCountEl) {
                if (!hasManuals) {
                    pagesCountEl.classList.add('hidden');
                    pagesCountEl.classList.remove('sm:inline');
                } else {
                    const totalPages = displayManuals.reduce((acc, m) => acc + (m.page_count || 0), 0);
                    pagesCountEl.textContent = `${totalPages} page${totalPages === 1 ? '' : 's'}`;
                    pagesCountEl.classList.remove('hidden');
                    pagesCountEl.classList.add('sm:inline');
                }
            }

            // Quick Action chips — visible in empty state but visually disabled until the pipeline is armed
            const quickChips = document.querySelectorAll('#quick-action-chips .quick-action-chip');
            quickChips.forEach(chip => {
                chip.classList.toggle('quick-action-disabled', !hasManuals);
                chip.setAttribute('aria-disabled', String(!hasManuals));
                chip.setAttribute('title', hasManuals ? '' : 'Upload a manual first to enable this action');
            });
            const tribalCallout = document.getElementById('tribal-knowledge-callout');
            if (tribalCallout) {
                tribalCallout.classList.toggle('hidden', hasManuals);
            }

            // 2. Hide/Show bottom Action buttons (Properly toggle flex/hidden conflict)
            const actionButtons = document.getElementById('chat-action-buttons');
            if (actionButtons) {
                if (!hasManuals) {
                    actionButtons.classList.add('hidden');
                    actionButtons.classList.remove('flex');
                } else {
                    actionButtons.classList.remove('hidden');
                    actionButtons.classList.add('flex');
                }
            }

            // 3. Hide Suggested Inquiries & Maintenance Insights widgets for empty accounts
            const suggestedWidget = document.getElementById('suggested-inquiries-widget');
            const kbWidget = document.getElementById('knowledge-base-widget');
            
            if (suggestedWidget && insightsWidget && kbWidget) {
                if (!hasManuals) {
                    suggestedWidget.classList.add('hidden');
                    insightsWidget.classList.add('hidden');
                    kbWidget.classList.remove('md:col-span-1');
                    kbWidget.classList.add('col-span-2');
                } else {
                    suggestedWidget.classList.remove('hidden', 'empty-state-ghost');
                    insightsWidget.classList.remove('hidden', 'empty-state-ghost');
                    kbWidget.classList.remove('col-span-2');
                    kbWidget.classList.add('md:col-span-1');
                }
            }
            refreshKnowledgeBaseUI();
            syncSourcePanelState();
            
            // 4. Update the sidebar status text contrast & content
            const statusText = document.getElementById('llm-status-text');
            const statusDot = document.getElementById('llm-status-dot');
            if (statusText) {
                statusText.textContent = hasManuals ? 'AI Engine Ready' : 'Awaiting First Manual Upload';
                setSystemStatusLine(
                    hasManuals ? 'System Status: Active — Manual Indexed' : 'System Status: Standby — Awaiting Manual',
                    hasManuals ? 'ready' : 'idle'
                );
                updatePlantDocumentsLabel(currentPdf?.page_number);
            }
            applyStatusDotState(statusDot, hasManuals ? 'ready' : 'idle');
            const systemStatusDot = document.getElementById('system-status-dot');
            applyStatusDotState(systemStatusDot, hasManuals ? 'ready' : 'idle');
            syncHeaderSystemStatus();

            const topUploadBtn = document.getElementById('top-upload-btn');
            if (topUploadBtn) {
                if (!hasManuals) {
                    topUploadBtn.classList.add('hidden');
                } else {
                    topUploadBtn.classList.remove('hidden');
                }
            }

            const historySetup = document.getElementById('history-empty-manuals');
            const historySampleGrid = document.getElementById('history-sample-grid');
            const sampleButtons = historySampleGrid ? Array.from(historySampleGrid.querySelectorAll('.history-sample')) : [];
            if (currentView === 'history') {
                if (!hasManuals) {
                    historySetup?.classList.remove('hidden');
                    historySampleGrid?.classList.add('opacity-50');
                    sampleButtons.forEach(btn => {
                        btn.classList.add('cursor-not-allowed');
                        btn.classList.remove('hover:border-[#F97316]/50');
                        btn.disabled = true;
                        btn.setAttribute('title', 'Upload a manual first to enable sample searches');
                    });
                } else {
                    historySetup?.classList.add('hidden');
                    historySampleGrid?.classList.remove('opacity-50');
                    sampleButtons.forEach(btn => {
                        btn.classList.remove('cursor-not-allowed');
                        btn.classList.add('hover:border-[#F97316]/50');
                        btn.disabled = false;
                        btn.removeAttribute('title');
                    });
                }
            } else {
                historySetup?.classList.add('hidden');
                historySampleGrid?.classList.remove('opacity-50');
                sampleButtons.forEach(btn => {
                    btn.classList.remove('cursor-not-allowed');
                    btn.classList.add('hover:border-[#F97316]/50');
                    btn.disabled = false;
                    btn.removeAttribute('title');
                });
            }

            // 5. Hide Ghost Trash Can and Source Verification Header on empty accounts
            const clearChatBtn = document.getElementById('clear-chat-btn');
            const pdfPanelHeader = document.getElementById('pdf-panel-header');
            
            if (clearChatBtn && pdfPanelHeader) {
                if (!hasManuals) {
                    clearChatBtn.classList.add('hidden');
                    pdfPanelHeader.classList.add('hidden');
                } else {
                    clearChatBtn.classList.remove('hidden');
                    pdfPanelHeader.classList.remove('hidden');
                }
            }

            // 6. Dynamic ROI Metrics & Fleet Risk Score styling
            const timeSavedVal = document.getElementById('roi-time-saved-val');
            const timeSavedSub = document.getElementById('roi-time-saved-sub');
            const downtimeAvoidedVal = document.getElementById('roi-downtime-avoided-val');
            const downtimeAvoidedSub = document.getElementById('roi-downtime-avoided-sub');
            const savingsTicker = document.getElementById('roi-savings-ticker');
            const riskScore = document.getElementById('risk-score');
            const riskScoreStatus = document.getElementById('risk-score-status');
            const roiWidget = document.getElementById('roi-dashboard-widget');
            const roiBadge = document.getElementById('roi-badge');
            const roiIcon = document.getElementById('roi-icon');
            const faultCodesBadge = document.getElementById('fault-codes-ent-badge');

            // Hide Enterprise Feature tag on trending fault codes since the user profile has ENT badge
            if (faultCodesBadge) {
                faultCodesBadge.classList.add('hidden');
            }

            if (hasManuals) {
                if (timeSavedVal) {
                    timeSavedVal.className = 'text-2xl font-bold text-white';
                }
                if (timeSavedSub) {
                    timeSavedSub.textContent = 'Live tracking active';
                    timeSavedSub.className = 'text-[10px] text-[#22C55E] mt-1';
                }
                if (downtimeAvoidedVal) {
                    downtimeAvoidedVal.className = 'text-2xl font-bold text-white';
                }
                if (downtimeAvoidedSub) {
                    downtimeAvoidedSub.textContent = 'Based on team searches';
                    downtimeAvoidedSub.className = 'text-[10px] text-[#22C55E] mt-1';
                }
                if (savingsTicker) {
                    savingsTicker.className = 'text-2xl font-bold text-[#22C55E] transition-all duration-300';
                }
                if (riskScore) {
                    riskScore.textContent = '--';
                    riskScore.className = 'text-2xl font-bold text-[#F59E0B]';
                }
                if (riskScoreStatus) {
                    riskScoreStatus.textContent = 'Requires more data';
                }
                if (roiWidget) {
                    roiWidget.className = 'glass-card rounded-xl p-6 mb-6 border border-[#22C55E]/30 bg-[#22C55E]/5 relative overflow-hidden';
                }
                if (roiBadge) {
                    roiBadge.className = 'absolute top-0 right-0 bg-[#22C55E] text-black text-[10px] font-bold px-3 py-1 font-mono uppercase rounded-bl-lg';
                }
                if (roiIcon) {
                    roiIcon.className = 'fas fa-chart-pie text-[#22C55E] mr-2';
                }
            } else {
                if (timeSavedVal) {
                    timeSavedVal.className = 'text-2xl font-bold text-slate-400';
                }
                if (timeSavedSub) {
                    timeSavedSub.textContent = '⏳ Starts tracking after 1st search';
                    timeSavedSub.className = 'text-[10px] text-light-slate/50 mt-1';
                }
                if (downtimeAvoidedVal) {
                    downtimeAvoidedVal.className = 'text-2xl font-bold text-slate-400';
                }
                if (downtimeAvoidedSub) {
                    downtimeAvoidedSub.textContent = 'Based on searches';
                    downtimeAvoidedSub.className = 'text-[10px] text-light-slate/50 mt-1';
                }
                if (savingsTicker) {
                    savingsTicker.className = 'text-2xl font-bold text-slate-400 transition-all duration-300';
                }
                if (riskScore) {
                    riskScore.textContent = '--';
                    riskScore.className = 'text-2xl font-bold text-slate-400';
                }
                if (riskScoreStatus) {
                    riskScoreStatus.textContent = 'Awaiting first upload';
                }
                if (roiWidget) {
                    roiWidget.className = 'glass-card rounded-xl p-6 mb-6 border border-white/10 bg-white/5 relative overflow-hidden';
                }
                if (roiBadge) {
                    roiBadge.className = 'absolute top-0 right-0 bg-slate-800 text-slate-400 text-[10px] font-bold px-3 py-1 font-mono uppercase rounded-bl-lg border-l border-b border-white/10';
                }
                if (roiIcon) {
                    roiIcon.className = 'fas fa-chart-pie text-slate-400 mr-2';
                }
            }

            revealChatConsoleUI();

            updateInsightsHeaderCta();

            if (currentView === 'insights') {
                generateHeatmap();
            }

            syncPrognosticsView();
        }
        
        // Alive Status Indicator - makes the system feel "thinking"
        function startStatusPulse() {
            const dot = document.getElementById('llm-status-dot');
            const text = document.getElementById('llm-status-text');
            
            setInterval(() => {
                if (!manuals || manuals.length === 0) return;
                // Randomly toggle between online and processing (20% chance)
                if (Math.random() < 0.2) {
                    dot.classList.remove('status-online');
                    dot.style.background = '#F59E0B'; // Yellow
                    dot.style.color = '#F59E0B';
                    text.textContent = 'Processing Query...';
                    
                    setTimeout(() => {
                        dot.classList.add('status-online');
                        dot.style.background = '';
                        dot.style.color = '';
                        text.textContent = 'AI Ready';
                    }, 1500);
                }
            }, 5000);
        }
        
        async function checkHealth() {
            try {
                const response = await fetch(`${API_URL}/health`);
                const health = await response.json();
                
                // Update status indicators
                const llmStatusText = document.getElementById('llm-status-text');
                const llmStatusDot = document.getElementById('llm-status-dot');
                
                if (health.gemini_available) {
                    llmStatusText.textContent = manuals && manuals.length > 0 ? 'AI Engine Ready' : 'Awaiting First Manual Upload';
                    setSystemStatusLine(
                        manuals && manuals.length > 0
                            ? 'System Status: Fully Operational & Ready'
                            : 'System Status: Ready — Awaiting Manual',
                        'ready'
                    );
                    if (manuals && manuals.length > 0) {
                        llmStatusDot.className = 'status-dot status-online';
                        llmStatusDot.style.background = '';
                        llmStatusDot.style.color = '';
                    } else {
                        llmStatusDot.className = 'status-dot status-idle';
                        llmStatusDot.style.background = '';
                        llmStatusDot.style.color = '';
                    }
                } else if (health.ollama_running && health.model_available) {
                    llmStatusText.textContent = manuals && manuals.length > 0 ? 'AI Engine Ready (Backup)' : 'Awaiting First Manual Upload';
                    setSystemStatusLine(
                        manuals && manuals.length > 0
                            ? 'System Status: Fully Operational & Ready'
                            : 'System Status: Ready — Awaiting Manual',
                        'ready'
                    );
                    if (manuals && manuals.length > 0) {
                        llmStatusDot.className = 'status-dot status-online';
                        llmStatusDot.style.background = '#F59E0B';
                        llmStatusDot.style.color = '#F59E0B';
                    } else {
                        llmStatusDot.className = 'status-dot status-idle';
                        llmStatusDot.style.background = '';
                        llmStatusDot.style.color = '';
                    }
                } else if (health.ollama_running || health.model_available) {
                    llmStatusText.textContent = 'AI Engine Starting Up';
                    setSystemStatusLine('System Status: Standby — Check Connection', 'idle');
                    llmStatusDot.style.background = '#F59E0B';
                    llmStatusDot.style.color = '#F59E0B';
                } else {
                    llmStatusText.textContent = 'AI Engine Offline';
                    setSystemStatusLine('System Status: Offline — Contact Support', 'offline');
                    llmStatusDot.className = 'status-dot';
                    llmStatusDot.style.background = '#EF4444';
                }
                updatePlantDocumentsLabel(currentPdf?.page_number);
                
                console.log('System health:', health);
            } catch (err) {
                console.error('Health check failed:', err);
                console.error('Error details:', err.message);
                document.getElementById('llm-status-text').textContent = 'Awaiting First Manual Upload';
                setSystemStatusLine('System Status: Ready — Awaiting Manual', 'idle');
                updatePlantDocumentsLabel();
                document.getElementById('llm-status-dot').className = 'status-dot';
                document.getElementById('llm-status-dot').style.background = '#F8FAFC';
            }
        }
        
        
        // --- Verification Vault Logic ---
        async function openVault() {
            document.getElementById('vault-modal').classList.remove('hidden');
            try {
                const resp = await fetch(`${API_URL}/admin/tribal_notes?status=pending`);
                const notes = await resp.json();

                const list = document.getElementById('vault-list');
                list.innerHTML = '';
                
                if (notes.length === 0) {
                    list.innerHTML = '<div class="text-center p-12 text-light-slate"><i class="fas fa-check-circle text-4xl mb-4 opacity-20"></i><p>No pending knowledge verification tasks.</p></div>';
                    return;
                }

                notes.forEach(n => {
                    const noteEl = document.createElement('div');
                    noteEl.className = 'bg-white/5 border border-[#F97316]/30 p-4 rounded-lg flex flex-col md:flex-row items-start gap-6 hover:border-[#F97316]/60 transition-all duration-300';
                    noteEl.innerHTML = `
                        <div class="w-full md:w-48 h-48 bg-black/40 rounded overflow-hidden flex-shrink-0 border border-white/5">
                            <img src="${n.raw_image_url || 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&q=80&w=200'}" 
                                 alt="Original Scan" 
                                 class="w-full h-full object-cover cursor-zoom-in"
                                 onclick="window.open(this.src, '_blank')">
                        </div>
                        <div class="flex-1 w-full">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[10px] font-mono text-[#F97316] uppercase tracking-wider bg-[#F97316]/10 px-2 py-0.5 rounded">Tribal Knowledge Capture</span>
                                <span class="text-[10px] text-light-slate font-mono">${new Date(n.created_at).toLocaleString()}</span>
                            </div>
                            <p class="text-sm mb-2 text-white font-medium">Page ${n.page} &bull; ${n.author}</p>
                            <div class="bg-black/60 p-3 rounded border border-white/5 font-mono text-xs text-[#00FFA3] leading-relaxed mb-4 min-h-[80px]">
                                <i class="fas fa-quote-left mr-2 opacity-30"></i>${n.ocr_text}<i class="fas fa-quote-right ml-2 opacity-30"></i>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="patchNote('${n.id}', 'verified')" class="px-4 py-2 bg-[#22C55E] text-white rounded text-xs font-bold hover:bg-[#16A34A] transition-all flex items-center gap-2">
                                    <i class="fas fa-check"></i> Verify & Promote
                                </button>
                                <button onclick="openEditModal('${n.id}', '${n.ocr_text.replace(/'/g, "\\'")}')" class="px-4 py-2 border border-white/20 text-white rounded text-xs font-bold hover:bg-white/10 transition-all flex items-center gap-2">
                                    <i class="fas fa-edit"></i> Edit Transcription
                                </button>
                                <button onclick="patchNote('${n.id}', 'unsafe')" class="px-4 py-2 bg-[#EF4444]/20 text-[#EF4444] border border-[#EF4444]/30 rounded text-xs font-bold hover:bg-[#EF4444] hover:text-white transition-all flex items-center gap-2 ml-auto">
                                    <i class="fas fa-exclamation-triangle"></i> Flag as Unsafe
                                </button>
                            </div>
                        </div>
                    `;
                    list.appendChild(noteEl);
                });
            } catch (err) {
                console.error("Failed to load vault:", err);
                showToast("Connection to Knowledge Vault failed.", "error");
            }
        }

        async function patchNote(id, newType, edited=null) {
            try {
                const response = await fetch(`${API_URL}/admin/tribal_notes/${id}`, {
                    method: 'PATCH',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({type: newType, ocr_text: edited})
                });
                if (response.ok) {
                    showToast(newType === 'verified' ? "Knowledge verified and promoted." : "Note flagged and excluded.", "brand");
                    openVault();
                }
            } catch (err) {
                showToast("Action failed: " + err.message, "error");
            }
        }

        function openEditModal(id, current) {
            const modal = document.createElement('div');
            modal.id = 'edit-note-modal';
            modal.className = 'fixed inset-0 bg-black/80 flex items-center justify-center z-[500] backdrop-blur-sm p-4';
            modal.innerHTML = `
                <div class="bg-[#111827] border border-white/10 p-6 rounded-xl w-full max-w-lg shadow-2xl">
                    <div class="flex items-center gap-3 mb-4">
                        <i class="fas fa-edit text-[#F97316]"></i>
                        <h3 class="text-lg font-bold">Refine AI Transcription</h3>
                    </div>
                    <p class="text-xs text-light-slate mb-4 italic">Adjust the text to match exactly what is shown in the scan. Once saved, this becomes the 'Plant Standard' answer.</p>
                    <textarea id="edit-ta" class="w-full h-48 bg-black/40 text-white p-4 rounded border border-white/10 font-mono text-sm focus:border-[#F97316] outline-none transition-all">${current}</textarea>
                    <div class="flex justify-end gap-3 mt-6">
                        <button class="px-6 py-2 border border-white/20 text-white rounded font-bold hover:bg-white/5 transition-all"
                                onclick="document.getElementById('edit-note-modal').remove()">Cancel</button>
                        <button class="px-6 py-2 bg-[#F97316] text-white rounded font-bold hover:bg-white transition-all text-black"
                                onclick="saveEdit('${id}')">Save & Verify</button>
                    </div>
                </div>`;
            document.body.appendChild(modal);
        }

        async function saveEdit(id) {
            const edited = document.getElementById('edit-ta').value;
            await patchNote(id, 'verified', edited);
            document.getElementById('edit-note-modal').remove();
        }

        function autoScaleInput(el) {
            el.style.height = 'auto';
            el.style.height = (el.scrollHeight) + 'px';
            // Ensure container doesn't overflow
            if (el.scrollHeight > 200) {
                el.style.overflowY = 'auto';
            } else {
                el.style.overflowY = 'hidden';
            }
        }


        async function loadDashboardFragments() {
            const fragmentTargets = [
                { id: 'chat-view', url: 'dashboard-pages/chat-view.html' },
                { id: 'insights-view', url: 'dashboard-pages/insights-view.html' },
                { id: 'assets-view', url: 'dashboard-pages/assets-view.html' },
                { id: 'telemetry-view', url: 'dashboard-pages/telemetry-view.html' },
                { id: 'vault-view', url: 'dashboard-pages/vault-view.html' },
                { id: 'field-view', url: 'dashboard-pages/field-view.html' },
                { id: 'loto-view', url: 'dashboard-pages/loto-view.html' },
                { id: 'prognostics-view', url: 'dashboard-pages/prognostics-view.html' },
                { id: 'history-view', url: 'dashboard-pages/history-view.html' },
                { id: 'help-view', url: 'dashboard-pages/help-view.html' },
                { id: 'manuals-view', url: 'dashboard-pages/manuals-view.html' }
            ];

            await Promise.all(fragmentTargets.map(async (fragment) => {
                const target = document.getElementById(fragment.id);
                if (!target) return;

                // If content is already inlined in the DOM (compiled standalone mode), skip fetch
                if (target.innerHTML.trim().length > 0 && !target.innerHTML.includes("Unable to load")) {
                    console.log(`[SPA] ${fragment.id} is already inlined. Bypassing fetch.`);
                    return;
                }

                try {
                    // Handle local file protocol where fetch may fail due to CORS
                    let content = '';
                    if (window.location.protocol === 'file:') {
                        try {
                            const response = await fetch(`${fragment.url}`);
                            if (response.ok) {
                                content = await response.text();
                            } else {
                                console.warn(`[SPA] Unable to fetch ${fragment.id} via file protocol: HTTP ${response.status}`);
                            }
                        } catch (e) {
                            console.warn(`[SPA] Fetch error for ${fragment.id} in file protocol:`, e);
                        }
                    } else {
                        const response = await fetch(new URL(fragment.url, document.baseURI).href);
                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}`);
                        }
                        content = await response.text();
                    }
                    if (content) {
                        const temp = document.createElement('div');
                        temp.innerHTML = content;
                        const innerView = temp.querySelector('#' + fragment.id);
                        if (innerView) {
                            target.innerHTML = innerView.innerHTML;
                        } else {
                            target.innerHTML = content;
                        }
                    }
                } catch (error) {
                    // Check if local file CORS block
                    if (window.location.protocol === 'file:') {
                        console.warn(`[SPA] Fetch failed due to local file CORS restrictions for ${fragment.id}. Standalone inlining fallback required.`);
                        if (target.innerHTML.trim().length > 0) return;
                    }
                    target.innerHTML = `<div class="p-6 text-sm text-red-300">Unable to load ${fragment.id}: ${error.message}</div>`;
                }
            }));
        }


        document.addEventListener('DOMContentLoaded', async () => { 
            const chatInput = document.getElementById('chat-input');
            if (chatInput) autoScaleInput(chatInput);

            await loadDashboardFragments();
            showView('chat');
            revealChatConsoleUI();
            loadManuals();
            
            checkHealth();
            loadFromStorage();
            startStatusPulse();
            loadLowSignalState();
            startROITicker();
            syncTelemetryOpsView();
            syncPrognosticsView();
            
            // Load real data from Supabase
            try {
                await loadSupabaseData();
            } catch (e) {
                console.warn('Dashboard data load failed:', e);
                syncDashboardState();
            }
            
            // Check if onboarding needed
            setTimeout(() => {
                initializeOnboarding();
            }, 500);
            
            // Auto-save on page unload
            window.addEventListener('beforeunload', saveToStorage);
            
            // Periodic health check
            setInterval(checkHealth, 30000);

            // Wire up premium Drag & Drop zone
            const uploadPrompt = document.getElementById('upload-prompt');
            if (uploadPrompt) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    uploadPrompt.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        uploadPrompt.classList.remove('bg-[#F97316]/5', 'border-[#F97316]/50');
                        uploadPrompt.classList.add('border-[#F97316]', 'bg-[#F97316]/15', 'scale-[1.02]');
                    }, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    uploadPrompt.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        uploadPrompt.classList.remove('border-[#F97316]', 'bg-[#F97316]/15', 'scale-[1.02]');
                        uploadPrompt.classList.add('bg-[#F97316]/5', 'border-[#F97316]/50');
                    }, false);
                });

                uploadPrompt.addEventListener('drop', (e) => {
                    const files = e.dataTransfer?.files;
                    if (!files?.[0]) return;
                    if (!isAllowedUploadFile(files[0])) {
                        showToast('Only PDF, TXT, CSV, and DOCX plant manuals can be indexed.', 'accent');
                        return;
                    }
                    const input = document.getElementById('upload-input');
                    if (input) {
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(files[0]);
                        input.files = dataTransfer.files;
                        handleUpload(input);
                    }
                }, false);
            }

            function wireDropZone(el, onFile) {
                if (!el) return;
                ['dragenter', 'dragover'].forEach(eventName => {
                    el.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        el.classList.add('dropzone-active');
                    }, false);
                });
                ['dragleave', 'drop'].forEach(eventName => {
                    el.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        el.classList.remove('dropzone-active');
                    }, false);
                });
                el.addEventListener('drop', (e) => {
                    const file = e.dataTransfer?.files?.[0];
                    if (file) onFile(file);
                }, false);
            }

            wireDropZone(document.getElementById('manuals-upload-zone'), (file) => {
                if (!isAllowedUploadFile(file)) {
                    showToast('Only PDF, TXT, CSV, and DOCX plant manuals can be indexed.', 'accent');
                    return;
                }
                const input = document.getElementById('upload-input');
                if (input) {
                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    input.files = dataTransfer.files;
                    handleUpload(input);
                }
            });

            // Wire up premium Drag & Drop zone for LOTO Protocol panel empty state
            const lotoProtocolBody = document.getElementById('loto-protocol-body');
            if (lotoProtocolBody) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    lotoProtocolBody.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        const dragzone = document.getElementById('loto-onboarding-dragzone');
                        if (dragzone && manuals && manuals.length === 0) {
                            dragzone.classList.remove('border-[#F97316]/30', 'bg-black/40');
                            dragzone.classList.add('border-[#F97316]', 'bg-[#F97316]/10', 'scale-[1.01]');
                        }
                    }, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    lotoProtocolBody.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        const dragzone = document.getElementById('loto-onboarding-dragzone');
                        if (dragzone) {
                            dragzone.classList.remove('border-[#F97316]', 'bg-[#F97316]/10', 'scale-[1.01]');
                            dragzone.classList.add('border-[#F97316]/30', 'bg-black/40');
                        }
                    }, false);
                });

                lotoProtocolBody.addEventListener('drop', (e) => {
                    if (filterIndustrialManuals(manuals).length === 0) {
                        const file = e.dataTransfer?.files?.[0];
                        if (!file) return;
                        if (!isAllowedUploadFile(file)) {
                            showToast('Only PDF, TXT, CSV, and DOCX plant manuals can be indexed.', 'accent');
                            return;
                        }
                        const input = document.getElementById('upload-input');
                        if (input) {
                            const dataTransfer = new DataTransfer();
                            dataTransfer.items.add(file);
                            input.files = dataTransfer.files;
                            handleUpload(input);
                        }
                    }
                }, false);
            }
        });
    </script>

    <!-- Verification Vault Modal -->
    <div class="fixed inset-0 z-[400] hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4 lg:p-12" id="vault-modal">
        <div class="w-full max-w-6xl bg-[#0A0A0A] text-white rounded-2xl border border-white/10 shadow-[0_0_50px_rgba(249,115,22,0.15)] flex flex-col h-full max-h-[90vh]">
            <div class="p-6 border-b border-white/10 flex items-center justify-between bg-white/5 rounded-t-2xl">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-[#F97316]/20 rounded-lg flex items-center justify-center border border-[#F97316]/40">
                        <i class="fas fa-clipboard-check text-[#F97316]"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold tracking-tight">Institutional Knowledge Vault</h2>
                        <p class="text-[10px] text-light-slate font-mono uppercase tracking-widest">Pending Verification Queue</p>
                    </div>
                </div>
                <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-all"
                        onclick="document.getElementById('vault-modal').classList.add('hidden')">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-6 space-y-6" id="vault-list">
                <!-- Dynamic List Items -->
                <div class="flex items-center justify-center h-full">
                    <i class="fas fa-circle-notch fa-spin text-[#F97316] text-2xl"></i>
                </div>
            </div>

            <div class="p-4 border-t border-white/10 bg-white/5 rounded-b-2xl flex justify-between items-center text-[10px] font-mono text-light-slate">
                <span>INDEXFIELD AUDIT PROTOCOL v1.0</span>
                <span>SECURE ENCRYPTED VERIFICATION ENVIRONMENT</span>
            </div>
        </div>
    </div>
</body>
</html>

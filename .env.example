# ============================================================
# IndexField Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Configuration
GROQ_API_KEY=your_groq_api_key

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key

# External Services
CALENDLY_URL=your_calendly_url

# Admin Configuration
ADMIN_EMAIL=admin@example.com
BASE_URL=http://localhost:8000

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
DEBUG=False

# CORS Configuration
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# Vector DB Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=manuals
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Document Processing
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional AI Providers (fallbacks)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-sonnet-20240229
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama Configuration (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Configuration
DATABASE_URL=sqlite:///./indexfield.db

# Feature Flags
ENABLE_TELEMETRY=True
ENABLE_KNOWLEDGE_VAULT=True
ENABLE_WORK_ORDERS=True
ENABLE_ANOMALY_DETECTION=True
ENABLE_CLOUD_BACKUP=False
ENABLE_REAL_TELEMETRY=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/indexfield.log
